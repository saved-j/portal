# portal 1.03 patch 20b — the child's document answers its own DNS inside the tunnel
#
# The VpnService hands every app the resolver 198.18.0.2, so the child's core receives those
# queries as ordinary connections to 198.18.0.2:53. A panel document has no reason to hijack
# that address: its DNS section is written for a machine with a real system resolver, and its
# routing sends port 53 wherever everything else goes — on the phone that was
# `[tun-in -> direct] … 198.18.0.2:53`, and every name lookup timed out. A concrete node
# happened to work; the balancer pick ('Авто-выбор') did not.
#
# Chosen fix: rewrite the document (a `dns` section with a queryable server, one `dns`
# protocol outbound, and a first routing rule sending the tun inbound's port 53 to it), not
# refuse it. Refusing would fall back to the app-built config for one node, which silently
# turns 'Авто-выбор' into "the first server" and loses the balancer the owner picked. The
# rewrite keeps a concrete node working exactly as it did and makes the balancer behave like
# one. Expected on the device: `[tun-in -> <dns outbound>]` for 198.18.0.2:53, curl 200 by
# hostname, egress present, for both a concrete node and 'Авто-выбор'. Rollback: revert.
diff --git a/android/app/src/main/kotlin/com/follow/clashx/plugins/XrayPlugin.kt b/android/app/src/main/kotlin/com/follow/clashx/plugins/XrayPlugin.kt
index d683e6c0..bf6c88c2 100644
--- a/android/app/src/main/kotlin/com/follow/clashx/plugins/XrayPlugin.kt
+++ b/android/app/src/main/kotlin/com/follow/clashx/plugins/XrayPlugin.kt
@@ -307,6 +404,10 @@ class XrayPlugin : FlutterPlugin, MethodChannel.MethodCallHandler {
             },
         )
         root.put("inbounds", inbounds)
+        // The tunnel's DNS is the core's own business: the VpnService hands every resolver
+        // query to 198.18.0.2:53, and the core must answer it with its DNS module instead of
+        // routing the packet somewhere that cannot exist.
+        hijackTunnelDns(root)
         // The acknowledgement this start waits for is an info-level line, and it is only
         // written if the core logs at all — the panel's own level may filter it out. `error`
         // is the core's general log; `access` records requests, which is not what a start
@@ -319,6 +420,93 @@ class XrayPlugin : FlutterPlugin, MethodChannel.MethodCallHandler {
