+			taken[name] = true
+		}
+	}
+	content := append([]*yaml.Node{}, added.Content...)
+	for _, item := range profile.Content {
+		if name := nameOf(item); name != "" && taken[name] {
+			continue
+		}
+		content = append(content, item)
+	}
+	return &yaml.Node{Kind: yaml.SequenceNode, Tag: "!!seq", Content: content}, nil
