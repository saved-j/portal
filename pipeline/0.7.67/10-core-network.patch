+                // [MAX_LINES] lines are what a device check reads anyway.
+                val lines = file.readLines()
+                if (lines.size > MAX_LINES) {
+                    file.writeText(lines.takeLast(MAX_LINES).joinToString("\n") + "\n")
+                }
+            }
+        }
+    }
+}
