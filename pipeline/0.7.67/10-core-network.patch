+    private fun append(file: File, line: String) {
+        synchronized(this) {
+            runCatching {
+                val parent = file.parentFile
+                if (parent != null && !parent.exists()) parent.mkdirs()
+                file.appendText(line + "\n", Charsets.UTF_8)
