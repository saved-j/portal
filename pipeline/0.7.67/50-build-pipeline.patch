diff --git a/test/panel_config_test.dart b/test/panel_config_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a6474d2584bdeb1bc9a06c41ddf6293682dc8be8
--- /dev/null
+++ b/test/panel_config_test.dart
@@ -0,0 +1,43 @@
+import 'dart:convert';
+
+import 'package:fl_clash/core/subscription_formats.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// Happ and Incy are served a ready Xray document instead of a link list, so the app must
+/// recognise it and hand the document itself to the child, whose entry point is the tunnel.
+void main() {
+  const panelConfig = '''
+{
+  "log": {"loglevel": "warning"},
+  "inbounds": [{"tag": "old", "listen": "127.0.0.1", "port": 2080, "protocol": "socks"}],
+  "outbounds": [{"tag": "proxy", "protocol": "vless", "settings": {}}]
+}
+''';
+
+  test('a json config is recognised as the xray format', () {
+    expect(detectFormat(panelConfig), SubscriptionFormat.xray);
+  });
+
+  test('a config wrapped in a one-element array is still a config', () {
+    final wrapped = '[$panelConfig]';
+    expect(detectFormat(wrapped), SubscriptionFormat.xray);
+    final document = decodeClientConfig(wrapped);
+    expect(document, isA<Map>(), reason: 'the wrapper is unwrapped for the child');
+    expect(document!['outbounds'], isA<List>());
+  });
+
+  test('a json document without inbounds or outbounds is not', () {
+    expect(detectFormat('{"hasMihomo": true}'), isNull);
+  });
+
+  test('the document reaches the child as the panel wrote it', () {
+    final document = decodeClientConfig(panelConfig);
+    expect(document, isNotNull);
+    // Nothing rewrites the inbounds any more: the plugin replaces them with the tunnel.
+    final inbounds = document!['inbounds'] as List;
+    expect(inbounds, hasLength(1));
+    expect((inbounds.first as Map)['port'], 2080);
+    expect((document['outbounds'] as List), hasLength(1));
+    expect(jsonDecode(panelConfig)['log'], document['log']);
+  });
+}
diff --git a/test/plugins/portal_switch_timing_test.dart b/test/plugins/portal_switch_timing_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..f4c4015823413bd53479b1f2766f1e1d0d77ce23
--- /dev/null
+++ b/test/plugins/portal_switch_timing_test.dart
@@ -0,0 +1,100 @@
+import 'package:fl_clash/common/constant.dart';
+import 'package:fl_clash/plugins/portal_switch_timing.dart';
+import 'package:flutter/services.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// The switch's clock has one job and it is a measurement: exactly one `switchStart` per tap,
+/// at most one `phase=list` line per tap, and nothing at all when there was no tap. A clock
+/// that wrote a line twice, or wrote one for a screen that merely rebuilt, would turn the
+/// number the owner reads into an average of things that did not happen.
+void main() {
+  TestWidgetsFlutterBinding.ensureInitialized();
+
+  const channel = MethodChannel('$packageName/portal');
+
+  final calls = <MethodCall>[];
+
+  setUp(() {
+    calls.clear();
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(channel, (call) async {
+          calls.add(call);
+          return null;
+        });
+    portalSwitchClock.end();
+  });
+
+  tearDown(() {
+    TestDefaultBinaryMessengerBinding.instance.defaultBinaryMessenger
+        .setMockMethodCallHandler(channel, null);
+    portalSwitchClock.end();
+  });
+
+  test('a tap starts the record clock once, wherever it is going', () async {
+    portalSwitchClock.begin(toSimple: false);
+    portalSwitchClock.begin(toSimple: true);
+    await Future<void>.delayed(Duration.zero);
+
+    final starts = calls.where((call) => call.method == 'switchStart').toList();
+    expect(starts, hasLength(2));
+    expect((starts.first.arguments as Map)['to'], 'rule');
+    expect((starts.last.arguments as Map)['to'], 'global');
+  });
+
+  test('the list line is written once per tap and names its source', () async {
+    portalSwitchClock.begin(toSimple: false);
+    await Future<void>.delayed(Duration.zero);
+
+    portalSwitchClock.listPopulated(
+      mode: 'rule',
+      owner: 'engine',
+      source: 'held',
+      rows: 27,
+      names: ['VPN - Main', 'Auto 1', 'Финляндия'],
+    );
+    portalSwitchClock.listPopulated(
+      mode: 'global',
+      owner: 'child',
+      source: 'live',
+      rows: 27,
+    );
+    await Future<void>.delayed(Duration.zero);
+
+    final timed = calls.where((call) => call.method == 'switchTiming').toList();
+    expect(timed, hasLength(1));
+    final arguments = timed.single.arguments as Map;
+    expect(arguments['phase'], 'list');
+    expect(
+      arguments['detail'],
+      'mode=rule owner=engine source=held rows=27 '
+      'names=VPN - Main | Auto 1 | Финляндия',
+    );
+    expect(arguments['durationMs'], isA<int>());
+  });
+
+  test('a screen with no tap behind it writes nothing', () async {
+    portalSwitchClock.listPopulated(
+      mode: 'rule',
+      owner: 'engine',
+      source: 'profile',
+      rows: 3,
+    );
+    await Future<void>.delayed(Duration.zero);
+
+    expect(calls.where((call) => call.method == 'switchTiming'), isEmpty);
+  });
+
+  test('a switch that failed stops its clock instead of writing a length', () async {
+    portalSwitchClock.begin(toSimple: true);
+    portalSwitchClock.end();
+    portalSwitchClock.listPopulated(
+      mode: 'global',
+      owner: 'child',
+      source: 'held',
+      rows: 27,
+    );
+    await Future<void>.delayed(Duration.zero);
+
+    expect(calls.where((call) => call.method == 'switchTiming'), isEmpty);
+  });
+}
