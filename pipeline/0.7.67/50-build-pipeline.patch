diff --git a/test/common/redact_test.dart b/test/common/redact_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..7f9f80c80c34238202da716a7300ce9add891b78
--- /dev/null
+++ b/test/common/redact_test.dart
@@ -0,0 +1,29 @@
+import 'package:fl_clash/common/redact.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// A subscription URL carries its key, and the app's logs are readable over adb by design.
+/// What is written about a URL therefore has to be the part that cannot fetch anything.
+void main() {
+  test('credentials and query are cut off', () {
+    expect(
+      redactUrl('https://user:secret@panel.example/sub/abc?token=xyz'),
+      'https://panel.example',
+    );
+  });
+
+  test('a key in the path is cut with the path', () {
+    expect(
+      redactUrl('https://rnpremiumsub.icu/8f3c1d2e9a'),
+      'https://rnpremiumsub.icu',
+    );
+  });
+
+  test('a plain host keeps its scheme', () {
+    expect(redactUrl('http://192.168.2.3:8191/x'), 'http://192.168.2.3');
+  });
+
+  test('a value that is not a URL is not repeated', () {
+    expect(redactUrl('8f3c1d2e9a'), '<unparsed-url>');
+    expect(redactUrl(null), '');
+  });
+}
diff --git a/test/core/auto_ping_interval_test.dart b/test/core/auto_ping_interval_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..3c434aea49afccf62ac2fb4114c049719528f384
--- /dev/null
+++ b/test/core/auto_ping_interval_test.dart
@@ -0,0 +1,69 @@
+import 'package:fl_clash/core/auto_ping_interval.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// The switch's number must reach exactly the groups that time themselves, and must never
+/// overwrite a provider's choice — those two rules are what make "as in the subscription" mean
+/// something.
+void main() {
+  Map<String, dynamic> document(List<Map<String, dynamic>> groups) => {
+        'proxy-groups': groups,
+      };
+
+  test('a url-test with interval 0 takes the owner period', () {
+    final doc = document([
+      {'name': 'Авто', 'type': 'url-test', 'interval': 0},
+    ]);
+    expect(applyAutoPingInterval(doc, 90), 1);
+    expect(doc['proxy-groups'][0]['interval'], 90);
+  });
+
+  test('a url-test without an interval takes it too', () {
+    final doc = document([
+      {'name': 'Авто', 'type': 'url-test'},
+    ]);
+    expect(applyAutoPingInterval(doc, 60), 1);
+    expect(doc['proxy-groups'][0]['interval'], 60);
+  });
+
+  test("a provider's own number is kept", () {
+    final doc = document([
+      {'name': 'Авто', 'type': 'url-test', 'interval': 180},
+    ]);
+    expect(applyAutoPingInterval(doc, 60), 0);
+    expect(doc['proxy-groups'][0]['interval'], 180);
+  });
+
+  test('a select group is left alone: it has no clock', () {
+    final doc = document([
+      {'name': 'Выбор', 'type': 'select'},
+    ]);
+    expect(applyAutoPingInterval(doc, 60), 0);
+    expect(doc['proxy-groups'][0].containsKey('interval'), isFalse);
+  });
+
+  test('fallback and load-balance are timed groups as well', () {
+    final doc = document([
+      {'name': 'A', 'type': 'fallback', 'interval': 0},
+      {'name': 'B', 'type': 'load-balance', 'interval': '0'},
+    ]);
+    expect(applyAutoPingInterval(doc, 120), 2);
+    expect(doc['proxy-groups'][0]['interval'], 120);
+    expect(doc['proxy-groups'][1]['interval'], 120);
+  });
+
+  test('no opinion changes nothing', () {
+    final doc = document([
+      {'name': 'Авто', 'type': 'url-test', 'interval': 0},
+    ]);
+    expect(applyAutoPingInterval(doc, null), 0);
+    expect(doc['proxy-groups'][0]['interval'], 0);
+  });
+
+  test('zero is never written, even if it is asked for', () {
+    final doc = document([
+      {'name': 'Авто', 'type': 'url-test', 'interval': 0},
+    ]);
+    expect(applyAutoPingInterval(doc, 0), 0);
+    expect(doc['proxy-groups'][0]['interval'], 0);
+  });
+}
diff --git a/test/core/sweep_ledger_test.dart b/test/core/sweep_ledger_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..393c8e9a01cd4e6d489d95d7eb89110add7f3d08
--- /dev/null
+++ b/test/core/sweep_ledger_test.dart
@@ -0,0 +1,117 @@
+import 'package:fl_clash/core/sweep_ledger.dart';
+import 'package:fl_clash/enum/enum.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// A sweep writes rows into one map, and two sweeps writing into it is a defect the audit
+/// found twice: a cancelled sweep that kept its number came back to life, and a profile
+/// change left another subscription's dates looking fresh. These tests pin the rules.
+void main() {
+  late DateTime clock;
+  late SweepLedger ledger;
+
+  setUp(() {
+    clock = DateTime(2026, 11, 16, 12);
+    ledger = SweepLedger(now: () => clock);
+  });
+
+  group('a sweep is current only while it is the newest', () {
+    test('beginning a sweep supersedes the previous one', () {
+      final first = ledger.begin(Mode.rule);
+      expect(ledger.isCurrent(first, Mode.rule), isTrue);
+
+      final second = ledger.begin(Mode.rule);
+      expect(ledger.isCurrent(first, Mode.rule), isFalse);
+      expect(ledger.isCurrent(second, Mode.rule), isTrue);
+    });
+
+    test('a cancelled sweep never becomes current again', () {
+      final first = ledger.begin(Mode.global);
+      ledger.cancel();
+      final second = ledger.begin(Mode.global);
+
+      // The number the cancelled sweep held is not the newest one any more — the defect was
+      // that it was: cancelling reset the id, so the next sweep took the same number.
+      expect(first, isNot(second));
+      expect(ledger.isCurrent(first, Mode.global), isFalse);
+      expect(ledger.isCurrent(second, Mode.global), isTrue);
+    });
+
+    test('a sweep does not answer for the other mode', () {
+      final sweep = ledger.begin(Mode.rule);
+      expect(ledger.isCurrent(sweep, Mode.global), isFalse);
+    });
+
+    test('a mode switch supersedes the sweep that was running', () {
+      final sweep = ledger.begin(Mode.rule);
+      ledger.cancel();
+      expect(ledger.isCurrent(sweep, Mode.rule), isFalse);
+      expect(ledger.mode, isNull);
+    });
+  });
+
+  group('a number is a fact with a date', () {
+    test('a row is fresh for two minutes, not longer', () {
+      ledger.record('Эстония', 120);
+      expect(ledger.isFresh('Эстония'), isTrue);
+
+      clock = clock.add(const Duration(minutes: 1, seconds: 59));
+      expect(ledger.isFresh('Эстония'), isTrue);
+
+      clock = clock.add(const Duration(seconds: 2));
+      expect(ledger.isFresh('Эстония'), isFalse);
+    });
+
+    test('a dash counts as measured', () {
+      ledger.record('Мёртвый узел', null);
+      expect(ledger.isFresh('Мёртвый узел'), isTrue);
+    });
+
+    test('an unknown row is not fresh', () {
+      expect(ledger.isFresh('Никогда не мерили'), isFalse);
+    });
+  });
+
+  group('a deliberate press ignores the window', () {
+    test('a fresh row is measured again when forced', () {
+      ledger.record('Эстония', 120);
+      expect(ledger.needsMeasurement('Эстония'), isFalse);
+      expect(ledger.needsMeasurement('Эстония', force: true), isTrue);
+    });
+
+    test('a stale row is measured anyway', () {
+      ledger.record('Эстония', 120);
+      clock = clock.add(const Duration(minutes: 3));
+      expect(ledger.needsMeasurement('Эстония'), isTrue);
+    });
+  });
+
+  group('the same list is not swept twice', () {
+    test('asking again for the same names inside the window is skipped', () {
+      expect(ledger.shouldStart(Mode.global, 'a|b'), isTrue);
+      ledger.markStarted(Mode.global, 'a|b');
+      expect(ledger.shouldStart(Mode.global, 'a|b'), isFalse);
+
+      clock = clock.add(const Duration(minutes: 2, seconds: 1));
+      expect(ledger.shouldStart(Mode.global, 'a|b'), isTrue);
+    });
+
+    test('a different list or another mode is a new sweep', () {
+      ledger.markStarted(Mode.global, 'a|b');
+      expect(ledger.shouldStart(Mode.global, 'a|b|c'), isTrue);
+      expect(ledger.shouldStart(Mode.rule, 'a|b'), isTrue);
+    });
+  });
+
+  group('another profile is another subscription', () {
+    test('reset forgets the rows and the dates', () {
+      ledger.record('Эстония', 120);
+      final sweep = ledger.begin(Mode.rule);
+
+      ledger.reset();
+
+      expect(ledger.isFresh('Эстония'), isFalse);
+      expect(ledger.measuredAt, isEmpty);
+      expect(ledger.isCurrent(sweep, Mode.rule), isFalse);
+    });
+  });
+}
diff --git a/test/core/xray_ping_test.dart b/test/core/xray_ping_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..bbebc3b951e9023aef9ef6a6161a51b241a9753b
--- /dev/null
+++ b/test/core/xray_ping_test.dart
@@ -0,0 +1,55 @@
+import 'dart:io';
+
+import 'package:fl_clash/core/xray_ping.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// The number on a simple-portal row is a request the child carries, timed to its first byte.
+/// These tests pin the two halves of that promise: a request that comes back produces a number
+/// and names what it asked for, and a request that cannot come back produces a dash — never a
+/// number the phone made up.
+void main() {
+  late HttpServer server;
+  late String url;
+
+  setUp(() async {
+    server = await HttpServer.bind(InternetAddress.loopbackIPv4, 0);
+    server.listen((request) async {
+      request.response.statusCode = 204;
+      await request.response.close();
+    });
+    url = 'http://127.0.0.1:${server.port}/generate_204';
+  });
+
+  tearDown(() async {
+    await server.close(force: true);
+  });
+
+  test('a request that answers is a number, and the line names what it timed', () async {
+    final probe = await probeThroughPortal(url);
+    expect(probe.note, PortalDelayNote.measured);
+    expect(probe.ms, isNotNull);
+    expect(probe.ms, greaterThanOrEqualTo(0));
+    expect(probe.describe(), contains('generate_204'));
+    expect(probe.describe(), contains('ms'));
+  });
+
+  test('a port nothing listens on is a dash, not a small number', () async {
+    final closed = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
+    final port = closed.port;
+    await closed.close();
+    final probe = await probeThroughPortal('http://127.0.0.1:$port/generate_204');
+    expect(probe.ms, isNull);
+    expect(probe.note, isNot(PortalDelayNote.measured));
+  });
+
+  test('nothing to request is not a measurement', () async {
+    expect((await probeThroughPortal('')).note, PortalDelayNote.noUrl);
+    expect((await probeThroughPortal('not a url')).note, PortalDelayNote.noUrl);
+  });
+
+  test('the default note for a silent tunnel is its own reason, not a zero', () {
+    const silent = PortalDelay(url: 'https://x/generate_204', note: PortalDelayNote.noTunnel);
+    expect(silent.ms, isNull);
+    expect(silent.describe(), contains('no tunnel'));
+  });
+}
