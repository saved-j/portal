 @immutable
 class UpdateTarget {
   final UpdateInstallKind kind;
@@ -59,19 +97,95 @@ class UpdateTarget {
 
   const UpdateTarget(this.kind, this.archs);
 
-  bool get downloads => archs.isNotEmpty && assetName(archs.first) != null;
-
