+      ref.read(appSettingProvider),
+      profileId,
+      group,
+      proxy,
+    );
+    state = (
+      rules: portalRulePicksFor(settings, profileId),
+      xray: portalXrayPickFor(settings, profileId),
+    );
+    ref.read(appSettingProvider.notifier).update((_) => settings);
+  }
