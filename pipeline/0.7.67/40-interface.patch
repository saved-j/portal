+++ b/lib/core/portal_document.dart
@@ -0,0 +1,162 @@
+/// The document the simple portal actually runs: every node of the subscription, one selected.
+///
+/// The child used to be started on the selected node alone, which made the core blind to the
+/// rest of the list: it holds one outbound, so there is nothing to measure and every figure had
+/// to be produced by the app — a second core, a sweep, a map of its own. mihomo has never worked
+/// that way. It holds every node of a group and its own url-test keeps the numbers fresh, which
+/// is why a dashboard can show them live without measuring anything.
+///
+/// This document gives the child the same shape: one outbound per node, a routing rule that
+/// sends the tunnel's traffic to the selected one, and a `burstObservatory` that makes the core
+/// time all of them on its own schedule. The app then reads the numbers instead of producing
+/// them.
+library;
+
+import 'dart:convert';
+
+import 'xray_subscription.dart';
+
+/// The tag prefix every node's outbound carries. The observatory selects by it.
+const portalNodeTagPrefix = 'node:';
+
+/// The outbound the selected node's traffic goes to before the core starts.
+const portalSelectedTag = 'portal-selected';
+
+/// The document for [servers] with [selected] as the node the tunnel uses.
+///
+/// The panel's own element is passed through per node: its first real outbound is the node, and
+/// anything it declares about that node (transport, tls, headers) is kept untouched. What the
+/// document adds is a tag, a rule, and the observatory.
+///
+/// [probeInterval] is how often the core re-times every node. mihomo's own url-test groups use
+/// the same order of magnitude; the value comes from the owner's switch, not from a constant
+/// buried here.
+String portalChildDocument(
+  List<XrayServerConfig> servers, {
+  required String selected,
+  /// How often the core re-times every node. Null means no schedule at all: the document then
+  /// carries no observatory, because a placeholder period would be a schedule nobody asked for.
+  Duration? probeInterval = const Duration(seconds: 60),
+  String probeUrl = 'https://www.gstatic.com/generate_204',
+}) {
+  final outbounds = <Map<String, Object?>>[];
+  final seen = <String, int>{};
+  for (var index = 0; index < servers.length; index++) {
+    final server = servers[index];
+    final node = _nodeOutbound(server.config);
+    if (node == null) continue;
+    // The tag carries the name, not the position. Two lists of the same subscription can
+    // differ in order — one has the auto-select group, the other does not — and a tag that
+    // means "the third node" then names the wrong row. The name is the only thing both
+    // sides agree on, so it is what the tag says.
+    final repeat = seen.update(server.name, (count) => count + 1, ifAbsent: () => 0);
+    final tag = repeat == 0
+        ? '$portalNodeTagPrefix${server.name}'
+        : '$portalNodeTagPrefix${server.name}#$repeat';
+    outbounds.add({...node, 'tag': tag});
+    if (server.name == selected) {
+      // The selected node keeps a second handle with a stable tag, so the routing rule below
+      // does not have to name an index that changes when the subscription is re-read.
+      outbounds.add({...node, 'tag': portalSelectedTag});
+    }
+  }
+  // A selected name that is not in the list (a stale pick) falls back to the first node: the
+  // portal must come up on something rather than refuse.
+  if (!outbounds.any((item) => item['tag'] == portalSelectedTag) && outbounds.isNotEmpty) {
+    final first = outbounds.first;
+    outbounds.add({...first, 'tag': portalSelectedTag});
+  }
+  outbounds.add({'tag': 'portal-direct', 'protocol': 'freedom'});
+  outbounds.add({'tag': 'portal-blocked', 'protocol': 'blackhole'});
+
+  final document = <String, Object?>{
+    'log': {'loglevel': 'warning'},
+    'outbounds': outbounds,
+    // The tunnel's traffic goes to the node the owner picked; the observatory does the rest.
+    'routing': {
+      'domainStrategy': 'AsIs',
+      'rules': [
+        {
+          'type': 'field',
+          'network': 'tcp,udp',
+          'outboundTag': portalSelectedTag,
+        },
+      ],
+    },
+  };
+  if (probeInterval != null) {
+    // The core times every node itself, on this period, and keeps the results. Nothing of the
+    // app runs for this: no sweep, no second core, no map to fill.
+    document['burstObservatory'] = {
+      'subjectSelector': [portalNodeTagPrefix],
+      // Interval and timeout are Go duration strings, not numbers: Xray parses them with
+      // time.ParseDuration and rejects anything else.
+      'pingConfig': {
+        'destination': probeUrl,
+        'interval': '${probeInterval.inSeconds}s',
+        'timeout': '5s',
+        'sampling': 3,
+        'httpMethod': 'HEAD',
+      },
+    };
+  }
+  return const JsonEncoder.withIndent(' ').convert(document);
+}
+
+/// The name [tag] belongs to in a document built by [portalChildDocument], or null.
+///
+/// The order of the tag indexes is the order of the subscription, so the list the app keeps and
+/// the list the core runs name the same nodes — this is the one place that mapping is written.
+String? portalNameForTag(List<XrayServerConfig> servers, String tag) {
+  final name = portalNameOfTag(tag);
+  if (name == null) return null;
+  // Checked against the list rather than trusted: a tag from a document built on an older
+  // subscription must not put its figure on a row of the newer one.
+  for (final server in servers) {
+    if (server.name == name) return name;
+  }
+  return null;
+}
+
+/// The name a tag carries, with no list to check it against.
+String? portalNameOfTag(String tag) {
+  if (!tag.startsWith(portalNodeTagPrefix)) return null;
+  var name = tag.substring(portalNodeTagPrefix.length);
+  final repeat = name.lastIndexOf('#');
+  if (repeat > 0) {
+    final suffix = name.substring(repeat + 1);
+    if (int.tryParse(suffix) != null) name = name.substring(0, repeat);
+  }
+  return name.isEmpty ? null : name;
+}
+
+/// The tag of the first node called [name] in a document built by [portalChildDocument].
+String? portalTagOf(List<XrayServerConfig> servers, String name) {
+  for (final server in servers) {
+    if (server.name == name) return '$portalNodeTagPrefix$name';
+  }
+  return null;
+}
+
+/// The node outbound of one server's document, without the tag it was given there.
+Map<String, Object?>? _nodeOutbound(Object? config) {
+  Object? document = config;
+  if (config is String) {
+    try {
+      document = jsonDecode(config);
+    } catch (_) {
+      return null;
+    }
+  }
+  if (document is! Map) return null;
+  final outbounds = document['outbounds'];
+  if (outbounds is! List) return null;
+  for (final item in outbounds) {
+    if (item is! Map) continue;
+    final protocol = '${item['protocol'] ?? ''}'.toLowerCase();
+    if (protocol.isEmpty || protocol == 'blackhole' || protocol == 'freedom') continue;
+    if (item.containsKey('balancers') || item.containsKey('selector')) continue;
+    return Map<String, Object?>.from(item);
+  }
+  return null;
+}
diff --git a/lib/core/portal_feed.dart b/lib/core/portal_feed.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a9da481e2f50ed24f98294b1325f5c6f387d5fcf
--- /dev/null
+++ b/lib/core/portal_feed.dart
@@ -0,0 +1,162 @@
+/// The two documents a subscription must serve, and the two modes that need them.
+///
+/// A panel answers one link with two different bodies, and it decides per request which of
+/// them to serve: the engine's own config (Clash YAML, proxies + rules) and the node list the
+/// second core runs. Either can fail on its own — a panel that answers the engine format with
+/// `502` may still serve the node list — so the two are counted apart, and one mode going
+/// dark never touches the other.
+///
+/// The count is the app's own observation, not the file's state: a failed fetch deliberately
+/// leaves the last good file on disk, because a working subscription must never be replaced
+/// by an error page. A file that exists therefore proves nothing about whether the panel
+/// still serves it. Three failures in a row are what turn a mode off, and the next success of
+/// that same feed turns it back on — no restart, no cache to clear.
+library;
+
+import 'dart:async';
+
+import 'package:flutter/foundation.dart';
+
+import '../enum/enum.dart';
+import '../common/print.dart';
+import '../plugins/portal_runtime.dart';
+
+/// One document the app has to fetch.
+enum PortalFeed {
+  /// The engine's own format: `proxies:`, `proxy-groups:` and `rules:`. Without it the
+  /// network mode has nothing to route.
+  engine,
+
+  /// The node list for the second core: share links or a ready client config. Without it the
+  /// simple portal has nothing to run.
+  xray;
+
+  /// The name the log and the transitions file carry.
+  String get label => switch (this) {
+        PortalFeed.engine => 'engine',
+        PortalFeed.xray => 'xray',
+      };
+
+  /// The mode this feed makes usable, as the app names its modes.
+  String get mode => switch (this) {
+        PortalFeed.engine => 'rule',
+        PortalFeed.xray => 'global',
+      };
+}
+
+/// A feed is refused after this many failures in a row.
+///
+/// Three, not one: a panel behind a flapping CDN answers `502` once and serves the next
+/// request, and a mode that dies on the first hiccup is worse than one that waits. Three is
+/// also the point where the owner has watched it fail repeatedly, so the control has to
+/// start telling the truth instead of offering a switch that cannot work.
+const portalFeedStrikeLimit = 3;
+
+/// What one feed's own counter says.
+@immutable
+class FeedStrikes {
+  const FeedStrikes({this.failures = 0, this.reason = '', this.at});
+
+  /// Failures in a row, since this feed's last success.
+  final int failures;
+
+  /// The last failure's own words, for the control that has to explain itself.
+  final String reason;
+
+  /// When the last attempt that moved the count happened.
+  final DateTime? at;
+
+  /// True once the mode this feed enables must not be offered.
+  bool get blocked => failures >= portalFeedStrikeLimit;
+
+  /// The counter of a feed that answered: no failures, nothing to explain.
+  static const FeedStrikes clear = FeedStrikes();
+
+  FeedStrikes fail(String why) => FeedStrikes(
+        failures: failures + 1,
+        reason: why,
+        at: DateTime.now(),
+      );
+}
+
+/// The app's own record of both feeds, one counter each.
+///
+/// Process-wide and in memory on purpose: these are attempts made by *this* run of the app,
+/// so a restart starts the count again and the portal may try once more. Nothing here is
+/// written to disk — the profile files are the last good download, and they are deliberately
+/// kept when a fetch fails.
+class PortalFeeds extends ChangeNotifier {
+  PortalFeeds._();
+
+  static final PortalFeeds instance = PortalFeeds._();
+
+  final Map<PortalFeed, FeedStrikes> _strikes = {};
+
+  FeedStrikes strikesOf(PortalFeed feed) => _strikes[feed] ?? const FeedStrikes();
+
+  /// Both counters, for a widget that has to draw them.
+  Map<PortalFeed, FeedStrikes> get snapshot => {
+        for (final feed in PortalFeed.values) feed: strikesOf(feed),
+      };
+
+  /// One attempt at one feed.
+  ///
+  /// [ok] is that attempt's whole answer: a body that arrived, parsed, carried what the mode
+  /// needs and matched its format. A success clears this feed's counter and leaves the other
+  /// feed exactly as it was — the two are independent, which is the point of counting them
+  /// here instead of deriving one from the other.
+  void note(PortalFeed feed, {required bool ok, String reason = ''}) {
+    final before = strikesOf(feed);
+    final next = ok
+        ? FeedStrikes.clear
+        : before.fail(
+            reason.isEmpty ? 'the fetch did not answer' : reason,
+          );
+    // The counter moves only when the answer did. A success that follows a success changes
+    // nothing on screen, but it is still written: the log is the record of every attempt, and
+    // a line per attempt is what lets a device check quote the count instead of guessing it.
+    final moved = next.failures != before.failures || next.reason != before.reason;
+    if (moved) {
+      _strikes[feed] = next;
+      notifyListeners();
+    }
+    _record(feed, next, reset: ok && before.failures > 0);
+  }
+
+  /// The mode's refusal as a sentence, or null while the feed still answers.
+  ///
+  /// Callers put this inside a localized sentence; the words here name the fact, not the
+  /// language.
+  String? denialOf(PortalFeed feed) {
+    final strikes = strikesOf(feed);
+    if (!strikes.blocked) return null;
+    return '${feed.label}: ${strikes.failures} failed attempts in a row'
+        '${strikes.reason.isEmpty ? '' : ' (${strikes.reason})'}';
+  }
+
+  void _record(PortalFeed feed, FeedStrikes strikes, {required bool reset}) {
+    final state = strikes.blocked ? 'unavailable' : 'ok';
+    commonPrint.log(
+      'availability: feed=${feed.label} mode=${feed.mode} '
+      'attempts=${strikes.failures}/$portalFeedStrikeLimit state=$state'
+      '${reset ? ' outcome=reset' : ''}'
+      '${strikes.reason.isEmpty ? '' : ' reason=${strikes.reason}'}',
+      logLevel: strikes.blocked ? LogLevel.warning : LogLevel.info,
+    );
+    // The same line in the file adb can read: a count that only exists on screen is a count
+    // nobody can quote from a device.
+    unawaited(
+      portalRuntime.noteAvailability(
+        feed: feed.label,
+        mode: feed.mode,
+        attempts: strikes.failures,
+        limit: portalFeedStrikeLimit,
+        state: state,
+        reason: strikes.reason,
+      ),
+    );
+  }
+}
+
+/// The one ledger both the fetch path and the controls read.
+final portalFeeds = PortalFeeds.instance;
diff --git a/lib/core/proxy_endpoints.dart b/lib/core/proxy_endpoints.dart
new file mode 100644
index 0000000000000000000000000000000000000000..75974212cab01526c3b5cb4ac5148f31cf252547
--- /dev/null
+++ b/lib/core/proxy_endpoints.dart
@@ -0,0 +1,107 @@
+import 'dart:convert';
+import 'dart:io';
+
+import 'package:yaml/yaml.dart';
+
+/// Where each engine server actually listens.
+///
+/// The engine will not say: its API lists names and delay history, never addresses. The
+/// subscription body does carry them, so they are read once when the profile updates and
+/// kept beside it — that is what lets the row time a TCP handshake instead of asking a
+/// core that has no answer.
+class ProxyEndpoint {
+  const ProxyEndpoint(this.host, this.port);
+
+  final String host;
+  final int port;
+
+  bool get isUsable => host.isNotEmpty && port > 0;
+
+  Map<String, Object?> toJson() => {'host': host, 'port': port};
+
+  static ProxyEndpoint? fromJson(Object? json) {
+    if (json is! Map) return null;
+    final host = '${json['host'] ?? ''}'.trim();
+    final port = switch (json['port']) {
+      final int value => value,
+      final Object value => int.tryParse(value.toString()) ?? 0,
+      null => 0,
+    };
+    if (host.isEmpty || port <= 0) return null;
+    return ProxyEndpoint(host, port);
+  }
+}
+
+/// Reads `proxies: [{name, server, port}]` from a subscription body.
+///
+/// A body that is not YAML, or carries no proxies, yields an empty map: unknown is a dash,
+/// never a guess.
+Map<String, ProxyEndpoint> parseProxyEndpoints(String body) {
+  final text = body.trim();
+  if (text.isEmpty) return const {};
+  Object? document;
+  try {
+    document = loadYaml(text);
+  } catch (_) {
+    return const {};
+  }
+  if (document is! Map) return const {};
+  final proxies = document['proxies'];
+  if (proxies is! List) return const {};
+
+  final result = <String, ProxyEndpoint>{};
+  for (final item in proxies) {
+    if (item is! Map) continue;
+    final name = '${item['name'] ?? ''}'.trim();
+    final host = '${item['server'] ?? ''}'.trim();
+    final port = switch (item['port']) {
+      final int value => value,
+      final Object value => int.tryParse(value.toString()) ?? 0,
+      null => 0,
+    };
+    if (name.isEmpty || host.isEmpty || port <= 0) continue;
+    result[name] = ProxyEndpoint(host, port);
+  }
+  return result;
+}
+
+/// Writes the endpoints beside the profile, so the next launch still knows them.
+Future<void> saveProxyEndpoints(
+  String profilePath,
+  Map<String, ProxyEndpoint> endpoints,
+) async {
+  final file = File('$profilePath.endpoints.json');
+  try {
+    if (endpoints.isEmpty) {
+      if (await file.exists()) await file.delete();
+      return;
+    }
+    await file.writeAsString(
+      jsonEncode({
+        for (final entry in endpoints.entries) entry.key: entry.value.toJson(),
+      }),
+    );
+  } catch (_) {
+    // A cache that cannot be written is not worth failing an update over.
+  }
+}
+
+/// The endpoints saved for this profile, empty when none were saved yet.
+Future<Map<String, ProxyEndpoint>> loadProxyEndpoints(
+  String profilePath,
+) async {
+  final file = File('$profilePath.endpoints.json');
+  try {
+    if (!await file.exists()) return const {};
+    final decoded = jsonDecode(await file.readAsString());
+    if (decoded is! Map) return const {};
+    final result = <String, ProxyEndpoint>{};
+    for (final entry in decoded.entries) {
+      final endpoint = ProxyEndpoint.fromJson(entry.value);
+      if (endpoint != null) result['${entry.key}'] = endpoint;
+    }
+    return result;
+  } catch (_) {
+    return const {};
+  }
+}
diff --git a/lib/core/subscription_availability.dart b/lib/core/subscription_availability.dart
new file mode 100644
index 0000000000000000000000000000000000000000..f0730be24b4a8a2831a91f37215ddf68cd74de74
--- /dev/null
+++ b/lib/core/subscription_availability.dart
@@ -0,0 +1,310 @@
+import 'dart:convert';
+
+import 'package:flutter/foundation.dart' show debugPrint;
+import 'dart:typed_data';
+
+import 'package:fl_clash/core/subscription_formats.dart';
+
+/// What a link turned out to offer, as far as the app can tell.
+///
+/// The panel decides per request, so the answer is never known in advance: it is whatever
+/// came back when we asked with each client's user-agent.
+class SubscriptionAvailability {
+  const SubscriptionAvailability({
+    this.mihomo,
+    this.xray,
+    this.notes = const [],
+  });
+
+  /// The Clash YAML body, when the panel served one.
+  final Uint8List? mihomo;
+
+  /// The share-link body, when the panel served one.
+  final Uint8List? xray;
+
+  /// One line per attempt that failed, so a grey light can say why.
+  final List<String> notes;
+
+  bool get hasMihomo => mihomo != null;
+  bool get hasXray => xray != null;
+
+  /// The node list decoded from the xray body, ready for the converter.
+  List<Map<String, dynamic>> get xrayNodes =>
+      xray == null ? const [] : parseShareLinks(utf8.decode(xray!, allowMalformed: true));
+
+  SubscriptionAvailability withXray(Uint8List? body) =>
+      SubscriptionAvailability(mihomo: mihomo, xray: body, notes: notes);
+
+  SubscriptionAvailability withMihomo(Uint8List? body) =>
+      SubscriptionAvailability(mihomo: body, xray: xray, notes: notes);
+
+  Map<String, dynamic> toJson() => {
+        'hasMihomo': hasMihomo,
+        'hasXray': hasXray,
+        'notes': notes,
+      };
+}
+
+/// Reads a list of share links into proxy definitions the engine can hold.
+///
+/// Only the fields the panel actually put in the link are filled; anything else is the
+/// engine's default, which keeps this function honest about what it was told.
+List<Map<String, dynamic>> parseShareLinks(String body) {
+  final decoded = _unwrapBase64(body);
+  final nodes = <Map<String, dynamic>>[];
+  for (final line in decoded.split(RegExp(r'\r?\n'))) {
+    final text = line.trim();
+    if (text.isEmpty) continue;
+    final uri = Uri.tryParse(text);
+    if (uri == null || !uri.hasScheme) continue;
+    final node = switch (uri.scheme) {
+      'vless' => _vlessFromUri(uri, text),
+      'trojan' => _trojanFromUri(uri, text),
+      'vmess' => _vmessFromLink(text),
+      _ => null,
+    };
+    if (node != null) nodes.add(node);
+  }
+  return nodes;
+}
+
+String _unwrapBase64(String body) {
+  final text = body.trim();
+  if (text.contains('://')) return text;
+  try {
+    return utf8.decode(base64Decode(base64Url.normalize(text.replaceAll(RegExp(r'\s'), ''))));
+  } catch (_) {
+    return text;
+  }
+}
+
+String _labelOf(Uri uri, String fallback) {
+  final hash = uri.fragment.trim();
+  return hash.isEmpty ? fallback : Uri.decodeComponent(hash);
+}
+
+Map<String, dynamic>? _vlessFromUri(Uri uri, String raw) {
+  final uuid = uri.userInfo;
+  if (uuid.isEmpty || uri.host.isEmpty) return null;
+  final query = uri.queryParameters;
+  final node = <String, dynamic>{
+    'name': _labelOf(uri, '${uri.host}:${uri.port}'),
+    'type': 'vless',
+    'server': uri.host,
+    'port': uri.port == 0 ? 443 : uri.port,
+    'uuid': uuid,
+    'network': query['type'] ?? 'tcp',
+    'udp': true,
+  };
+  if ((query['security'] ?? '') == 'tls') node['tls'] = true;
+  if ((query['security'] ?? '') == 'reality') {
+    node['tls'] = true;
+    node['reality-opts'] = {
+      'public-key': query['pbk'] ?? '',
+      'short-id': query['sid'] ?? '',
+    };
+  }
+  if (query['sni'] != null) node['servername'] = query['sni'];
+  if (query['fp'] != null) node['client-fingerprint'] = query['fp'];
+  if (query['flow'] != null && query['flow']!.isNotEmpty) node['flow'] = query['flow'];
+  if (query['path'] != null && query['path']!.isNotEmpty) node['ws-path'] = query['path'];
+  if (query['host'] != null && query['host']!.isNotEmpty) {
+    node['ws-headers'] = {'Host': query['host']};
+  }
+  if (query['serviceName'] != null) node['grpc-service-name'] = query['serviceName'];
+  return node;
+}
+
+Map<String, dynamic>? _trojanFromUri(Uri uri, String raw) {
+  if (uri.userInfo.isEmpty || uri.host.isEmpty) return null;
+  final query = uri.queryParameters;
+  final node = <String, dynamic>{
+    'name': _labelOf(uri, '${uri.host}:${uri.port}'),
+    'type': 'trojan',
+    'server': uri.host,
+    'port': uri.port == 0 ? 443 : uri.port,
+    'password': uri.userInfo,
+    'network': query['type'] ?? 'tcp',
+    'udp': true,
+    'skip-cert-verify': query['allowInsecure'] == '1',
+  };
+  if (query['sni'] != null) node['servername'] = query['sni'];
+  if (query['path'] != null) node['ws-path'] = query['path'];
+  if (query['host'] != null) node['ws-headers'] = {'Host': query['host']};
+  return node;
+}
+
+/// vmess links are a base64 JSON blob rather than a URI with a query.
+Map<String, dynamic>? _vmessFromLink(String raw) {
+  final payload = raw.substring('vmess://'.length).trim();
+  try {
+    final json = jsonDecode(utf8.decode(base64Decode(base64Url.normalize(payload))));
+    if (json is! Map) return null;
+    final server = '${json['add'] ?? ''}';
+    final uuid = '${json['id'] ?? ''}';
+    if (server.isEmpty || uuid.isEmpty) return null;
+    final tls = '${json['tls'] ?? ''}';
+    final node = <String, dynamic>{
+      'name': '${json['ps'] ?? '$server:${json['port']}'}',
+      'type': 'vmess',
+      'server': server,
+      'port': int.tryParse('${json['port']}') ?? 443,
+      'uuid': uuid,
+      'alterId': int.tryParse('${json['aid']}') ?? 0,
+      'cipher': '${json['scy'] ?? 'auto'}',
+      'network': '${json['net'] ?? 'tcp'}',
+      'udp': true,
+    };
+    if (tls == 'tls') node['tls'] = true;
+    if ('${json['sni'] ?? ''}'.isNotEmpty) node['servername'] = '${json['sni']}';
+    if ('${json['path'] ?? ''}'.isNotEmpty) node['ws-path'] = '${json['path']}';
+    if ('${json['host'] ?? ''}'.isNotEmpty) {
+      node['ws-headers'] = {'Host': '${json['host']}'};
+    }
+    return node;
+  } catch (_) {
+    return null;
+  }
+}
+
+/// Picks the node the owner means from the xray list.
+///
+/// The names come from the link fragments and rarely match the engine's names, so a
+/// selection made for the engine is honoured when it exists and the first node is used
+/// otherwise — better a working portal than none, and the strip shows which node it is.
+Map<String, dynamic>? xrayNodeFor(
+  List<Map<String, dynamic>> nodes,
+  String? preferred,
+) {
+  if (nodes.isEmpty) return null;
+  if (preferred != null) {
+    for (final node in nodes) {
+      if (node['name'] == preferred) return node;
+    }
+  }
+  return nodes.first;
+}
+
+/// True when the link answered with a body the engine can run.
+bool usableForEngine(SubscriptionAvailability availability) =>
+    availability.hasMihomo;
+
+/// True when the link answered with nodes the second core can run.
+bool usableForXray(SubscriptionAvailability availability) =>
+    availability.xrayNodes.isNotEmpty;
+
+/// Kept for callers that only need the format names.
+List<SubscriptionFormat> formatsOf(SubscriptionAvailability availability) => [
+      if (availability.hasMihomo) SubscriptionFormat.mihomo,
+      if (availability.hasXray) SubscriptionFormat.xray,
+    ];
+
+/// The nodes a ready Xray config actually offers, as engine-shaped proxies.
+///
+/// Happ and Incy get a compiled config, not a link list, so the owner's server list must be
+/// rebuilt from it: the selectors, the nodes and the group that holds them. Without this the
+/// list keeps showing the engine's servers after the switch has already moved the traffic.
+List<Map<String, dynamic>> xrayConfigServers(Map<String, dynamic> config) {
+  final outbounds = config['outbounds'];
+  if (outbounds is! List) return const [];
+
+  /// Tags that carry traffic rather than route it.
+  const routers = {'direct', 'block', 'blocked', 'dns', 'dns-out'};
+  final nodes = <String, Map<String, dynamic>>{};
+  for (final item in outbounds) {
+    if (item is! Map) continue;
+    final tag = '${item['tag'] ?? ''}';
+    final protocol = '${item['protocol'] ?? ''}';
+    if (tag.isEmpty) continue;
+    if (routers.contains(tag.toLowerCase()) || routers.contains(protocol.toLowerCase())) {
+      continue;
+    }
+    // A selector is a chooser, not a server: it is shown as a group, never as an endpoint.
+    if (protocol == 'selector' || protocol == 'urltest' || protocol == 'fallback') continue;
+    if (protocol == 'freedom' || protocol == 'blackhole') continue;
+    nodes[tag] = proxyShapeFor(item);
+  }
+  // The shape of the panel's config decides what the list can show, and it differs per
+  // panel; without this line a wrong list is indistinguishable from a wrong parse.
+  debugPrint(
+    'xray outbounds: ${[
+      for (final item in outbounds)
+        if (item is Map) '${item['protocol']}:${item['tag']}',
+    ].join(', ')}',
+  );
+  // A panel may tag its nodes 'auto-N' and put the only readable name inside the
+  // outbound; this line says where to look.
+  for (final item in outbounds) {
+    if (item is Map && '${item['protocol']}' == 'vless') {
+      final text = jsonEncode(item);
+      debugPrint('xray first node: ${text.length > 400 ? text.substring(0, 400) : text}');
+      break;
+    }
+  }
+  return nodes.values.toList();
+}
+
+/// The selector groups inside a ready config, each with the members it may pick.
+List<Map<String, dynamic>> xrayConfigGroups(Map<String, dynamic> config) {
+  final outbounds = config['outbounds'];
+  if (outbounds is! List) return const [];
+  final groups = <Map<String, dynamic>>[];
+  for (final item in outbounds) {
+    if (item is! Map) continue;
+    final protocol = '${item['protocol'] ?? ''}';
+    if (protocol != 'selector' && protocol != 'urltest') continue;
+    final tag = '${item['tag'] ?? ''}';
+    final members = item['settings'];
+    final list = members is Map ? members['servers'] : null;
+    groups.add({
+      'name': tag,
+      'type': protocol == 'urltest' ? 'url-test' : 'select',
+      'proxies': [
+        if (list is List) for (final member in list) '$member',
+      ],
+    });
+  }
+  return groups;
+}
+
+/// One outbound as the shape the interface already renders for a server row.
+Map<String, dynamic> proxyShapeFor(Map item) {
+  final settings = item['settings'];
+  final vnext = settings is Map ? settings['vnext'] : null;
+  final servers = settings is Map ? settings['servers'] : null;
+  String server = '';
+  int port = 0;
+  if (vnext is List && vnext.isNotEmpty && vnext.first is Map) {
+    final first = vnext.first as Map;
+    server = '${first['address'] ?? ''}';
+    port = int.tryParse('${first['port']}') ?? 0;
+  } else if (servers is List && servers.isNotEmpty && servers.first is Map) {
+    final first = servers.first as Map;
+    server = '${first['address'] ?? ''}';
+    port = int.tryParse('${first['port']}') ?? 0;
+  }
+  final stream = item['streamSettings'];
+  final transport = stream is Map ? '${stream['network'] ?? 'tcp'}' : 'tcp';
+  final tag = '${item['tag'] ?? ''}';
+  return {
+    // The panel tags its nodes `auto`, `auto-2`, … which says nothing about the server.
+    // The hostname does: `de-3.bb800.info` is the third German node, so that is what the
+    // row is called. A tag that already reads like a name is kept as it is.
+    'name': _looksAutomatic(tag) ? _nameFromHost(server, tag) : tag,
+    'type': '${item['protocol'] ?? 'proxy'}',
+    'server': server,
+    'port': port,
+    'serverDescription': server.isEmpty ? transport : '$server:$port · $transport',
+  };
+}
+
+/// True for the panel's placeholder tags: `auto`, `auto-2`, `auto_3`, `node-1`.
+bool _looksAutomatic(String tag) =>
+    RegExp(r'^(auto|node|proxy|server)([-_ ]?\d+)?$', caseSensitive: false).hasMatch(tag);
+
+/// A readable name out of a hostname: `de-3.bb800.info` becomes `DE-3`.
+String _nameFromHost(String host, String fallback) {
+  if (host.isEmpty) return fallback;
+  final first = host.split('.').first;
+  return first.isEmpty ? host : first.toUpperCase();
+}
diff --git a/lib/core/subscription_formats.dart b/lib/core/subscription_formats.dart
new file mode 100644
index 0000000000000000000000000000000000000000..6427c1de080ac59d696fdffcaacafa184b7e1020
--- /dev/null
+++ b/lib/core/subscription_formats.dart
@@ -0,0 +1,167 @@
+/// One subscription link, several formats.
+///
+/// A panel may answer the same URL differently depending on the client that asks: a
+/// mihomo user-agent gets Clash YAML, an Xray user-agent gets a share-link list. The app
+/// needs both, because the engine runs mihomo and the second core runs Xray, and the
+/// owner must be able to see which of the two a link actually offers.
+library;
+
+import 'dart:convert';
+
+/// A subscription link and the format each client gets from it.
+enum SubscriptionFormat {
+  /// Clash / mihomo YAML: proxies, proxy-groups and the routing rules.
+  mihomo,
+
+  /// A list of share links (vless://, vmess://, trojan://) in plain text or base64.
+  xray,
+}
+
+/// The user-agent that asks for each format.
+///
+/// These are the strings panels recognise most often; a panel that ignores them answers
+/// with whatever it defaults to, and [detectFormat] is what decides whether the answer is
+/// usable rather than trusting the request.
+const subscriptionUserAgents = <SubscriptionFormat, String>{
+  SubscriptionFormat.mihomo: 'mihomo/1.19.34',
+  SubscriptionFormat.xray: 'Happ/2.9.1',
+};
+
+/// Clients to imitate, in the order they are tried.
+///
+/// A panel serves the node list only to the clients it knows, and answers `502` to the
+/// rest — so which name works is the panel's decision, not ours. Asking as the popular
+/// ones in turn is the only reliable way to find out without the panel's API.
+const xrayUserAgentCandidates = <String>[
+  // Incy first: the panel recognises its current version and answers with the named JSON
+  // subscription. Both clients are accepted; the first body that parses wins.
+  'Incy/3.9.9',
+  'Incy/2.0.0',
+  'Happ/3.9.9',
+  'Happ/2.9.1',
+  'v2rayTun/1.6.0',
+  'v2rayNG/1.8.5',
+  'Streisand/1.0',
+  'Karing/1.1.0',
+  'v2rayN/6.31',
+  'sing-box/1.10.0',
+];
+
+/// What one download attempt produced.
+class SubscriptionAttempt {
+  const SubscriptionAttempt({
+    required this.format,
+    required this.ok,
+    required this.body,
+    this.reason = '',
+  });
+
+  final SubscriptionFormat format;
+  final bool ok;
+  final String body;
+
+  /// Why an attempt was rejected, for a log or a support question; empty when ok.
+  final String reason;
+}
+
+/// Decides which format a body actually is, from the body alone.
+///
+/// A 200 with an error page must not count as a subscription: the caller shows a green
+/// light per format, and a light that lies is worse than no light.
+SubscriptionFormat? detectFormat(String body) {
+  final text = body.trim();
+  if (text.isEmpty) return null;
+
+  // A client config rather than a link list: Happ and Incy are served a JSON document with
+  // inbounds/outbounds, which is Xray's own shape and what the second core runs directly.
+  // It arrives either as an object or wrapped in a one-element array, so both are read.
+  if (text.startsWith('{') || text.startsWith('[')) {
+    final json = _tryDecodeJson(text);
+    if (_looksLikeClientConfig(json)) return SubscriptionFormat.xray;
+  }
+
+  // An Xray client config served under a *client* name. The panel decides by user-agent, and
+  // some panels keep serving the Happ/Incy answer to the mihomo name as well — a body full of
+  // outbounds is not Clash YAML however it arrived, and reading it as a format this mode can
+  // use would let it replace a working config with a document the engine cannot run.
+  if (_looksLikeClientConfig(_tryDecodeJson(text))) return SubscriptionFormat.xray;
+
+  // Clash YAML: a mapping with a proxies list, the one thing the engine cannot run without.
+  if (RegExp(r'^proxies\s*:', multiLine: true).hasMatch(text)) {
+    return SubscriptionFormat.mihomo;
+  }
+  if (text.contains('proxy-groups:') && text.contains('proxies:')) {
+    return SubscriptionFormat.mihomo;
+  }
+
+  // Share links, either plain or wrapped in base64 as most panels ship them.
+  final decoded = _maybeBase64(text);
+  for (final source in [text, decoded]) {
+    if (source == null) continue;
+    if (RegExp(r'^(vless|vmess|trojan|ss|hysteria2?|tuic)://', multiLine: true)
+        .hasMatch(source)) {
+      return SubscriptionFormat.xray;
+    }
+  }
+
+  // A Clash config that only has groups and no proxies is still YAML the engine reads.
+  if (text.startsWith('port:') || text.startsWith('mixed-port:')) {
+    return SubscriptionFormat.mihomo;
+  }
+  return null;
+}
+
+String? _maybeBase64(String text) {
+  final compact = text.replaceAll(RegExp(r'\s'), '');
+  if (compact.length < 20) return null;
+  if (!RegExp(r'^[A-Za-z0-9+/=_-]+$').hasMatch(compact)) return null;
+  try {
+    return String.fromCharCodes(base64Decode(base64Url.normalize(compact)));
+  } catch (_) {
+    return null;
+  }
+}
+
+Object? _tryDecodeJson(String text) {
+  try {
+    return jsonDecode(text);
+  } catch (_) {
+    return null;
+  }
+}
+
+/// True when the body is an Xray *client config* — outbounds and settings, not a link list.
+///
+/// The distinction is load-bearing: a link list is what any core can run after one conversion,
+/// while a client config belongs to the core it was written for. Turning the second into the
+/// first moved the second core's servers into the engine's list, which the owner rejects.
+bool isClientConfig(String body) =>
+    _looksLikeClientConfig(_tryDecodeJson(body.trim()));
+
+/// True for an Xray-shaped document, either bare or wrapped in a list.
+bool _looksLikeClientConfig(Object? json) {
+  bool isConfig(Object? value) =>
+      value is Map && (value['outbounds'] != null || value['inbounds'] != null);
+  if (isConfig(json)) return true;
+  if (json is List) return json.any(isConfig);
+  return false;
+}
+
+/// The config inside a body that may be wrapped in a one-element array.
+Map<String, dynamic>? clientConfigOf(Object? json) {
+  if (json is Map && (json['outbounds'] != null || json['inbounds'] != null)) {
+    return Map<String, dynamic>.from(json);
+  }
+  if (json is List) {
+    for (final item in json) {
+      if (item is Map && (item['outbounds'] != null || item['inbounds'] != null)) {
+        return Map<String, dynamic>.from(item);
+      }
+    }
+  }
+  return null;
+}
+
+/// Decodes a subscription body into a client config, or null when it is not one.
+Map<String, dynamic>? decodeClientConfig(String body) =>
+    clientConfigOf(_tryDecodeJson(body));
diff --git a/lib/core/sweep_ledger.dart b/lib/core/sweep_ledger.dart
new file mode 100644
index 0000000000000000000000000000000000000000..5ead3394555503d2cbb1189e0c8718f638c42e5e
--- /dev/null
+++ b/lib/core/sweep_ledger.dart
@@ -0,0 +1,122 @@
+/// The bookkeeping a delay sweep needs, without a widget, a provider or a socket.
+///
+/// Two facts decide everything a sweep does: whether a row's number is still worth keeping,
+/// and whether the sweep that is about to write is still the newest one. Both are easy to get
+/// subtly wrong — a cancelled sweep that keeps its number looks current again, a profile
+/// change that keeps its dates makes another subscription's rows look fresh — so they live in
+/// one small pure object that tests can drive directly, and the notifier only delegates.
+library;
+
+import '../enum/enum.dart';
+
+/// How long a measurement stays good enough to skip.
+///
+/// Two minutes: a node's reachability does not change in a minute, and a switch back to the
+/// mode just left must not re-measure the half of the list it had just finished.
+const Duration delayFreshness = Duration(minutes: 2);
+
+/// The sweep's own record: a monotonic id, the mode it serves, and when each row was measured.
+class SweepLedger {
+  SweepLedger({DateTime Function()? now, Duration freshness = delayFreshness})
+      : _now = now ?? DateTime.now,
+        freshness = freshness;
+
+  final DateTime Function() _now;
+
+  /// How long a row's number stays fresh. Injected so tests do not wait two minutes.
+  final Duration freshness;
+
+  /// The newest sweep's number. It only ever grows.
+  int _id = 0;
+
+  /// The mode the newest sweep serves, or null when none is running.
+  Mode? _mode;
+
+  final Map<String, DateTime> _measuredAt = {};
+
+  /// The newest sweep's number, for a caller that wants to remember what it started.
+  int get id => _id;
+
+  /// The mode the newest sweep serves.
+  Mode? get mode => _mode;
+
+  /// The rows that carry a number, and when.
+  Map<String, DateTime> get measuredAt => Map.unmodifiable(_measuredAt);
+
+  Mode? _lastMode;
+  int _lastListHash = 0;
+  DateTime? _lastStartedAt;
+
+  /// Whether an automatic sweep is due: the list has never been swept, or its last sweep is
+  /// older than [freshness]. Used by the repeating timer, which must not re-measure a list
+  /// that was just done by the sweep at launch or after a switch.
+  bool isDue(Mode mode, String listKey) => shouldStart(mode, listKey);
+
+  /// Whether this list needs a sweep at all.
+  ///
+  /// A rebuild recreates the widget that asks, and a recreated widget has no memory: without
+  /// this, every rebuild began a new sweep and cancelled the one in flight, so the numbers
+  /// never finished arriving. The rule is the list's own: the same mode and the same names,
+  /// swept less than [freshness] ago, is the sweep that is already running or just finished.
+  bool shouldStart(Mode mode, String listKey) {
+    final at = _lastStartedAt;
+    if (at == null || _lastMode != mode || _lastListHash != listKey.hashCode) {
+      return true;
+    }
+    return _now().difference(at) >= freshness;
+  }
+
+  /// Remembers which list was just swept, and when.
+  void markStarted(Mode mode, String listKey) {
+    _lastMode = mode;
+    _lastListHash = listKey.hashCode;
+    _lastStartedAt = _now();
+  }
+
+  /// Starts a sweep for [mode] and answers its number.
+  ///
+  /// Starting one is what supersedes the previous: nobody else has to clear anything.
+  int begin(Mode mode) {
+    _id++;
+    _mode = mode;
+    return _id;
+  }
+
+  /// Supersedes whatever is running — a mode switch, a profile change, a new list.
+  void cancel() {
+    _id++;
+    _mode = null;
+  }
+
+  /// True while [id] is still the newest sweep and the mode has not changed under it.
+  bool isCurrent(int id, Mode mode) => _id == id && _mode == mode;
+
+  /// Records one answer, a dash included.
+  ///
+  /// A dash is "asked, no answer" and counts as a measurement too: asking again inside the
+  /// freshness window would only spend another timeout on a node that just refused.
+  void record(String name, int? _) {
+    _measuredAt[name] = _now();
+  }
+
+  /// Whether [name] should be measured now.
+  ///
+  /// [force] is a deliberate press of the test button: it measures everything in front of the
+  /// owner whatever the window says. The automatic sweep passes nothing and respects it.
+  bool needsMeasurement(String name, {bool force = false}) =>
+      force || !isFresh(name);
+
+  /// True when [name] carries a number younger than [freshness].
+  bool isFresh(String name) {
+    final at = _measuredAt[name];
+    if (at == null) return false;
+    return _now().difference(at) < freshness;
+  }
+
+  /// Forgets everything: another profile is another subscription, and its names only look
+  /// alike. The sweep in flight is superseded as well.
+  void reset() {
+    _measuredAt.clear();
+    cancel();
+  }
+}
diff --git a/lib/core/update_backoff.dart b/lib/core/update_backoff.dart
new file mode 100644
index 0000000000000000000000000000000000000000..fba1611a9f598198c125ad2739fc053087bda5e3
--- /dev/null
+++ b/lib/core/update_backoff.dart
@@ -0,0 +1,39 @@
+import 'package:fl_clash/l10n/l10n.dart';
+
+/// What happens to a subscription that could not be fetched.
+///
+/// A download that fails is not the end of the subscription: the file on disk is the last
+/// good one, and it keeps the portal running. What the owner needs from the app then is not a
+/// warning that repeats on every start — it is a plain statement that the update did not
+/// happen, and a next attempt that backs off instead of hammering a server that is already
+/// unreachable. One hour, then two, then four, then every four hours: short enough that a
+/// network that comes back is noticed the same day, long enough that a dead panel is not asked
+/// every minute in the background.
+///
+/// The backoff is this app's own memory and never replaces the provider's interval: the first
+/// attempt after a success follows the subscription, and only failures stretch it.
+/// How long to wait after the given number of failures in a row.
+///
+/// 1 failure → 1 hour, 2 → 2 hours, 3 → 3 hours, 4 and more → 4 hours.
+Duration updateBackoffAfter(int failures) {
+  if (failures <= 0) return Duration.zero;
+  final hours = failures >= 4 ? 4 : failures;
+  return Duration(hours: hours);
+}
+
+/// A short sentence for the owner: what failed and when the app will try again.
+///
+/// `at` is the time of the next attempt, already in the reader's clock; the text says it as
+/// an hour of the day, which is what a person can check against their own watch.
+String updateFailureNote({
+  required int failures,
+  required DateTime nextAttempt,
+  required AppLocalizations l,
+  required String reason,
+}) {
+  final hh = nextAttempt.hour.toString().padLeft(2, '0');
+  final mm = nextAttempt.minute.toString().padLeft(2, '0');
+  // The sentence lives in the app's own translations like every other one: a Russian phrase in
+  // an English app is the same defect whichever line it sits on.
+  return failures <= 0 ? reason : l.updateFailedOffline('$hh:$mm');
+}
diff --git a/lib/core/xray_measure.dart b/lib/core/xray_measure.dart
new file mode 100644
index 0000000000000000000000000000000000000000..726f13a05bad9c9017332878dbc6261667a5e7f7
--- /dev/null
+++ b/lib/core/xray_measure.dart
@@ -0,0 +1,118 @@
+/// Timing every node at once, the way the engine does it.
+///
+/// mihomo answers a delay test for a whole list in seconds because one core holds every node
+/// and opens a temporary connection through the one being asked about. The second core does the
+/// same: a document whose outbounds are all of the subscription's nodes, and a dial per node
+/// with that node's tag forced on the context (`session.SetForcedOutboundTagToContext` +
+/// `core.Dial`). Nothing listens on a port, nothing is restarted, and the tunnel's own instance
+/// is untouched — the sweep has its own core slot, so it can run beside an open portal.
+///
+/// The mechanism is lifted from the clients that already ship it: `XTLS/libXray`
+/// (`xray/ping_batch.go`) and `2dust/AndroidLibXrayLite` (`libv2ray_utils.go`).
+library;
+
+import 'dart:convert';
+
+import 'xray_subscription.dart';
+
+/// A measurement document for [servers] plus the tag of every node in it.
+///
+/// The panel's own element is passed through per node: its first real outbound is the node, and
+/// anything it declares about that node (transport, tls, headers) is kept untouched. What the
+/// document adds is only a unique tag, so the sweep can name the node it is timing.
+({String config, List<({String name, String tag})> entries}) measureConfig(
+  List<XrayServerConfig> servers,
+) {
+  final entries = <({String name, String tag})>[];
+  final outbounds = <Map<String, Object?>>[];
+  for (var index = 0; index < servers.length; index++) {
+    final server = servers[index];
+    final node = _nodeOutbound(server.config);
+    if (node == null) continue;
+    final tag = 'node-$index';
+    outbounds.add({...node, 'tag': tag});
+    entries.add((name: server.name, tag: tag));
+  }
+  outbounds.add({'tag': 'blocked', 'protocol': 'blackhole'});
+  return (
+    config: const JsonEncoder.withIndent(' ').convert({
+      'log': {'loglevel': 'warning'},
+      'outbounds': outbounds,
+    }),
+    entries: entries,
+  );
+}
+
+/// The node outbound of one server's document, without the tag it was given there.
+Map<String, Object?>? _nodeOutbound(Object? config) {
+  Object? document = config;
+  if (config is String) {
+    try {
+      document = jsonDecode(config);
+    } catch (_) {
+      return null;
+    }
+  }
+  if (document is! Map) return null;
+  final outbounds = document['outbounds'];
+  if (outbounds is! List) return null;
+  for (final item in outbounds) {
+    if (item is! Map) continue;
+    final protocol = '${item['protocol'] ?? ''}'.toLowerCase();
+    // A blackhole, a freedom outbound or a balancer is not a node; the first real proxy is.
+    if (protocol.isEmpty || protocol == 'blackhole' || protocol == 'freedom') continue;
+    if (item.containsKey('balancers') || item.containsKey('selector')) continue;
+    return Map<String, Object?>.from(item);
+  }
+  return null;
+}
+
+/// One answer from the sweep.
+class MeasuredNode {
+  const MeasuredNode({required this.tag, required this.delay, this.error = ''});
+
+  final String tag;
+
+  /// Milliseconds, or null when the node did not answer.
+  final int? delay;
+
+  final String error;
+}
+
+/// Reads the core's answer: `{"rows":[...]}` on success, `{"error":"..."}` on a fault.
+///
+/// A row's `delay` below zero is the core naming the failure (-1 refused or failed, -2 timed
+/// out); both become "no number", and the reason stays in the log rather than on the row.
+List<MeasuredNode> parseMeasured(String raw) {
+  Object? document;
+  try {
+    document = jsonDecode(raw);
+  } catch (_) {
+    return const [];
+  }
+  if (document is! Map) return const [];
+  final rows = document['rows'];
+  if (rows is! List) return const [];
+  return [
+    for (final row in rows)
+      if (row is Map)
+        MeasuredNode(
+          tag: '${row['tag'] ?? ''}',
+          delay: (row['delay'] is num && (row['delay'] as num) > 0)
+              ? (row['delay'] as num).toInt()
+              : null,
+          error: '${row['error'] ?? ''}',
+        ),
+  ];
+}
+
+/// The core's own words when the sweep itself failed.
+String measuredError(String raw) {
+  try {
+    final document = jsonDecode(raw);
+    if (document is Map) return '${document['error'] ?? ''}';
+  } catch (_) {
+    return '';
+  }
+  return '';
+}
diff --git a/lib/core/xray_ping.dart b/lib/core/xray_ping.dart
new file mode 100644
index 0000000000000000000000000000000000000000..dc6fb3b0784716698ea7182b80c2939ab2d48cf7
--- /dev/null
+++ b/lib/core/xray_ping.dart
@@ -0,0 +1,124 @@
+/// The delay number the simple portal's rows carry, and where it comes from.
+///
+/// The second core's nodes are invisible to the engine: mihomo holds none of them, so every
+/// lookup in its delay table answers "timeout". What the child *can* do is carry a request — so
+/// the number is a real request the child proxies, timed to its first response byte. That is
+/// the tunnel's own end-to-end latency, measured by the only party that can measure it.
+///
+/// The previous version timed a TCP handshake to the node's own address from this process, and
+/// it lied in a way no address filter could catch: with the child holding a tun, this app's own
+/// sockets are routed into it, the core accepts the connection locally and answers in 3–4 ms —
+/// to Estonia, against a real address. A number that never left the phone is worse than a dash,
+/// so the handshake is gone. What is left cannot be answered by the phone: a request to a host
+/// this app does not run has to leave through the node to come back at all.
+library;
+
+import 'dart:async';
+import 'dart:io';
+
+/// Why a row has a number, or does not.
+enum PortalDelayNote {
+  /// The first response byte came back through the child: this is the tunnel's own latency.
+  measured,
+
+  /// No child is carrying traffic, so there is no tunnel to measure through.
+  noTunnel,
+
+  /// Nothing to request: no URL, or a URL without a host.
+  noUrl,
+
+  /// No byte came back within the deadline.
+  timeout,
+
+  /// The connection was refused, the route was unreachable, or the request raised.
+  failed,
+}
+
+/// One measurement through the running portal, and what it timed.
+class PortalDelay {
+  const PortalDelay({
+    required this.url,
+    required this.note,
+    this.ms,
+  });
+
+  final String url;
+  final PortalDelayNote note;
+  final int? ms;
+
+  bool get answered => note == PortalDelayNote.measured && ms != null;
+
+  /// The last path segment, which is what a log line names: `generate_204`.
+  String get target {
+    final uri = Uri.tryParse(url);
+    if (uri == null) return url;
+    final segments = uri.pathSegments;
+    if (segments.isEmpty || segments.last.isEmpty) return uri.host;
+    return segments.last;
+  }
+
+  /// `generate_204 214 ms`, or the reason there is no number.
+  String describe() => switch (note) {
+        PortalDelayNote.measured => '$target $ms ms',
+        PortalDelayNote.noTunnel => 'no tunnel is carrying traffic, no number',
+        PortalDelayNote.noUrl => 'no test url to request',
+        PortalDelayNote.timeout => '$target timed out, no number',
+        PortalDelayNote.failed => '$target failed, no number',
+      };
+}
+
+/// Times a request the running child carries, from the first byte of the connection attempt.
+///
+/// The clock starts before the connection: the round trip that matters includes the tunnel's
+/// own hand-over, so a number started after `connect` would flatter the node. The request is a
+/// `GET` with `Connection: close` and only the first byte is read — a 204 has no body, and
+/// reading it would add throughput to a latency figure.
+///
+/// [url] is the app's own test URL (`appSettingProvider.testUrl`), the same one the engine's
+/// URLTEST uses, so a number from the portal and a number from the engine are comparable.
+Future<PortalDelay> probeThroughPortal(
+  String url, {
+  Duration timeout = const Duration(seconds: 6),
+}) async {
+  final uri = Uri.tryParse(url.trim());
+  if (uri == null || !uri.hasScheme || uri.host.isEmpty) {
+    return PortalDelay(url: url, note: PortalDelayNote.noUrl);
+  }
+  final port = uri.hasPort ? uri.port : (uri.scheme == 'https' ? 443 : 80);
+  final path = uri.path.isEmpty ? '/' : uri.path;
+  final request = 'GET $path HTTP/1.1\r\n'
+      'Host: ${uri.host}\r\n'
+      'User-Agent: portal-delay\r\n'
+      'Accept: */*\r\n'
+      'Connection: close\r\n\r\n';
+  final watch = Stopwatch()..start();
+  Socket? socket;
+  try {
+    // The name, never a stored address: the tunnel's own DNS answers it and the node carries
+    // the connection, which is the whole point of measuring this way.
+    socket = uri.scheme == 'https'
+        ? await SecureSocket.connect(uri.host, port, timeout: timeout)
+        : await Socket.connect(uri.host, port, timeout: timeout);
+    socket.write(request);
+    await socket.flush();
+    final first = await socket.first.timeout(timeout);
+    watch.stop();
+    if (first.isEmpty) {
+      return PortalDelay(url: url, note: PortalDelayNote.failed);
+    }
+    return PortalDelay(
+      url: url,
+      note: PortalDelayNote.measured,
+      ms: watch.elapsedMilliseconds,
+    );
+  } on TimeoutException {
+    return PortalDelay(url: url, note: PortalDelayNote.timeout);
+  } on SocketException {
+    return PortalDelay(url: url, note: PortalDelayNote.failed);
+  } catch (_) {
+    return PortalDelay(url: url, note: PortalDelayNote.failed);
+  } finally {
+    watch.stop();
+    socket?.destroy();
+  }
+}
diff --git a/lib/core/xray_subscription.dart b/lib/core/xray_subscription.dart
new file mode 100644
index 0000000000000000000000000000000000000000..08839ce8910e14be66a5d7eb87e3ed4c80b85b3c
--- /dev/null
+++ b/lib/core/xray_subscription.dart
@@ -0,0 +1,272 @@
+import 'dart:convert';
+
+import '../common/print.dart';
+
+/// A subscription body as the Xray clients understand it.
+///
+/// Documented by the Incy developer docs: a JSON subscription is either one full xray
+/// configuration or an **array of them**, and each element of the array is a separate
+/// server. The name of that server is the tag of its first proxy outbound; its description
+/// comes from `meta.serverDescription`. Anything else in the document is passed to the core
+/// untouched.
+class XrayServerConfig {
+  const XrayServerConfig({
+    required this.name,
+    required this.config,
+    required this.protocol,
+    this.description = '',
+    this.described = false,
+    this.flag = '',
+    this.address = '',
+    this.port = 0,
+  });
+
+  final String name;
+  final String description;
+
+  /// True when [description] is the panel's own note for this server rather than the fallback
+  /// the app derived from the transport.
+  ///
+  /// The panel puts that note in `meta.serverDescription`, which is the field the clients that
+  /// show a comment under the name read. The distinction matters when a body is chosen between
+  /// candidates: a list of servers without notes is a poorer answer than the same list with
+  /// them, even though it parses the same.
+  final bool described;
+  final String flag;
+
+  /// Where the server listens. The row pings this address directly: the engine never holds
+  /// these servers, so asking it for a delay could only ever answer "timeout".
+  final String address;
+  final int port;
+
+  /// The protocol of the outbound that carries traffic — `vless`, `hysteria2`, `trojan`.
+  ///
+  /// It is inside the configuration, not beside it: a full config states its protocol per
+  /// outbound, so reading it here is the only honest source instead of labelling every
+  /// server of this format `xray`.
+  final String protocol;
+
+  /// The whole configuration for this one server, ready to be handed to the core.
+  final Map<String, dynamic> config;
+
+  /// `🇪🇪 Эстония · Максимальная скорость`, the line the owner reads.
+  String get label {
+    final head = flag.isEmpty ? name : '$flag $name';
+    return description.isEmpty ? head : '$head · $description';
+  }
+}
+
+/// Why a body yielded the servers it did, when it yielded none.
+enum XraySubscriptionProblem {
+  /// Not JSON at all: a panel error page, a truncated answer, or a share-link list.
+  notJson,
+
+  /// JSON without a full configuration: the panel spoke another schema.
+  noConfig,
+
+  /// A valid answer that carries no servers.
+  empty,
+}
+
+/// A parsed body: the servers it holds, and why it holds none when it holds none.
+///
+/// The three empty outcomes used to be one empty list, so a panel answering 502 with an
+/// HTML page was indistinguishable from a subscription with no nodes.
+class XraySubscriptionResult {
+  const XraySubscriptionResult(this.servers, [this.problem, this.error]);
+
+  final List<XrayServerConfig> servers;
+  final XraySubscriptionProblem? problem;
+
+  /// The decoder's own words, when there were any.
+  final String? error;
+
+  bool get ok => servers.isNotEmpty;
+
+  /// One line a reader can show, naming what the body actually was.
+  String get message {
+    final reason = switch (problem) {
+      null => '',
+      XraySubscriptionProblem.notJson => 'the answer is not JSON',
+      XraySubscriptionProblem.noConfig => 'no full configuration in the answer',
+      XraySubscriptionProblem.empty => 'the subscription is empty',
+    };
+    if (reason.isEmpty) return '';
+    return error == null || error!.isEmpty ? reason : '$reason: $error';
+  }
+}
+
+/// Reads every server out of a subscription body.
+///
+/// Kept for the callers that only need the list; [parseXraySubscriptionResult] is what a
+/// caller uses when an empty list has to be explained.
+List<XrayServerConfig> parseXraySubscription(String body) =>
+    parseXraySubscriptionResult(body).servers;
+
+/// Reads every server out of a subscription body, with the reason when there are none.
+XraySubscriptionResult parseXraySubscriptionResult(String body) {
+  final text = body.trim();
+  if (text.isEmpty) {
+    return const XraySubscriptionResult([], XraySubscriptionProblem.empty);
+  }
+  Object? decoded;
+  try {
+    decoded = jsonDecode(text);
+  } catch (error) {
+    return XraySubscriptionResult(
+      const [],
+      XraySubscriptionProblem.notJson,
+      '$error',
+    );
+  }
+
+  final configs = <Map<String, dynamic>>[];
+  if (decoded is List) {
+    for (final item in decoded) {
+      if (item is Map && _isFullConfig(item)) {
+        configs.add(Map<String, dynamic>.from(item));
+      }
+    }
+  } else if (decoded is Map && _isFullConfig(decoded)) {
+    configs.add(Map<String, dynamic>.from(decoded));
+  }
+  if (configs.isEmpty) {
+    return const XraySubscriptionResult([], XraySubscriptionProblem.noConfig);
+  }
+
+  // The panel names each configuration in `remarks`; logged once so the shape is visible.
+  // Through the app's own printer, which redacts: the remark is the panel's text, and the
+  // debug sink this used to write to printed it raw and below the level the log screen shows.
+  if (configs.isNotEmpty) {
+    final remarks = configs.take(3).map((config) => config['remarks']).join(' | ');
+    commonPrint.log('xray remarks: $remarks');
+  }
+
+  final servers = <XrayServerConfig>[];
+  for (var index = 0; index < configs.length; index++) {
+    final config = configs[index];
+    final meta = config['meta'];
+    final map = meta is Map ? meta : const {};
+    // The panel writes the whole line in `remarks`: `🇪🇪 Эстония · Максимальная скорость`.
+    // Its first segment is the name, the rest is what the server is for.
+    // Per the format docs the panel writes the whole line in top-level `remarks`, as
+    // `🇵🇱 Poland | TCP` or `🇪🇪 Эстония · Максимальная скорость`: flag and name first,
+    // then what the server is for after the separator.
+    final remarks = '${config['remarks'] ?? ''}'.trim();
+    final parts = remarks.split(RegExp(r'\s*[·|]\s*'));
+    final remarkName = parts.isEmpty ? '' : parts.first.trim();
+    final remarkNote = parts.length > 1 ? parts.skip(1).join('·').trim() : '';
+    // The panel's own note, in the field the clients that show a comment under the name read:
+    // `meta.serverDescription` («Максимальная скорость», «Для мобильного интернета»). A
+    // separator inside `remarks` is the other way the same note arrives, so it is the second
+    // source rather than the only one.
+    final metaNote = '${map['serverDescription'] ?? ''}'.trim();
+    final note = metaNote.isNotEmpty ? metaNote : remarkNote;
+    final endpoint = _endpointOf(config);
+    servers.add(
+      XrayServerConfig(
+        protocol: _protocolOf(config),
+        name: remarkName.isNotEmpty ? remarkName : (_firstProxyTag(config) ?? '${index + 1}'),
+        // No invention: a server the panel did not describe has no note, and the row shows
+        // its protocol there instead. A transport label is a fact about the connection, not
+        // the panel's words about the server.
+        description: note,
+        described: note.isNotEmpty,
+        flag: '${map['serverFlag'] ?? ''}'.trim(),
+        address: endpoint.$1,
+        port: endpoint.$2,
+        config: config,
+      ),
+    );
+  }
+  return XraySubscriptionResult(servers);
+}
+
+/// The address and port of the outbound that carries traffic.
+///
+/// Xray states them per protocol: `settings.vnext[0]` for vless/vmess, `settings.servers[0]`
+/// for trojan, `settings.address`/`port` at the top for the shims. Anything else yields
+/// `('', 0)`, which the row shows as "—" instead of inventing a value.
+(String, int) _endpointOf(Map<String, dynamic> config) {
+  final outbounds = config['outbounds'];
+  if (outbounds is! List) return ('', 0);
+  const routers = {'freedom', 'blackhole', 'dns', 'selector', 'urltest', 'fallback'};
+  for (final item in outbounds) {
+    if (item is! Map) continue;
+    final protocol = '${item['protocol'] ?? ''}'.toLowerCase();
+    if (protocol.isEmpty || routers.contains(protocol)) continue;
+    final settings = item['settings'];
+    if (settings is! Map) continue;
+    final vnext = settings['vnext'];
+    if (vnext is List && vnext.isNotEmpty && vnext.first is Map) {
+      final first = vnext.first as Map;
+      return ('${first['address'] ?? ''}'.trim(), _port(first['port']));
+    }
+    final servers = settings['servers'];
+    if (servers is List && servers.isNotEmpty && servers.first is Map) {
+      final first = servers.first as Map;
+      return ('${first['address'] ?? ''}'.trim(), _port(first['port']));
+    }
+    final direct = '${settings['address'] ?? ''}'.trim();
+    if (direct.isNotEmpty) return (direct, _port(settings['port']));
+  }
+  return ('', 0);
+}
+
+int _port(Object? value) {
+  if (value is int) return value;
+  return int.tryParse('${value ?? ''}') ?? 0;
+}
+
+/// A full configuration carries both halves of the tunnel, per the format's own definition.
+bool _isFullConfig(Map item) =>
+    item['inbounds'] != null || item['outbounds'] != null;
+
+/// The tag of the first outbound that carries traffic.
+///
+/// Per the docs the server's name is the first proxy outbound — not the first outbound,
+/// which is usually `direct` or a balancer selector.
+String? _firstProxyTag(Map<String, dynamic> config) {
+  final outbounds = config['outbounds'];
+  if (outbounds is! List) return null;
+  const routers = {'freedom', 'blackhole', 'dns', 'selector', 'urltest', 'fallback'};
+  for (final item in outbounds) {
+    if (item is! Map) continue;
+    final protocol = '${item['protocol'] ?? ''}'.toLowerCase();
+    final tag = '${item['tag'] ?? ''}'.trim();
+    if (tag.isEmpty) continue;
+    if (routers.contains(protocol)) continue;
+    return tag;
+  }
+  return null;
+}
+
+/// The server the owner means, by name; the first one when the name is unknown.
+///
+/// A selection made for the engine's list does not survive here (the two builds name their
+/// servers differently), so an unknown name must not leave the portal without a node.
+XrayServerConfig? xrayServerFor(List<XrayServerConfig> servers, String? preferred) {
+  if (servers.isEmpty) return null;
+  if (preferred != null) {
+    for (final server in servers) {
+      if (server.name == preferred) return server;
+    }
+  }
+  return servers.first;
+}
+
+/// The protocol of the outbound that carries traffic.
+String _protocolOf(Map<String, dynamic> config) {
+  final outbounds = config['outbounds'];
+  if (outbounds is! List) return 'xray';
+  const routers = {'freedom', 'blackhole', 'dns', 'selector', 'urltest', 'fallback'};
+  for (final item in outbounds) {
+    if (item is! Map) continue;
+    final protocol = '${item['protocol'] ?? ''}'.toLowerCase();
+    if (protocol.isEmpty || routers.contains(protocol)) continue;
+    return protocol;
+  }
+  return 'xray';
+}
+
+
diff --git a/lib/core/xray_switch.dart b/lib/core/xray_switch.dart
new file mode 100644
index 0000000000000000000000000000000000000000..a85ac7977c1e75e63e3087570ac90fb376c88a19
--- /dev/null
+++ b/lib/core/xray_switch.dart
@@ -0,0 +1,61 @@
+import 'dart:io';
+
+import 'package:yaml/yaml.dart';
+
+/// Finds the node the owner picked, inside the config the engine is already running.
+///
+/// The applied config is the one source that carries every subscription node in full: the
+/// app-level model keeps only names and descriptions, and the profile's raw response is not
+/// retained. Reading it here means the child process gets exactly the node the engine would
+/// have used, including keys this file knows nothing about.
+///
+/// Returns null when the pick is a builtin (DIRECT/REJECT) or resolves to nothing, so the
+/// caller can refuse to switch rather than start a child that cannot work.
+Future<Map<String, dynamic>?> nodeDefinitionFor(
+  String configPath,
+  String name, {
+  int depth = 3,
+}) async {
+  final file = File(configPath);
+  if (!file.existsSync()) return null;
+  final document = loadYaml(await file.readAsString());
+  if (document is! Map) return null;
+
+  final direct = _findProxy(document, name);
+  if (direct != null) return direct;
+  final member = _memberOf(document, name, depth);
+  if (member == null) return null;
+  return _findProxy(document, member);
+}
+
+Map<String, dynamic>? _findProxy(Map document, String name) {
+  final proxies = document['proxies'];
+  if (proxies is! List) return null;
+  for (final item in proxies) {
+    if (item is Map && '${item['name']}' == name) {
+      return item.map((key, value) => MapEntry('$key', value));
+    }
+  }
+  return null;
+}
+
+/// A group stands for its first real member; 'Auto' and friends must be opened before a
+/// node can be handed to Xray.
+String? _memberOf(Map document, String name, int depth) {
+  if (depth <= 0) return null;
+  final groups = document['proxy-groups'];
+  if (groups is! List) return null;
+  for (final group in groups) {
+    if (group is! Map || '${group['name']}' != name) continue;
+    final members = group['proxies'];
+    if (members is! List) return null;
+    for (final member in members) {
+      final text = '$member';
+      if (text == 'DIRECT' || text == 'REJECT') continue;
+      if (_findProxy(document, text) != null) return text;
+      final nested = _memberOf(document, text, depth - 1);
+      if (nested != null) return nested;
+    }
+  }
+  return null;
+}
