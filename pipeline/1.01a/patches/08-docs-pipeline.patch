+
+import 'package:fl_clash/core/subscription_availability.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// A subscription that worked five minutes ago must survive a bad answer from the panel.
+/// These tests describe what counts as "usable" before anything on disk is replaced.
+void main() {
+  Uint8List bytes(String text) => Uint8List.fromList(utf8.encode(text));
+
+  test('an error page is not a usable body', () {
+    expect(parseShareLinks('Подписка временно недоступна'), isEmpty);
+    expect(parseShareLinks('<html>502 Bad Gateway</html>'), isEmpty);
+  });
+
+  test('an empty body is not usable', () {
+    expect(parseShareLinks(''), isEmpty);
+    expect(parseShareLinks('   \n\t '), isEmpty);
+  });
+
+  test('a real node list is usable', () {
+    final body = bytes('vless://uuid@host:443?security=reality&pbk=K&sid=1#Node');
+    expect(parseShareLinks(utf8.decode(body)), isNotEmpty);
+  });
+
+  test('a partial list with one broken line still keeps the good node', () {
+    final nodes = parseShareLinks(
+      'vless://\n'
+      'vless://uuid@good.example.net:443#Good\n'
+      'not-a-link\n',
+    );
+    expect(nodes, hasLength(1));
+    expect(nodes.single['name'], 'Good');
+  });
+
+  test('a clash yaml body is never mistaken for a node list', () {
+    const yaml = 'proxies:\n  - name: a\n    type: vless\n';
+    expect(parseShareLinks(yaml), isEmpty);
+  });
+}
diff --git a/test/xray_bridge_config_test.dart b/test/xray_bridge_config_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..d3d6fe6fd1ecbb81fffbe473ca0590c2d1c5fe18
--- /dev/null
+++ b/test/xray_bridge_config_test.dart
@@ -0,0 +1,69 @@
+import 'package:fl_clash/core/xray_bridge_config.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+void main() {
+  Map<String, dynamic> base() => {
+        'mode': 'rule',
+        'proxies': [
+          {'name': 'node-a', 'type': 'vless', 'server': 'a', 'port': 443},
+        ],
+        'proxy-groups': [
+          {'name': 'Auto', 'type': 'url-test', 'proxies': ['node-a']},
+        ],
+        'rules': ['DOMAIN-SUFFIX,vk.com,Auto'],
+      };
+
+  test('the bridge adds one socks proxy and one group, and forces global mode', () {
+    final wrapped = withXrayBridge(base());
+    final proxies = wrapped['proxies'] as List;
+    final groups = wrapped['proxy-groups'] as List;
+
+    expect(proxies.length, 2);
+    final bridge = proxies.last as Map;
+    expect(bridge['name'], xrayBridgeTag);
+    expect(bridge['type'], 'socks5');
+    expect(bridge['server'], '127.0.0.1');
+    expect(bridge['port'], 10808);
+
+    expect(groups.length, 2);
+    expect((groups.last as Map)['proxies'], [xrayBridgeTag]);
+    expect(wrapped['mode'], 'global');
+    expect(wrapped['GLOBAL'], xrayBridgeGroup);
+
+    // the subscription's own entries are still there, just unused in global mode
+    expect((proxies.first as Map)['name'], 'node-a');
+  });
+
+  test('the original config is left untouched', () {
+    final original = base();
+    withXrayBridge(original);
+    expect((original['proxies'] as List).length, 1);
+    expect(original['mode'], 'rule');
+    expect(original.containsKey('GLOBAL'), isFalse);
+  });
+
+  test('wrapping twice does not stack a second bridge', () {
+    final once = withXrayBridge(base());
+    final twice = withXrayBridge(once);
+    final names = (twice['proxies'] as List).map((p) => (p as Map)['name']);
+    expect(names.where((n) => n == xrayBridgeTag).length, 1);
+    final groups = (twice['proxy-groups'] as List).map((g) => (g as Map)['name']);
+    expect(groups.where((n) => n == xrayBridgeGroup).length, 1);
+  });
+
+  test('removing the bridge restores the previous mode and drops only its entries', () {
+    final wrapped = withXrayBridge(base());
+    final restored = withoutXrayBridge(wrapped, restoreMode: 'rule');
+
+    expect(restored['mode'], 'rule');
+    expect(restored.containsKey('GLOBAL'), isFalse);
+    expect((restored['proxies'] as List).length, 1);
+    expect((restored['proxy-groups'] as List).length, 1);
+    expect((restored['rules'] as List).length, 1);
+  });
+
+  test('a custom port is honoured', () {
+    final wrapped = withXrayBridge(base(), port: 2080);
+    expect(((wrapped['proxies'] as List).last as Map)['port'], 2080);
+  });
+}
diff --git a/test/xray_config_test.dart b/test/xray_config_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..cddf7bc6d78c2a11cc0d3e3dbafde7eb5bc1efe9
--- /dev/null
+++ b/test/xray_config_test.dart
@@ -0,0 +1,100 @@
+import 'dart:convert';
+
+import 'package:fl_clash/core/xray_config.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// These tests describe the mapping the app relies on: a Clash proxy entry in, an Xray
+/// outbound out. They run without a phone, a tunnel or a panel.
+void main() {
+  test('vless over ws with tls keeps every field the server needs', () {
+    final json = xrayConfigJson({
+      'name': 'EE-1',
+      'type': 'vless',
+      'server': 'ee1.example.net',
+      'port': 443,
+      'uuid': '11111111-2222-3333-4444-555555555555',
+      'network': 'ws',
+      'tls': true,
+      'servername': 'cdn.example.net',
+      'ws-path': '/ray',
+      'ws-headers': {'Host': 'cdn.example.net'},
+      'client-fingerprint': 'chrome',
+    });
+    final config = jsonDecode(json) as Map<String, dynamic>;
+    final outbound = (config['outbounds'] as List).first as Map<String, dynamic>;
+
+    expect(outbound['protocol'], 'vless');
+    final vnext = (outbound['settings'] as Map)['vnext'] as List;
+    expect((vnext.first as Map)['address'], 'ee1.example.net');
+    expect((vnext.first as Map)['port'], 443);
+    expect(((vnext.first as Map)['users'] as List).first['id'],
+        '11111111-2222-3333-4444-555555555555');
+
+    final stream = outbound['streamSettings'] as Map;
+    expect(stream['network'], 'ws');
+    expect((stream['wsSettings'] as Map)['path'], '/ray');
+    expect(stream['security'], 'tls');
+    expect((stream['tlsSettings'] as Map)['serverName'], 'cdn.example.net');
+  });
+
+  test('reality keeps its public key and short id', () {
+    final config = xrayConfigFor({
+      'type': 'vless',
+      'server': 'r.example.net',
+      'port': 443,
+      'uuid': 'u',
+      'network': 'tcp',
+      'tls': true,
+      'servername': 'www.microsoft.com',
+      'client-fingerprint': 'firefox',
+      'reality-opts': {'public-key': 'PUBKEY', 'short-id': 'ab12'},
+    });
+    final stream = ((config['outbounds'] as List).first
+        as Map<String, dynamic>)['streamSettings'] as Map;
+    expect(stream['security'], 'reality');
+    final reality = stream['realitySettings'] as Map;
+    expect(reality['publicKey'], 'PUBKEY');
+    expect(reality['shortId'], 'ab12');
+    expect(reality['serverName'], 'www.microsoft.com');
+    expect(reality['fingerprint'], 'firefox');
+  });
+
+  test('trojan carries a password and a grpc transport', () {
+    final config = xrayConfigFor({
+      'type': 'trojan',
+      'server': 't.example.net',
+      'port': '8443',
+      'password': 'secret',
+      'network': 'grpc',
+      'grpc-service-name': 'svc',
+    });
+    final outbound = (config['outbounds'] as List).first as Map;
+    expect(outbound['protocol'], 'trojan');
+    final server = ((outbound['settings'] as Map)['servers'] as List).first as Map;
+    expect(server['port'], 8443); // a string port is accepted and normalised
+    expect(server['password'], 'secret');
+    expect((outbound['streamSettings'] as Map)['network'], 'grpc');
+    expect(((outbound['streamSettings'] as Map)['grpcSettings'] as Map)['serviceName'],
+        'svc');
+  });
+
+  test('the socks inbound is always present and bound to localhost', () {
+    final config = xrayConfigFor({
+      'type': 'vless',
+      'server': 's',
+      'port': 1,
+      'uuid': 'u',
+    }, socksPort: 10808);
+    final inbound = (config['inbounds'] as List).first as Map;
+    expect(inbound['protocol'], 'socks');
+    expect(inbound['listen'], '127.0.0.1');
+    expect(inbound['port'], 10808);
+  });
+
+  test('an unknown protocol is refused instead of silently producing nothing', () {
+    expect(
+      () => xrayConfigFor({'type': 'ss', 'server': 's', 'port': 1}),
+      throwsA(isA<UnsupportedProxyType>()),
+    );
+  });
+}
diff --git a/test/xray_servers_test.dart b/test/xray_servers_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..52d5e7a74a1c201228a3441fd10670990fcaf92d
--- /dev/null
+++ b/test/xray_servers_test.dart
@@ -0,0 +1,94 @@
+import 'dart:convert';
+
+import 'package:fl_clash/core/subscription_availability.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// The panel's Xray config carries its own servers and selectors. The owner's server list
+/// must be rebuilt from it, otherwise the list keeps showing the engine's nodes after the
+/// switch has already moved the traffic to the other core.
+void main() {
+  Map<String, dynamic> config() => jsonDecode('''
+{
+  "outbounds": [
+    {"tag": "direct", "protocol": "freedom"},
+    {"tag": "block", "protocol": "blackhole"},
+    {"tag": "Auto Asia", "protocol": "selector", "settings": {"servers": ["KR-1", "JP-2"]}},
+    {"tag": "KR-1", "protocol": "vless",
+     "settings": {"vnext": [{"address": "kr.example.net", "port": 443}]},
+     "streamSettings": {"network": "tcp"}},
+    {"tag": "JP-2", "protocol": "trojan",
+     "settings": {"servers": [{"address": "jp.example.net", "port": 8443}]},
+     "streamSettings": {"network": "ws"}}
+  ]
+}
+''') as Map<String, dynamic>;
+
+  test('traffic-carrying outbounds become servers, routers do not', () {
+    final servers = xrayConfigServers(config());
+    final names = servers.map((s) => s['name']).toList();
+    expect(names, ['KR-1', 'JP-2']);
+    expect(names, isNot(contains('direct')));
+    expect(names, isNot(contains('Auto Asia')), reason: 'a selector is a group, not a server');
+  });
+
+  test('each server carries the address the row shows', () {
+    final servers = xrayConfigServers(config());
+    expect(servers.first['serverDescription'], 'kr.example.net:443 · tcp');
+    expect(servers.last['serverDescription'], 'jp.example.net:8443 · ws');
+  });
+
+  test('a selector becomes a group with its members', () {
+    final groups = xrayConfigGroups(config());
+    expect(groups, hasLength(1));
+    expect(groups.single['name'], 'Auto Asia');
+    expect(groups.single['type'], 'select');
+    expect((groups.single['proxies'] as List), ['KR-1', 'JP-2']);
+  });
+
+  test('the servers a panel compiled are not the engine ones', () {
+    // This is the whole point: a subscription that answers both formats can still name
+    // different nodes in each, and extra ones only in the xray build.
+    final servers = xrayConfigServers(config());
+    expect(servers.map((s) => s['name']), isNot(contains('Auto Europa')));
+  });
+
+  test('a panel tag like auto-2 is replaced by its hostname', () {
+    final servers = xrayConfigServers({
+      'outbounds': [
+        {
+          'tag': 'auto-3',
+          'protocol': 'vless',
+          'settings': {
+            'vnext': [
+              {'address': 'de-3.bb800.info', 'port': 443},
+            ],
+          },
+        },
+      ],
+    });
+    expect(servers.single['name'], 'DE-3');
+    expect(servers.single['server'], 'de-3.bb800.info');
+  });
+
+  test('a tag that already reads like a name stays', () {
+    final servers = xrayConfigServers({
+      'outbounds': [
+        {
+          'tag': 'Австралия',
+          'protocol': 'vless',
+          'settings': {
+            'vnext': [
+              {'address': 'au-1.example.net', 'port': 443},
+            ],
+          },
+        },
+      ],
+    });
+    expect(servers.single['name'], 'Австралия');
+  });
+
+  test('a config without outbounds yields nothing instead of throwing', () {
+    expect(xrayConfigServers(const {}), isEmpty);
+    expect(xrayConfigGroups(const {'outbounds': 'nonsense'}), isEmpty);
+  });
+}
diff --git a/test/xray_subscription_test.dart b/test/xray_subscription_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..622354a6e078429d5d71925cc5271ff11bc9b306
--- /dev/null
+++ b/test/xray_subscription_test.dart
@@ -0,0 +1,157 @@
+import 'dart:convert';
+
+import 'package:fl_clash/core/xray_subscription.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+/// The rules here come from the Incy developer docs: an array of full xray configurations,
+/// where each element is a separate server, named after its first proxy outbound.
+void main() {
+  group('endpoint', _endpointCases);
+  Map<String, dynamic> config(String tag, {String description = '', String remarks = ''}) => {
+        if (remarks.isNotEmpty) 'remarks': remarks,
+        'meta': {'serverDescription': description},
+        'inbounds': [
+          {'tag': 'socks-in', 'protocol': 'socks', 'port': 10808},
+        ],
+        'outbounds': [
+          {'tag': 'direct', 'protocol': 'freedom'},
+          {'tag': tag, 'protocol': 'vless', 'settings': {}},
+          {'tag': 'block', 'protocol': 'blackhole'},
+        ],
+      };
+
+  test('each element of the array is a server', () {
+    final body = jsonEncode([config('Эстония'), config('Финляндия')]);
+    final servers = parseXraySubscription(body);
+    expect(servers, hasLength(2));
+    expect(servers.first.name, 'Эстония');
+    expect(servers.last.name, 'Финляндия');
+  });
+
+  test('the name is the first proxy outbound, not direct', () {
+    final servers = parseXraySubscription(jsonEncode(config('Германия')));
+    expect(servers.single.name, 'Германия');
+  });
+
+  test('the description comes from meta.serverDescription', () {
+    final servers = parseXraySubscription(
+      jsonEncode(config('Нидерланды', description: 'Работает Gemini')),
+    );
+    expect(servers.single.description, 'Работает Gemini');
+    expect(servers.single.label, 'Нидерланды · Работает Gemini');
+  });
+
+  test('a flag from meta is shown in front of the name', () {
+    final item = config('Эстония');
+    (item['meta'] as Map)['serverFlag'] = '🇪🇪';
+    final server = parseXraySubscription(jsonEncode(item)).single;
+    expect(server.label, '🇪🇪 Эстония');
+  });
+
+  test('the whole element is kept, since it is what the core runs', () {
+    final body = jsonEncode([config('KR')]);
+    final server = parseXraySubscription(body).single;
+    expect((server.config['outbounds'] as List), hasLength(3));
+    expect((server.config['inbounds'] as List), hasLength(1));
+  });
+
+  test('the panel name comes from remarks, split at the middle dot', () {
+    final server = parseXraySubscription(
+      jsonEncode(config('proxy', remarks: '🇪🇪 Эстония · Максимальная скорость')),
+    ).single;
+    expect(server.name, '🇪🇪 Эстония');
+    expect(server.description, 'Максимальная скорость');
+  });
+
+  test('the pipe separator the docs show is understood too', () {
+    final server = parseXraySubscription(
+      jsonEncode(config('proxy', remarks: '🇵🇱 Poland | TCP')),
+    ).single;
+    expect(server.name, '🇵🇱 Poland');
+    expect(server.description, 'TCP');
+  });
+
+  test('without remarks the first proxy outbound still names the server', () {
+    expect(parseXraySubscription(jsonEncode(config('KR-1'))).single.name, 'KR-1');
+  });
+
+  test('the protocol comes from the config, not from the core', () {
+    final vless = parseXraySubscription(jsonEncode(config('EE'))).single;
+    expect(vless.protocol, 'vless');
+
+    final hy2 = {
+      'remarks': '🇫🇮 Финляндия',
+      'outbounds': [
+        {'tag': 'direct', 'protocol': 'freedom'},
+        {'tag': 'hy', 'protocol': 'hysteria2', 'settings': {}},
+      ],
+    };
+    expect(parseXraySubscription(jsonEncode(hy2)).single.protocol, 'hysteria2');
+  });
+
+  test('without meta a transport still describes the server', () {
+    final item = config('DE');
+    (item['outbounds'] as List)[1] = {
+      'tag': 'de',
+      'protocol': 'vless',
+      'settings': {},
+      'streamSettings': {'network': 'xhttp'},
+    };
+    expect(parseXraySubscription(jsonEncode(item)).single.description, 'XHTTP');
+  });
+
+  test('a body that is not a configuration yields nothing', () {
+    expect(parseXraySubscription(''), isEmpty);
+    expect(parseXraySubscription('<html>502</html>'), isEmpty);
+    expect(parseXraySubscription('{"hasMihomo":true}'), isEmpty);
+    expect(parseXraySubscription('[]'), isEmpty);
+  });
+}
+
+void _endpointCases() {
+  test('endpoint comes from the transport outbound, not the routers', () {
+    final servers = parseXraySubscription(jsonEncode([
+      {
+        'remarks': '🇪🇪 Эстония · Максимальная скорость',
+        'outbounds': [
+          {'tag': 'direct', 'protocol': 'freedom'},
+          {
+            'tag': 'proxy',
+            'protocol': 'vless',
+            'settings': {
+              'vnext': [
+                {'address': 'ee1.example.com', 'port': 443},
+              ],
+            },
+          },
+        ],
+      },
+      {
+        'remarks': '🇫🇮 Финляндия',
+        'outbounds': [
+          {
+            'tag': 'proxy',
+            'protocol': 'trojan',
+            'settings': {
+              'servers': [
+                {'address': 'fi.example.net', 'port': '8443'},
+              ],
+            },
+          },
+        ],
+      },
+      {
+        'remarks': 'пустой',
+        'outbounds': [
+          {'tag': 'direct', 'protocol': 'freedom'},
+        ],
+      },
+    ]));
+    expect(servers[0].address, 'ee1.example.com');
+    expect(servers[0].port, 443);
+    expect(servers[1].address, 'fi.example.net');
+    expect(servers[1].port, 8443, reason: 'a port written as text still parses');
+    expect(servers[2].address, isEmpty);
+    expect(servers[2].port, 0);
+  });
+}
diff --git a/test/xray_switch_test.dart b/test/xray_switch_test.dart
new file mode 100644
index 0000000000000000000000000000000000000000..03576853d92d15634e0c4d9b4d569846979b9fda
--- /dev/null
+++ b/test/xray_switch_test.dart
@@ -0,0 +1,62 @@
+import 'dart:io';
+
+import 'package:fl_clash/core/xray_switch.dart';
+import 'package:flutter_test/flutter_test.dart';
+
+const _config = '''
+proxies:
+  - name: node-a
+    type: vless
+    server: a.example.net
+    port: 443
+    uuid: u1
+  - name: node-b
+    type: trojan
+    server: b.example.net
+    port: 443
+    password: p
+proxy-groups:
+  - name: Auto
+    type: url-test
+    proxies: [DIRECT, node-b, node-a]
+  - name: Deep
+    type: select
+    proxies: [Auto]
+''';
+
+void main() {
+  late File file;
+
+  setUp(() async {
+    final dir = await Directory.systemTemp.createTemp('xray-switch');
+    file = File('${dir.path}/config.yaml');
+    await file.writeAsString(_config);
+  });
+
+  test('a node is read with every key the engine had', () async {
+    final node = await nodeDefinitionFor(file.path, 'node-a');
+    expect(node, isNotNull);
+    expect(node!['type'], 'vless');
+    expect(node['server'], 'a.example.net');
+    expect(node['uuid'], 'u1');
+  });
+
+  test('a group resolves to its first real member, skipping DIRECT', () async {
+    final node = await nodeDefinitionFor(file.path, 'Auto');
+    expect(node?['name'], 'node-b');
+  });
+
+  test('a group inside a group is opened too', () async {
+    final node = await nodeDefinitionFor(file.path, 'Deep');
+    expect(node?['name'], 'node-b');
+  });
+
+  test('a builtin or an unknown name yields nothing instead of a broken child', () async {
+    expect(await nodeDefinitionFor(file.path, 'DIRECT'), isNull);
+    expect(await nodeDefinitionFor(file.path, 'nope'), isNull);
+  });
+
+  test('a missing config is not an exception', () async {
+    expect(await nodeDefinitionFor('${file.parent.path}/absent.yaml', 'node-a'), isNull);
+  });
+}
