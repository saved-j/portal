+                            child: CommonTargetIcon(
+                              src: groups
+                                      .where((g) => g.name == name)
+                                      .firstOrNull
+                                      ?.icon ??
+                                  '',
+                              fallback: GroupMonogram(name),
+                            ),
+                          ),
+                        ],
+                      ),
+                      title: Text(name),
