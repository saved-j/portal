diff --git a/apply.sh b/apply.sh
new file mode 100755
index 0000000000000000000000000000000000000000..8b51381bf95328f4bb601bc6b809712fc3843921
--- /dev/null
+++ b/apply.sh
@@ -0,0 +1,149 @@
+#!/bin/bash
+# Portal patch dispatcher.
+#
+#   ./apply.sh list                 what series exist
+#   ./apply.sh 0.02 verify          apply the groups to pristine FlClashX and prove the result
+#   ./apply.sh 0.02 apply [dir]     materialise a working copy (default ~/.work/portal-0.02)
+#
+# 0.02 is a grouped series: each group is a binary diff of the product tree against the pinned
+# base and the groups are path-disjoint, so plain `git am` applies them in any order with no
+# --3way. 0.01a is the frozen 48-patch history: kept for audit, NOT replayable (its icon
+# patches conflict with each other), so the dispatcher refuses to apply it and says why.
+set -euo pipefail
+
+REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+PIPELINE="$REPO/pipeline"
+CURRENT="$(cat "$PIPELINE/CURRENT" 2>/dev/null || echo 0.02)"
+die() { printf 'error: %s\n' "$*" >&2; exit 1; }
+
+list_series() {
+  echo "current: $CURRENT"
+  for d in "$PIPELINE"/*/; do
+    [[ -f "$d/REGISTRY.json" ]] || continue
+    python3 - "$d" <<'PY'
+import json, os, sys
+d = sys.argv[1]
+r = json.load(open(os.path.join(d, 'REGISTRY.json')))
+base = (r.get('base') or {}).get('sha', '-')[:8]
+items = r.get('groups') or r.get('patches') or []
+state = r.get('state', 'live')
+print(f"  {os.path.basename(d.rstrip('/')):8s} base {base}  items {len(items):3d}  {state}")
+PY
+  done
+}
+
+series_dir() {
+  local v=$1
+  [[ -d "$PIPELINE/$v" ]] || die "no such series: $v (see ./apply.sh list)"
+  echo "$PIPELINE/$v"
+}
+
+gate() {
+  local dir=$1
+  [[ -f "$dir/REGISTRY.json" ]] || die "missing REGISTRY.json in $dir"
+  python3 - "$dir" <<'PY'
+import hashlib, json, os, sys
+d = sys.argv[1]
+r = json.load(open(os.path.join(d, 'REGISTRY.json')))
+items = r.get('groups') or r.get('patches') or []
+if not items:
+    raise SystemExit('registry lists no items')
+for it in items:
+    p = os.path.join(d, it['file'])
+    if not os.path.isfile(p):
+        raise SystemExit(f"missing patch: {p}")
+    if os.path.getsize(p) == 0:
+        raise SystemExit(f"empty patch: {p}")
+    want = it.get('sha256')
+    got = hashlib.sha256(open(p, 'rb').read()).hexdigest()
+    if want and got != want:
+        raise SystemExit(f"sha256 mismatch for {p}\n  registry {want}\n  on disk  {got}")
+    head = open(p, 'rb').read(4)
+    if not head.startswith(b'From'):
+        raise SystemExit(f"not an mbox: {p}")
+print(f"gate ok: {len(items)} item(s), checksums match")
+PY
+}
+
+group_patches() { # prints full paths, in registry order
+  local dir=$1
+  python3 - "$dir" <<'PY'
+import json, os, sys
+d = sys.argv[1]
+r = json.load(open(os.path.join(d, 'REGISTRY.json')))
+for it in r.get('groups') or r.get('patches') or []:
+    print(os.path.join(d, it['file']))
+PY
+}
+
+verify() {
+  local v=$1 dir; dir=$(series_dir "$v")
+  [[ "$v" == "0.02" ]] || die "$v is an archive; only 0.02 is replayable"
+  gate "$dir"
+  local sha base
+  sha=$(python3 -c "import json;print(json.load(open('$dir/REGISTRY.json'))['base']['sha'])")
+  base=$(git -C "$REPO" rev-parse --verify --quiet "${sha}^{commit}") || die "base $sha is not in this repo — git fetch upstream"
+  # A global, not a local: the EXIT trap runs after the function's scope is gone, and
+  # `set -u` then fails on an unbound local.
+  VERIFY_TMP=$(mktemp -d "${TMPDIR:-/tmp}/portal-verify.XXXXXX")
+  trap 'rm -rf "${VERIFY_TMP:-}"' EXIT
+  local tmp=$VERIFY_TMP
+  git clone -q --no-hardlinks "$REPO" "$tmp/w"
+  git -C "$tmp/w" checkout -q -B verify-0.02 "$base"
+  local applied=0
+  while IFS= read -r patch; do
+    if git -C "$tmp/w" am --quiet "$patch"; then
+      echo "  am ok: $(basename "$patch")"
+      applied=$((applied + 1))
+    else
+      git -C "$tmp/w" am --abort 2>/dev/null || true
+      die "does not apply to pristine FlClashX: $patch"
+    fi
+  done < <(group_patches "$dir")
+  [[ $applied -gt 0 ]] || die "no groups applied"
+  # Exact equality, not a file walk: hash the committed product tree of this repo with the
+  # pipeline directory removed, and compare it with the tree the groups produced. Build
+  # artefacts (build/, dist/, gradlew, local.properties, .DS_Store) never enter a commit,
+  # so they cannot make this comparison lie.
+  local wt idx
+  idx="$tmp/index"
+  GIT_INDEX_FILE="$idx" git -C "$REPO" read-tree HEAD
+  GIT_INDEX_FILE="$idx" git -C "$REPO" rm -r --cached --ignore-unmatch pipeline apply.sh >/dev/null
+  wt=$(GIT_INDEX_FILE="$idx" git -C "$REPO" write-tree)
+  local got; got=$(git -C "$tmp/w" rev-parse 'HEAD^{tree}')
+  if [[ "$wt" == "$got" ]]; then
+    echo "OK: $applied group(s) reproduce the committed product tree ($wt)"
+  else
+    echo "MISMATCH: groups produced $got, the repository has $wt" >&2
+    git -C "$tmp/w" diff --stat "$wt" "$got" 2>/dev/null | head -20 >&2 || true
+    exit 1
+  fi
+}
+
+apply_series() {
+  local v=$1 dest=${2:-} dir; dir=$(series_dir "$v")
+  [[ "$v" == "0.02" ]] || die "$v is an archive and cannot be applied"
+  gate "$dir"
+  dest=${dest:-$HOME/.work/portal-$v}
+  local sha; sha=$(python3 -c "import json;print(json.load(open('$dir/REGISTRY.json'))['base']['sha'])")
+  [[ -e "$dest" ]] && die "destination exists: $dest (move it away first)"
+  git clone -q --no-hardlinks "$REPO" "$dest"
+  git -C "$dest" checkout -q -B "portal-$v" "$sha"
+  while IFS= read -r patch; do
+    git -C "$dest" am --quiet "$patch" || die "does not apply: $patch"
+  done < <(group_patches "$dir")
+  echo "ready: $dest (branch portal-$v, base ${sha:0:8})"
+}
+
+case "${1:-}" in
+  list|'') list_series ;;
+  -h|--help|help) sed -n '2,12p' "$0" ;;
+  *)
+    v=$1; cmd=${2:-verify}
+    case "$cmd" in
+      verify) verify "$v" ;;
+      apply)  apply_series "$v" "${3:-}" ;;
+      *) die "unknown command: $cmd (verify|apply)" ;;
+    esac
+    ;;
+esac
diff --git a/build.sh b/build.sh
new file mode 100755
index 0000000000000000000000000000000000000000..65da1832f651aca175e0100e582fb9e1b9e1542f
--- /dev/null
+++ b/build.sh
@@ -0,0 +1,86 @@
+#!/bin/bash
+# Portal build driver. One place for the environment; nothing lands in $HOME.
+#
+#   ./build.sh get        flutter pub get
+#   ./build.sh macos      macOS .app (host: macOS + Xcode)
+#   ./build.sh apk        Android .apk (host: any OS with SDK+NDK)
+#   ./build.sh linux      Linux bundle (host: Linux only)
+#   ./build.sh windows    Windows bundle (host: Windows only)
+#   ./build.sh ios        iOS — not available, see below
+#   ./build.sh run-macos  open the built .app
+#
+# Toolchain used on Mark's Mac: Flutter in /opt/homebrew/opt/flutter, JDK 17 keg-only,
+# Xcode via DEVELOPER_DIR, Rust toolchain 1.99.0 pinned by plugins/rust_api/rust/rust-toolchain.toml.
+# China mirrors: pub/flutter engine (flutter-io.cn), rustup (USTC), crates.io (USTC via ~/.cargo/config.toml).
+set -euo pipefail
+
+REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd "$REPO"
+
+export JAVA_HOME="${JAVA_HOME:-/opt/homebrew/opt/openjdk@17}"
+export ANDROID_HOME="${ANDROID_HOME:-/opt/homebrew/share/android-commandlinetools}"
+export ANDROID_SDK_ROOT="$ANDROID_HOME"
+export ANDROID_USER_HOME="${ANDROID_USER_HOME:-$HOME/.work/.android}"
+export GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.work/.gradle}"
+export PUB_CACHE="${PUB_CACHE:-$HOME/.work/.pub-cache}"
+# Do NOT point PUB_HOSTED_URL at pub.flutter-io.cn: a different hosted URL invalidates
+# pubspec.lock and re-resolves packages upward (material_ui 1.5.0 -> 1.11.0 breaks the
+# build with "MaterialShapes is imported from both"). pub.dev answers from here; only the
+# Flutter engine artifacts need the mirror.
+export FLUTTER_STORAGE_BASE_URL="${FLUTTER_STORAGE_BASE_URL:-https://storage.flutter-io.cn}"
+export RUSTUP_DIST_SERVER="${RUSTUP_DIST_SERVER:-https://mirrors.ustc.edu.cn/rust-static}"
+export RUSTUP_UPDATE_ROOT="${RUSTUP_UPDATE_ROOT:-https://mirrors.ustc.edu.cn/rust-static/rustup}"
+export DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}"
+# ~/.work/toolchain/bin first: create-dmg shim maps the npm --dmg-title onto --volname
+export PATH="$HOME/.work/toolchain/bin:/opt/homebrew/opt/flutter/bin:/opt/homebrew/bin:$HOME/.cargo/bin:$PATH"
+
+mkdir -p "$ANDROID_USER_HOME" "$GRADLE_USER_HOME" "$PUB_CACHE"
+
+host_guard() {
+  # Flutter desktop builds are host-native: no cross-compiling for linux/windows.
+  local want="$1" os
+  os=$(uname -s)
+  case "$want:$os" in
+    linux:Linux|windows:*MINGW*|windows:*MSYS*|windows:CYGWIN*) ;;
+    linux:*)   echo "error: Linux bundles must be built on Linux (Flutter has no cross-compile). Use CI." >&2; exit 1 ;;
+    windows:*) echo "error: Windows bundles must be built on Windows. Use CI." >&2; exit 1 ;;
+  esac
+}
+
+# The child process is not stored in the repository: 33 MB of binary per ABI would bloat
+# every diff. It is fetched once into jniLibs, where nothing but the app build reads it.
+ensure_xray_android() {
+  local dest="android/app/src/main/jniLibs/arm64-v8a/libxray.so"
+  if [ -f "$dest" ]; then return 0; fi
+  local work
+  work=$(mktemp -d "${TMPDIR:-/tmp}/xray-fetch.XXXXXX")
+  echo "fetching Xray 26.11.9 for android/arm64"
+  curl -fL --retry 2 -o "$work/x.zip" \
+    https://github.com/XTLS/Xray-core/releases/download/v26.11.9/Xray-android-arm64-v8a.zip || return 1
+  mkdir -p "$work/out" "$(dirname "$dest")"
+  unzip -q -o "$work/x.zip" -d "$work/out" || return 1
+  cp -f "$work/out/xray" "$dest" && chmod 755 "$dest"
+}
+
+case "${1:-get}" in
+  get)        flutter --version; flutter pub get ;;
+  macos)      APP_ENV=stable; dart setup.dart macos --env "$APP_ENV"
+              ls -lh build/macos/Build/Products/Release/*.dmg 2>/dev/null || true ;;
+  apk)        ensure_xray_android || exit 1
+              dart setup.dart android --env stable
+              ls -lh build/app/outputs/flutter-apk/*.apk 2>/dev/null || true ;;
+  linux)      host_guard linux;   dart setup.dart linux --env stable ;;
+  windows)    host_guard windows; dart setup.dart windows --env stable ;;
+  ios)        cat >&2 <<'EOF'
+error: this tree has no ios/ target — FlClashX ships android/macos/linux/windows only.
+
+To enable iOS:
+  1. flutter create --platforms=ios .
+  2. verify every plugin has an iOS implementation (rust_api helper and the gomobile core are the risk)
+  3. build on macOS:  flutter build ios --release   (needs an Apple Developer account for signing)
+Unsigned builds do not install on non-jailbroken devices; TestFlight is the realistic distribution.
+EOF
+              exit 1 ;;
+  run-macos)  APP=$(ls -d build/macos/Build/Products/Release/*.app | head -1); open "$APP" ;;
+  *) echo "usage: $0 {get|macos|apk|linux|windows|ios|run-macos}" >&2; exit 2 ;;
+esac
diff --git a/docs/DPI.md b/docs/DPI.md
new file mode 100644
index 0000000000000000000000000000000000000000..4f8efcba64bcd901f83d0df54bd5ac8a440f9785
--- /dev/null
+++ b/docs/DPI.md
@@ -0,0 +1,90 @@
+# DPI evasion: design and platform matrix
+
+Portal client must work in two hostile networks at once: Russia (TSPU) and China (GFW).
+Both filter TLS by SNI/ClientHello, so three independent mechanisms are in scope, and they
+must not be confused with each other.
+
+Status: design. Facts marked **[verified]** were checked against the repos/releases listed at
+the end; everything marked **[check]** must be confirmed before it ships.
+
+## 1. Three layers, three different mechanics
+
+| Layer | What it does | Where it sits | Privileges |
+|---|---|---|---|
+| `finalmask` (in Prizrak-Core) | fragments / reshapes the TLS ClientHello (tlshello fragment, `xmc`, `sudoku`, `noise`, `udhop`, `quicParams`) | inside the core, all platforms | none |
+| ByeDPI (`hufrea/byedpi`) | userspace SOCKS proxy that opens the connection to the node itself with desync / OOB / fake-TLS strategies | local `socks5` outbound, chained through `dialer-proxy` | none for most strategies |
+| zapret (`bol-van/zapret`) | packet-level mangling of outgoing TCP/UDP (nfqws on nftables, winws on WinDivert) | transparent, no proxy; kernel/packet filter | root / administrator |
+
+Consequence: ByeDPI is applied **to the node connection**, not to the payload inside the tunnel.
+The core therefore needs `dialer-proxy` on the proxies (or on a group), pointing at the local
+ByeDPI SOCKS. zapret needs nothing in the config — it mangles the packets the core sends anyway.
+
+## 2. Platform matrix
+
+| Platform | finalmask | ByeDPI | zapret | Notes |
+|---|---|---|---|---|
+| Android | yes | yes — `libbyedpi.so`, no root | only with root (Magisk) | ship ByeDPI by default, hide zapret unless root detected |
+| Windows | yes | yes — releases `x86_64-w64`, `i686-w64` **[verified]** | yes — `winws` + WinDivert, needs admin | two options; see §4 |
+| Linux | yes | yes — `x86_64`, `aarch64`, `armv7`, `mips` **[verified]** | yes — `nfqws`, root | router and desktop share the same binaries |
+| macOS | yes | **no release binary** **[verified]** — build from source, C, `[check]` privileges per strategy | **not supported upstream** **[verified]** — `[check]` whether a maintained pf/divert fork exists | only finalmask + ByeDPI-from-source |
+| OpenWrt / Merlin (routers) | yes (core) | yes | yes — `openwrt-embedded` tarball **[verified]** | zapret is the natural router choice |
+| iOS | yes | no (no raw sockets, no background process) | no | finalmask only |
+
+`zapret` upstream releases ship `zapret-*.tar.gz`, `zapret-*.zip` and a separate
+`openwrt-embedded` archive; there is no macOS asset **[verified]**.
+
+## 3. What the app must own
+
+```
+DPI Engine (one service per platform)
+├─ detect capabilities: root/admin?, engine binaries present?, core supports finalmask?
+├─ start/stop engine, health-check by port (ByeDPI) or process (zapret)
+├─ inject into the core config:
+│    ByeDPI  -> proxies: [{name: "dpi-<strategy>", type: socks5, server: 127.0.0.1, port: N}]
+│                and dialer-proxy: "dpi-<strategy>" on the selected proxies/group
+│    zapret   -> nothing (transparent), only report status
+└─ publish state upward: OFF / STARTING / RUNNING(strategy) / FAILED(reason)
+```
+
+Strategies are **data, not code**: `assets/dpi/strategies/*.json` (one entry per preset with
+engine, argv, port, target platforms, notes). Presets RU and CN ship in the repo; users can add
+their own the way zapret users already share lists.
+
+UI: one switch "Обход DPI" + strategy list; the switch reads its state from the running engine,
+never from a saved flag. If the engine is not available for the platform, the switch is hidden
+rather than shown as broken.
+
+## 4. Windows: two engines, different trade-offs
+
+- `zapret/winws` — best coverage, needs administrator once per session (UAC), no proxy chaining.
+- ByeDPI `x86_64-w64` — no admin, but only covers connections that go through its SOCKS, so the
+  core must be pointed at it with `dialer-proxy`.
+
+Both should be offered: zapret as "рекомендуется", ByeDPI as "без прав администратора".
+
+## 5. macOS caveat
+
+There is no upstream zapret for macOS, and ByeDPI ships no darwin binary. So on macOS the honest
+default is `finalmask`; ByeDPI has to be compiled in CI and its strategies verified one by one.
+**[check]** Whether desync strategies rely on raw sockets that need root on Darwin.
+
+## 6. Interaction with the panel config
+
+The panel profile already contains groups and rules. DPI must not rewrite them: it only adds
+proxies and `dialer-proxy` fields. The injection layer must therefore be a structured YAML edit
+(parse → modify → serialize), not the string surgery used by the old Android client.
+
+## 7. Open questions
+
+1. Which ByeDPI strategies actually pass TSPU today, and which pass GFW today? Needs a measured
+   matrix per region, not a list from a blog.
+2. Does Prizrak-Core's `finalmask` cover the same cases as `--split-pos`/`--oob` desync, or only
+   fragmentation? Needs a test against the same hosts.
+3. zapret on Android: root-only means we need a clear "почему недоступно" explanation, not a
+   silent absence.
+
+## Sources checked
+
+- `hufrea/byedpi` releases v0.17.3 — asset list (linux + windows, no darwin) **[verified]**
+- `bol-van/zapret` releases v72.13 — `tar.gz`, `zip`, `openwrt-embedded`; no macOS **[verified]**
+- Prizrak-Core `README` / outbound list for finalmask family **[verified]**
