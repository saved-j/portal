diff --git a/pipeline/0.01a/patches/0014-m3-mode-and-servers.patch b/pipeline/0.01a/patches/0014-m3-mode-and-servers.patch
new file mode 100644
index 0000000000000000000000000000000000000000..83197a1e609acf95afda119f97ec310d55b4c4c2
--- /dev/null
+++ b/pipeline/0.01a/patches/0014-m3-mode-and-servers.patch
@@ -0,0 +1,143 @@
+From 843c3452247cfea7c0313bbc946561dd58488e58 Mon Sep 17 00:00:00 2001
+From: Elara <elara@portal.local>
+Date: Sun, 15 Nov 2026 01:32:48 +0800
+Subject: [PATCH] ui: Material 3 mode switch and server list on the working
+ screen
+
+The mode control is a SegmentedButton over the two modes the product has, and the
+servers render as ListTile rows: name left, delay right, selected row tinted. Both
+are Material components, so the screen keeps the platform's behaviour (ripples,
+semantics, density) instead of a hand-drawn approximation.
+---
+ lib/views/dashboard/hero.dart            |  5 ++
+ lib/views/dashboard/portal_controls.dart | 95 ++++++++++++++++++++++++
+ 2 files changed, 100 insertions(+)
+ create mode 100644 lib/views/dashboard/portal_controls.dart
+
+diff --git a/lib/views/dashboard/hero.dart b/lib/views/dashboard/hero.dart
+index 04019ef8..69a85b3a 100644
+--- a/lib/views/dashboard/hero.dart
++++ b/lib/views/dashboard/hero.dart
+@@ -11,6 +11,7 @@ import 'package:fl_clash/providers/providers.dart';
+ import 'package:fl_clash/ui/icons/icons.dart';
+ import 'package:fl_clash/views/profiles/add.dart';
+ import 'package:fl_clash/widgets/widgets.dart';
++import 'portal_controls.dart';
+ import 'portal_gateway.dart';
+ import 'package:flutter_riverpod/flutter_riverpod.dart';
+ import 'package:flutter_svg/flutter_svg.dart';
+@@ -140,6 +141,10 @@ class _HeroDashboardState extends ConsumerState<HeroDashboard> {
+                     const AnnouncementCard(),
+                     if (ref.watch(announcementProvider) != null)
+                       const SizedBox(height: _gap),
++                    const PortalModeSwitch(),
++                    const SizedBox(height: 8),
++                    const PortalServerList(),
++                    const SizedBox(height: _gap),
+                     _ServerPanel(group: headers.serverGroup),
+                     const SizedBox(height: _gap),
+                     const ProfilesCard(),
+diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
+new file mode 100644
+index 00000000..604e34a3
+--- /dev/null
++++ b/lib/views/dashboard/portal_controls.dart
+@@ -0,0 +1,95 @@
++import 'package:fl_clash/common/common.dart';
++import 'package:fl_clash/enum/enum.dart';
++import 'package:fl_clash/providers/providers.dart';
++import 'package:fl_clash/ui/icons/icons.dart';
++import 'package:flutter_riverpod/flutter_riverpod.dart';
++import 'package:material_ui/material_ui.dart';
++
++/// Material 3 mode switch: the two modes Portal Connect actually has, with the
++/// engine's own names kept out of the UI.
++class PortalModeSwitch extends ConsumerWidget {
++  const PortalModeSwitch({super.key});
++
++  @override
++  Widget build(BuildContext context, WidgetRef ref) {
++    final mode = ref.watch(
++      patchClashConfigProvider.select((state) => state.mode),
++    );
++    final modes = ref.watch(availableModesProvider);
++    if (modes.length < 2) return const SizedBox.shrink();
++    return SegmentedButton<Mode>(
++      segments: [
++        for (final item in modes)
++          ButtonSegment<Mode>(
++            value: item,
++            label: Text(item.label),
++          ),
++      ],
++      selected: {mode},
++      showSelectedIcon: false,
++      onSelectionChanged: (selection) {
++        final next = selection.firstOrNull;
++        if (next == null || next == mode) return;
++        ref.read(setupActionProvider.notifier).pickMode(next);
++      },
++    );
++  }
++}
++
++/// The working screen's server list: name on the left, delay on the right, one
++/// tap to make it the outbound of the group in charge.
++class PortalServerList extends ConsumerWidget {
++  const PortalServerList({super.key});
++
++  @override
++  Widget build(BuildContext context, WidgetRef ref) {
++    final groups = ref.watch(currentGroupsStateProvider).value;
++    final group = groups.firstOrNull;
++    if (group == null) {
++      return Padding(
++        padding: const EdgeInsets.all(16),
++        child: Text(
++          context.appLocalizations.proxyGroupEmpty,
++          style: Theme.of(context).textTheme.bodyMedium?.copyWith(
++            color: Theme.of(context).colorScheme.onSurfaceVariant,
++          ),
++        ),
++      );
++    }
++    final members = group.all;
++    return ListView.builder(
++      shrinkWrap: true,
++      physics: const NeverScrollableScrollPhysics(),
++      itemCount: members.length,
++      itemBuilder: (context, index) {
++        final proxy = members[index];
++        final selected = group.now == proxy.name;
++        final delay = ref.watch(delayProvider(proxyName: proxy.name));
++        return ListTile(
++          dense: true,
++          selected: selected,
++          leading: GlyphIcon(
++            AppGlyphs.proxies,
++            size: 20,
++            color: selected
++                ? Theme.of(context).colorScheme.primary
++                : Theme.of(context).colorScheme.onSurfaceVariant,
++          ),
++          title: Text(proxy.name, maxLines: 1, overflow: TextOverflow.ellipsis),
++          trailing: Text(
++            delay == null ? '—' : '$delay ms',
++            style: Theme.of(context).textTheme.labelMedium?.copyWith(
++              color: selected
++                  ? Theme.of(context).colorScheme.primary
++                  : Theme.of(context).colorScheme.onSurfaceVariant,
++            ),
++          ),
++          onTap: () => ref.read(proxiesActionProvider.notifier).changeProxy(
++            groupName: group.name,
++            proxyName: proxy.name,
++          ),
++        );
++      },
++    );
++  }
++}
+-- 
+2.54.0 (Apple Git-157)
+
