+  /// Starts the child the saved mode needs, once, after the tun is up.
+  ///
+  /// In the simple portal the engine is only a pipe: its config carries XRAY-SOCKS and its
+  /// global selector points at it, so a start that brings mihomo up and stops there leaves
+  /// everything going into a local port nothing listens on. This is the other half of that
+  /// start, and it is deliberately idempotent: a child already up is left alone, and two
+  /// starts cannot overlap.
+  Future<void> _startSavedPortalChild() async {
+    if (_startingChild) {
+      return;
+    }
+    _startingChild = true;
+    try {
+      if (ref.read(patchClashConfigProvider.select((state) => state.mode)) !=
+          Mode.global) {
+        return;
+      }
+      // Already up: the child outlived an engine restart, or a switch started it.
+      if (XrayCore.instance.running) {
+        return;
+      }
+      if ((await XrayCore.instance.status())['running'] == true) {
+        return;
+      }
+      final profile = ref.read(currentProfileProvider);
+      if (profile == null) {
+        return;
+      }
+      final body = await profile.readXrayFormat();
+      if (body == null) {
+        return;
+      }
+      final servers = parseXraySubscription(body);
+      // The stored pick is the node the child ran last, which is the one the owner chose;
+      // an empty or stale name falls back to the panel's first server.
+      final server = xrayServerFor(
+        servers,
+        ref.read(appSettingProvider).portalSelectionXray,
+      );
+      if (server == null) {
+        return;
+      }
+      final started = await XrayCore.instance.start(
+        withSocksInbound(jsonEncode(server.config)),
+      );
+      if (started['ok'] != true) {
+        commonPrint.log(
+          'portal child did not start on ${server.name}: '
+          '${XrayCore.instance.lastLine}',
+          logLevel: LogLevel.warning,
+        );
+        return;
+      }
+      commonPrint.log('portal child started on ${server.name}');
+      // The config already declares the road to the child; the engine's global selector is
+      // the one thing that has to be pointed at it, exactly as the switch does.
+      await ref
+          .read(proxiesActionProvider.notifier)
+          .changeProxy(groupName: 'GLOBAL', proxyName: 'XRAY-SOCKS');
+    } catch (error) {
+      commonPrint.log(
+        'portal child start failed: ${compactError(error)}',
+        logLevel: LogLevel.warning,
+      );
+    } finally {
+      _startingChild = false;
+    }
+  }
+
