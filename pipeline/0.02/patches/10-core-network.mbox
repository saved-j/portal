diff --git a/lib/core/xray_bridge_config.dart b/lib/core/xray_bridge_config.dart
new file mode 100644
index 0000000000000000000000000000000000000000..78a42fed408695af95eee1512c125cd093bcabeb
--- /dev/null
+++ b/lib/core/xray_bridge_config.dart
@@ -0,0 +1,84 @@
+/// Wraps the engine's own configuration so that all traffic leaves through Xray.
+///
+/// The app keeps mihomo for TUN, DNS and the rule engine. When the owner turns the
+/// "Сеть порталов" switch off, the simple mode must not route through the subscription's
+/// own outbounds — it must hand everything to a local Xray that owns the real node.
+///
+/// That is done by adding one socks5 proxy pointing at 127.0.0.1 and forcing global mode.
+/// This file is the whole of that decision, so it can be tested without a tunnel.
+library;
+
+const xrayBridgeTag = 'portal-xray';
+const xrayBridgeGroup = 'PORTAL-XRAY';
+const xrayDefaultPort = 10808;
+
+/// Returns a copy of [config] in which every connection goes to the local Xray.
+///
+/// The original map is not modified: switching back must be possible by simply dropping
+/// the returned copy.
+Map<String, dynamic> withXrayBridge(
+  Map<String, dynamic> config, {
+  int port = xrayDefaultPort,
+}) {
+  final out = <String, dynamic>{...config};
+
+  final proxies = <dynamic>[
+    ...?(config['proxies'] as List?)?.where(
+      (p) => p is Map && p['name'] != xrayBridgeTag,
+    ),
+    {
+      'name': xrayBridgeTag,
+      'type': 'socks5',
+      'server': '127.0.0.1',
+      'port': port,
+      'udp': false,
+      'skip-cert-verify': true,
+    },
+  ];
+  out['proxies'] = proxies;
+
+  final groups = <dynamic>[
+    ...?(config['proxy-groups'] as List?)?.where(
+      (g) => g is Map && g['name'] != xrayBridgeGroup,
+    ),
+    {
+      'name': xrayBridgeGroup,
+      'type': 'select',
+      'proxies': [xrayBridgeTag],
+    },
+  ];
+  out['proxy-groups'] = groups;
+
+  // Global mode plus this one group is what makes the engine a plain pipe: no rules of
+  // its own, nothing selected by delay, everything into Xray.
+  out['mode'] = 'global';
+  out['GLOBAL'] = xrayBridgeGroup;
+
+  return out;
+}
+
+/// True when [config] already carries the bridge, so a second switch-off cannot stack
+/// a second socks proxy or a second group on top of the first.
+bool hasXrayBridge(Map<String, dynamic> config) {
+  final proxies = (config['proxies'] as List?) ?? const [];
+  return proxies.any((p) => p is Map && p['name'] == xrayBridgeTag);
+}
+
+/// Removes the bridge and restores the mode the config had before it was wrapped.
+Map<String, dynamic> withoutXrayBridge(
+  Map<String, dynamic> config, {
+  String restoreMode = 'rule',
+}) {
+  final out = <String, dynamic>{...config};
+  out['proxies'] = ((config['proxies'] as List?) ?? const [])
+      .where((p) => !(p is Map && p['name'] == xrayBridgeTag))
+      .toList();
+  out['proxy-groups'] = ((config['proxy-groups'] as List?) ?? const [])
+      .where((g) => !(g is Map && g['name'] == xrayBridgeGroup))
+      .toList();
+  if (out['GLOBAL'] == xrayBridgeGroup) {
+    out.remove('GLOBAL');
+  }
+  out['mode'] = restoreMode;
+  return out;
+}
diff --git a/lib/core/xray_config.dart b/lib/core/xray_config.dart
new file mode 100644
index 0000000000000000000000000000000000000000..aeb8679e2eca1a9bb893b1cf45ec2345922fb7ab
--- /dev/null
+++ b/lib/core/xray_config.dart
@@ -0,0 +1,179 @@
+/// Turns one Clash/Mihomo proxy entry into an Xray configuration.
+///
+/// The app speaks Clash YAML: a subscription is a list of proxies with a `type` and a few
+/// protocol fields. Xray speaks its own JSON. This file is the only place that knows both,
+/// so the whole X-Ray path can be tested without a phone, a tunnel or a panel.
+library;
+
+import 'dart:convert';
+
+/// A single outbound in Xray's JSON shape, plus the socks inbound the app uses.
+Map<String, dynamic> xrayConfigFor(
+  Map<String, dynamic> proxy, {
+  int socksPort = 10808,
+  String logLevel = 'warning',
+}) {
+  final type = (proxy['type'] as String? ?? '').toLowerCase();
+  final outbound = switch (type) {
+    'vless' => _vless(proxy),
+    'vmess' => _vmess(proxy),
+    'trojan' => _trojan(proxy),
+    _ => throw UnsupportedProxyType(type),
+  };
+  return {
+    'log': {'loglevel': logLevel},
+    'inbounds': [
+      {
+        'tag': 'socks-in',
+        'listen': '127.0.0.1',
+        'port': socksPort,
+        'protocol': 'socks',
+        'settings': {'udp': false},
+      },
+    ],
+    'outbounds': [
+      outbound,
+      {'tag': 'blocked', 'protocol': 'blackhole'},
+    ],
+  };
+}
+
+class UnsupportedProxyType implements Exception {
+  const UnsupportedProxyType(this.type);
+  final String type;
+
+  @override
+  String toString() => 'UnsupportedProxyType($type)';
+}
+
+Map<String, dynamic> _vless(Map<String, dynamic> proxy) {
+  final settings = <String, dynamic>{
+    'vnext': [
+      {
+        'address': proxy['server'],
+        'port': _port(proxy),
+        'users': [
+          {
+            'id': proxy['uuid'],
+            'encryption': (proxy['encryption'] as String?) ?? 'none',
+            if (proxy['flow'] != null) 'flow': proxy['flow'],
+          },
+        ],
+      },
+    ],
+  };
+
+  final stream = _stream(proxy);
+  return {
+    'tag': 'proxy',
+    'protocol': 'vless',
+    'settings': settings,
+    'streamSettings': stream,
+  };
+}
+
+Map<String, dynamic> _vmess(Map<String, dynamic> proxy) {
+  return {
+    'tag': 'proxy',
+    'protocol': 'vmess',
+    'settings': {
+      'vnext': [
+        {
+          'address': proxy['server'],
+          'port': _port(proxy),
+          'users': [
+            {
+              'id': proxy['uuid'],
+              'alterId': proxy['alterId'] ?? 0,
+              'security': (proxy['cipher'] as String?) ?? 'auto',
+            },
+          ],
+        },
+      ],
+    },
+    'streamSettings': _stream(proxy),
+  };
+}
+
+Map<String, dynamic> _trojan(Map<String, dynamic> proxy) {
+  return {
+    'tag': 'proxy',
+    'protocol': 'trojan',
+    'settings': {
+      'servers': [
+        {
+          'address': proxy['server'],
+          'port': _port(proxy),
+          'password': proxy['password'],
+        },
+      ],
+    },
+    'streamSettings': _stream(proxy),
+  };
+}
+
+int _port(Map<String, dynamic> proxy) {
+  final raw = proxy['port'];
+  if (raw is int) return raw;
+  final parsed = int.tryParse('$raw');
+  if (parsed == null) throw const FormatException('proxy has no usable port');
+  return parsed;
+}
+
+/// Transport, TLS and REALITY. Clash keeps these flat on the proxy entry and Xray wants
+/// them nested, which is the whole reason this conversion cannot be a rename.
+Map<String, dynamic> _stream(Map<String, dynamic> proxy) {
+  final network = (proxy['network'] as String?) ?? 'tcp';
+  final stream = <String, dynamic>{'network': network};
+
+  switch (network) {
+    case 'ws':
+      stream['wsSettings'] = {
+        'path': proxy['ws-path'] ?? proxy['wsPath'] ?? '/',
+        if (proxy['ws-headers'] != null || proxy['wsHeaders'] != null)
+          'headers': proxy['ws-headers'] ?? proxy['wsHeaders'],
+      };
+      break;
+    case 'grpc':
+      stream['grpcSettings'] = {
+        'serviceName': proxy['grpc-service-name'] ?? proxy['grpcServiceName'] ?? '',
+        if (proxy['grpc-mode'] != null) 'multiMode': proxy['grpc-mode'] == 'multi',
+      };
+      break;
+    case 'h2':
+      stream['httpSettings'] = {
+        'path': proxy['h2-path'] ?? proxy['h2Path'] ?? '/',
+        'host': [proxy['h2-host'] ?? proxy['h2Host'] ?? proxy['server']],
+      };
+      break;
+  }
+
+  final reality = proxy['reality-opts'] ?? proxy['realityOpts'];
+  final tls = proxy['tls'];
+  if (reality is Map) {
+    stream['security'] = 'reality';
+    stream['realitySettings'] = {
+      'serverName': reality['server-name'] ?? reality['serverName'] ?? proxy['servername'],
+      'fingerprint': proxy['client-fingerprint'] ?? 'chrome',
+      'publicKey': reality['public-key'] ?? reality['publicKey'],
+      'shortId': reality['short-id'] ?? reality['shortId'] ?? '',
+    };
+  } else if (tls == true) {
+    stream['security'] = 'tls';
+    stream['tlsSettings'] = {
+      'serverName': proxy['servername'] ?? proxy['sni'] ?? proxy['server'],
+      'allowInsecure': proxy['skip-cert-verify'] ?? false,
+      if (proxy['alpn'] != null) 'alpn': proxy['alpn'],
+      if (proxy['client-fingerprint'] != null)
+        'fingerprint': proxy['client-fingerprint'],
+    };
+  }
+
+  return stream;
+}
+
+/// JSON text, ready to be written next to the binary.
+String xrayConfigJson(Map<String, dynamic> proxy, {int socksPort = 10808}) =>
+    const JsonEncoder.withIndent('  ').convert(
+      xrayConfigFor(proxy, socksPort: socksPort),
+    );
diff --git a/lib/plugins/xray.dart b/lib/plugins/xray.dart
new file mode 100644
index 0000000000000000000000000000000000000000..293e8e3d2a9b5feac1be447bbf4bab8b95232141
--- /dev/null
+++ b/lib/plugins/xray.dart
@@ -0,0 +1,70 @@
+import 'dart:async';
+
+import 'package:flutter/services.dart';
+
+import '../common/constant.dart';
+
+/// The Xray child process, driven from Dart.
+///
+/// The engine keeps the tunnel; Xray owns the real node and is reached through the socks
+/// outbound the configs already declare. Nothing here decides policy — it starts, reports,
+/// and stops, so the switch stays a mode change rather than a rebuild.
+class XrayCore {
+  XrayCore._();
+
+  static final XrayCore instance = XrayCore._();
+
+  static const _channel = MethodChannel('$packageName/xray');
+
+  /// Last line the child printed, kept so a failure can be shown as it happened.
+  String lastLine = '';
+  bool running = false;
+
+  Future<Map<String, dynamic>> start(
+    String config, {
+    int port = 10808,
+  }) async {
+    try {
+      final result = await _channel.invokeMethod<Map<dynamic, dynamic>>('start', {
+        'config': config,
+        'port': port,
+      });
+      final map = result?.cast<String, dynamic>() ?? const <String, dynamic>{};
+      running = map['ok'] == true;
+      lastLine = (map['message'] as String?) ?? lastLine;
+      return map;
+    } on PlatformException catch (error) {
+      lastLine = error.message ?? '$error';
+      return {'ok': false, 'message': lastLine};
+    } on MissingPluginException {
+      // Desktop builds have no such channel yet; the portal stays on the engine alone.
+      lastLine = 'xray is not available in this build';
+      return {'ok': false, 'message': lastLine};
+    }
+  }
+
+  Future<void> stop() async {
+    try {
+      await _channel.invokeMethod('stop');
+    } on PlatformException catch (error) {
+      lastLine = error.message ?? '$error';
+    } on MissingPluginException {
+      // Nothing to stop.
+    }
+    running = false;
+  }
+
+  Future<Map<String, dynamic>> status() async {
+    try {
+      final result = await _channel.invokeMethod<Map<dynamic, dynamic>>('status');
+      final map = result?.cast<String, dynamic>() ?? const <String, dynamic>{};
+      running = map['running'] == true;
+      lastLine = (map['lastLine'] as String?) ?? lastLine;
+      return map;
+    } on PlatformException {
+      return const {};
+    } on MissingPluginException {
+      return const {};
+    }
+  }
+}
