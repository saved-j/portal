From 989d96b5897e6c13fc4f9676193b465eb07a6941 Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 04:34:53 +0800
Subject: [PATCH] ui: one switch for the mode, five chip layouts that survive
 it
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

'Сеть порталов' is a label and a Switch now — the pair of segments made both modes look
equal, and the other one no longer has a name on screen. Chip layout lives in a provider
(default name+server+icon) so switching the mode no longer resets it, and the fifth layout
is cycling through name, name+server, name+server+icon, icon+server, icon.
---
 lib/views/dashboard/portal_controls.dart | 146 ++++++++---------------
 1 file changed, 53 insertions(+), 93 deletions(-)

diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 2e09bed6..1bd9baa0 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -95,6 +95,18 @@ final portalBypassProvider =
     NotifierProvider<PortalBypassNotifier, Map<String, String?>>(
         PortalBypassNotifier.new);
 
+/// How the filter chips are drawn. Default 2 is 'name + server + icon'. Lives in a
+/// provider so switching the mode does not reset the user's choice.
+class PortalDisplayNotifier extends Notifier<int> {
+  @override
+  int build() => 2;
+
+  void cycle() => state = (state + 1) % 5;
+}
+
+final portalDisplayProvider =
+    NotifierProvider<PortalDisplayNotifier, int>(PortalDisplayNotifier.new);
+
 class PortalFiltersNotifier extends Notifier<({Set<String> hidden, List<String> order})> {
   @override
   ({Set<String> hidden, List<String> order}) build() =>
@@ -175,39 +187,39 @@ class PortalModeSwitch extends ConsumerWidget {
     if (modes.length < 2) return const SizedBox.shrink();
     return Row(
       children: [
-        Expanded(
+        // One word and one switch: 'Сеть порталов' on means rules, off means the
+        // single-portal mode. A two-segment control made the pair look equal.
+        GestureDetector(
+          onDoubleTap: () => showPortalFilterEditor(context),
+          onLongPress: () => Navigator.of(context).push(
+            MaterialPageRoute(builder: (_) => const ProxiesView()),
+          ),
           child: Row(
+            mainAxisSize: MainAxisSize.min,
             children: [
-              for (final item in modes)
-                Expanded(
-                  child: Padding(
-                    padding: const EdgeInsets.symmetric(horizontal: 2),
-                    child: _ModeButton(
-                      label: item.label,
-                      selected: item == mode,
-                      // The network mode carries the hidden tricks: a double tap
-                      // opens the filter editor, a long press the proxies dashboard.
-                      onDoubleTap: item == Mode.rule
-                          ? () => showPortalFilterEditor(context)
-                          : null,
-                      onLongPress: item == Mode.rule
-                          ? () => Navigator.of(context).push(
-                                MaterialPageRoute(
-                                  builder: (_) => const ProxiesView(),
-                                ),
-                              )
-                          : null,
-                      onTap: () {
-                        if (item == mode) return;
-                        HapticFeedback.selectionClick();
-                        ref.read(setupActionProvider.notifier).pickMode(item);
-                      },
-                    ),
-                  ),
+              Text(
+                context.appLocalizations.rules,
+                style: theme.textTheme.labelLarge?.copyWith(
+                  color: mode == Mode.rule
+                      ? theme.colorScheme.primary
+                      : theme.colorScheme.onSurfaceVariant,
+                  fontWeight: mode == Mode.rule ? FontWeight.w600 : null,
                 ),
+              ),
+              const SizedBox(width: 6),
+              Switch(
+                value: mode == Mode.rule,
+                onChanged: (value) {
+                  HapticFeedback.selectionClick();
+                  ref
+                      .read(setupActionProvider.notifier)
+                      .pickMode(value ? Mode.rule : Mode.global);
+                },
+              ),
             ],
           ),
         ),
+        const Spacer(),
         const SizedBox(width: 4),
         IconButton(
           tooltip: sort == PortalSort.ping ? 'Сортировка: пинг' : 'Сортировка: A-Z',
@@ -341,9 +353,7 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
   final _controller = ScrollController();
   var _canBack = false;
   var _canForward = false;
-  /// 0 — название, 1 — название и сервер, 2 — иконка и сервер, 3 — только иконка.
-  /// A selector is named by its own name ('Auto'), never by the node it happens to use.
-  var _display = 0;
+
 
   @override
   void initState() {
@@ -378,6 +388,7 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
     final allGroups = ref.watch(groupsProvider);
     final filters = ref.watch(portalFiltersProvider);
     final groups = portalVisibleGroups(allGroups, filters.hidden, filters.order);
+    final display = ref.watch(portalDisplayProvider);
     final active = ref.watch(portalGroupProvider) ?? groups.firstOrNull?.name;
     final bypassedNames = ref.watch(portalBypassProvider).keys.toSet();
     final hint = theme.colorScheme.onSurfaceVariant.withValues(alpha: 0.7);
@@ -391,7 +402,7 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
         ),
         Expanded(
           child: GestureDetector(
-            onDoubleTap: () => setState(() => _display = (_display + 1) % 4),
+            onDoubleTap: () => ref.read(portalDisplayProvider.notifier).cycle(),
             child: NotificationListener<ScrollMetricsNotification>(
               onNotification: (_) {
                 _syncEdges();
@@ -425,9 +436,12 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
                           // icon+server, icon. Everything centres by construction.
                           label: Builder(
                             builder: (context) {
-                              final showIcon = _display >= 2;
-                              final showName = _display <= 1;
-                              final showServer = _display == 1 || _display == 2;
+                              // 0 name · 1 name+server · 2 name+server+icon ·
+                              // 3 icon+server · 4 icon
+                              final showIcon = display >= 2;
+                              final showName = display <= 2;
+                              final showServer =
+                                  display == 1 || display == 2 || display == 3;
                               final mark = SizedBox.square(
                                 dimension: 16,
                                 child: CommonTargetIcon(
@@ -435,12 +449,12 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
                                   fallback: GroupMonogram(item.name),
                                 ),
                               );
-                              // The engine's own answer, not the resolved chain: when a
-                              // selector points at another selector the chip says 'Auto'.
                               final server = item.now;
                               final text = [
                                 if (showName) item.name,
-                                if (showServer && server != null && server != item.name)
+                                if (showServer &&
+                                    server != null &&
+                                    server != item.name)
                                   server,
                               ].join(' · ');
                               if (!showIcon) {
@@ -451,9 +465,9 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
                                 mainAxisSize: MainAxisSize.min,
                                 mainAxisAlignment: MainAxisAlignment.center,
                                 children: [
-                                  mark,
-                                  const SizedBox(width: 6),
                                   Text(text),
+                                  const SizedBox(width: 6),
+                                  mark,
                                 ],
                               );
                             },
@@ -736,60 +750,6 @@ class PortalPlanCard extends ConsumerWidget {
 }
 
 
