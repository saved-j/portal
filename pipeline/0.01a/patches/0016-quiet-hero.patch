From f88a1979355d6bb17da1e58134740499d130adf7 Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 01:40:25 +0800
Subject: [PATCH] ui: the working screen introduces nothing and shows only the
 portal

The hero screen drops the page title bar, the mode toggle and the developer core
reset button: on a screen whose only job is opening a portal they read as a
toolbar full of questions. The header keeps the settings button, the service name
from the subscription and the subscriptions count; no app logo and no app name,
because the product is the door, not the sign on it. Launcher label is 'Portal VPN'
so people can find it, the interface says 'portal-connect'.
---
 .../common/src/main/res/values/strings.xml    |  2 +-
 lib/views/dashboard/dashboard.dart            |  8 +++--
 lib/views/dashboard/hero.dart                 | 32 +++++++------------
 3 files changed, 18 insertions(+), 24 deletions(-)

diff --git a/android/common/src/main/res/values/strings.xml b/android/common/src/main/res/values/strings.xml
index 070c65f2..a426e866 100644
--- a/android/common/src/main/res/values/strings.xml
+++ b/android/common/src/main/res/values/strings.xml
@@ -1,5 +1,5 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
-    <string name="app_name">PortalVPN</string>
+    <string name="app_name">Portal VPN</string>
     <string name="service_channel_name">PortalVPN Service</string>
 </resources>
diff --git a/lib/views/dashboard/dashboard.dart b/lib/views/dashboard/dashboard.dart
index 469d7113..3c8ed1ce 100644
--- a/lib/views/dashboard/dashboard.dart
+++ b/lib/views/dashboard/dashboard.dart
@@ -72,10 +72,12 @@ class _DashboardViewState extends ConsumerState<DashboardView> {
     final appLocalizations = context.appLocalizations;
     return CommonScaffold(
       backgroundColor: DashboardColors.of(context).page,
+      // The hero screen carries its own header: a title bar with the page name,
+      // a mode toggle and the developer core-reset button is noise there.
       title: editing
           ? appLocalizations.editDashboard
-          : appLocalizations.dashboard,
-      actions: [if (!editing) const CoreStatusButton()],
+          : (hero ? '' : appLocalizations.dashboard),
+      actions: [if (!editing && !hero) const CoreStatusButton()],
       confirmationAction: editing
           ? IconButtonData(
               glyph: AppGlyphs.check,
@@ -84,7 +86,7 @@ class _DashboardViewState extends ConsumerState<DashboardView> {
             )
           : null,
       iconActions: [
-        if (mode != null && ref.watch(globalModeAllowedProvider))
+        if (mode != null && !hero && ref.watch(globalModeAllowedProvider))
           IconButtonData(
             glyph: mode == Mode.global ? AppGlyphs.proxies : AppGlyphs.rules,
             tooltip:
diff --git a/lib/views/dashboard/hero.dart b/lib/views/dashboard/hero.dart
index 69a85b3a..2d211461 100644
--- a/lib/views/dashboard/hero.dart
+++ b/lib/views/dashboard/hero.dart
@@ -98,28 +98,20 @@ class _HeroDashboardState extends ConsumerState<HeroDashboard> {
                             size: 22,
                           ),
                         ),
+                        // No app icon and no app name here: the screen shows the
+                        // service the subscription belongs to, not the product that
+                        // opened the door.
                         Expanded(
-                          child: Row(
-                            mainAxisAlignment: MainAxisAlignment.center,
-                            spacing: 10,
-                            children: [
-                              _ServiceLogo(
-                                url: headers.serviceLogo,
-                                size: _inlineLogoSize,
-                                radius: AppRadius.md,
-                              ),
-                              Flexible(
-                                child: EmojiText(
-                                  headers.serviceName ?? appName,
-                                  maxLines: 1,
-                                  overflow: TextOverflow.ellipsis,
-                                  style: AppTextStyle.title2.of(
-                                    context,
-                                    emphasized: true,
-                                  ),
-                                ),
+                          child: Center(
+                            child: EmojiText(
+                              headers.serviceName ?? 'portal-connect',
+                              maxLines: 1,
+                              overflow: TextOverflow.ellipsis,
+                              style: AppTextStyle.title3.of(
+                                context,
+                                emphasized: true,
                               ),
-                            ],
+                            ),
                           ),
                         ),
                         IconButton(
