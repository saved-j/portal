From b471cb92a20c7a17f6f21c9a4c51bc284a67f32b Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 04:06:29 +0800
Subject: [PATCH] ui: corner counters hide until asked for

A permanent badge on subscriptions and connections is noise on a screen about the
portal. Both badges start hidden and a double tap on the icon reveals them: the
subscription count and the live connection count.
---
 lib/views/dashboard/hero.dart            | 61 ++++++++++++++++--------
 lib/views/dashboard/portal_controls.dart | 14 ++++++
 2 files changed, 55 insertions(+), 20 deletions(-)

diff --git a/lib/views/dashboard/hero.dart b/lib/views/dashboard/hero.dart
index dfc09d95..b517779f 100644
--- a/lib/views/dashboard/hero.dart
+++ b/lib/views/dashboard/hero.dart
@@ -136,32 +136,53 @@ class _HeroDashboardState extends ConsumerState<HeroDashboard> {
                             ),
                           ),
                         ),
-                        IconButton(
-                          tooltip: context.appLocalizations.connections,
+                        GestureDetector(
+                          onDoubleTap: () => ref
+                              .read(portalConnectionsBadgeProvider.notifier)
+                              .toggle(),
+                          child: IconButton(
+                            tooltip: context.appLocalizations.connections,
                           // The connections page is not in the phone navigation any
                           // more, so switching the page index did nothing: push it.
-                          onPressed: () => Navigator.of(context).push(
-                            MaterialPageRoute(
-                              builder: (_) => const ConnectionFeedsView(),
+                            onPressed: () => Navigator.of(context).push(
+                              MaterialPageRoute(
+                                builder: (_) => const ConnectionFeedsView(),
+                              ),
+                            ),
+                            icon: Badge(
+                              isLabelVisible:
+                                  ref.watch(portalConnectionsBadgeProvider),
+                              label: Text(
+                                '${ref.watch(requestsProvider).list.length}',
+                              ),
+                              child: const GlyphIcon(
+                                AppGlyphs.connections,
+                                size: 22,
+                              ),
                             ),
-                          ),
-                          icon: const GlyphIcon(
-                            AppGlyphs.connections,
-                            size: 22,
                           ),
                         ),
-                        IconButton(
-                          tooltip: context.appLocalizations.profiles,
-                          onPressed: () => Navigator.of(context).push(
-                            MaterialPageRoute(
-                              builder: (_) => const ProfilesView(),
+                        GestureDetector(
+                          onDoubleTap: () => ref
+                              .read(portalProfilesBadgeProvider.notifier)
+                              .toggle(),
+                          child: IconButton(
+                            tooltip: context.appLocalizations.profiles,
+                            onPressed: () => Navigator.of(context).push(
+                              MaterialPageRoute(
+                                builder: (_) => const ProfilesView(),
+                              ),
                             ),
-                          ),
-                          icon: Badge(
-                            label: Text('${ref.watch(profilesProvider).length}'),
-                            child: const GlyphIcon(
-                              AppGlyphs.profiles,
-                              size: 22,
+                            icon: Badge(
+                              isLabelVisible:
+                                  ref.watch(portalProfilesBadgeProvider),
+                              label: Text(
+                                '${ref.watch(profilesProvider).length}',
+                              ),
+                              child: const GlyphIcon(
+                                AppGlyphs.profiles,
+                                size: 22,
+                              ),
                             ),
                           ),
                         ),
diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 8bd00995..168ab4a0 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -659,3 +659,17 @@ class _FilterEditorSheet extends ConsumerWidget {
     );
   }
 }
+
+/// Both corner badges stay hidden until a double tap asks for them: a permanent
+/// counter is noise on a screen that is about the portal, not about the numbers.
+class PortalBadgeNotifier extends Notifier<bool> {
+  @override
+  bool build() => false;
+
+  void toggle() => state = !state;
+}
+
+final portalProfilesBadgeProvider =
+    NotifierProvider<PortalBadgeNotifier, bool>(PortalBadgeNotifier.new);
+final portalConnectionsBadgeProvider =
+    NotifierProvider<PortalBadgeNotifier, bool>(PortalBadgeNotifier.new);
-- 
