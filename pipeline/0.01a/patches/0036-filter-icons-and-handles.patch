From d78cc669d0085e14a424505fcc7de0a7b58c9ec9 Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 03:52:45 +0800
Subject: [PATCH] ui: filters use the config's own icons, editor gets drag
 handles, double tap cycles three layouts
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Group icons come from the subscription (CommonTargetIcon with the monogram fallback),
not from my guessed glyphs. The editor row carries the handle people already know, and a
double tap on the strip walks text → icon+text → icon.
---
 lib/views/dashboard/portal_controls.dart | 79 ++++++++++++++----------
 1 file changed, 46 insertions(+), 33 deletions(-)

diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index c10ecde0..31db2a7e 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -4,6 +4,7 @@ import 'package:fl_clash/models/models.dart';
 import 'package:fl_clash/providers/providers.dart';
 import 'package:fl_clash/views/proxies/proxies.dart';
 import 'package:fl_clash/ui/icons/icons.dart';
+import 'package:fl_clash/widgets/widgets.dart';
 import 'package:flutter_riverpod/flutter_riverpod.dart';
 import 'package:material_ui/material_ui.dart';
 
@@ -222,29 +223,6 @@ class PortalServerList extends ConsumerWidget {
   }
 }
 
-Glyph _groupGlyph(String name) {
-  final lower = name.toLowerCase();
-  if (lower.contains('auto') || lower.contains('авто')) return AppGlyphs.bolt;
-  if (lower.contains('vk') ||
-      lower.contains('yandex') ||
-      lower.contains('sber')) {
-    return AppGlyphs.globe;
-  }
-  if (lower.contains('media') || lower.contains('медиа')) {
-    return AppGlyphs.target;
-  }
-  if (lower.contains('всё') ||
-      lower.contains('все') ||
-      lower.contains('all')) {
-    return AppGlyphs.layers;
-  }
-  if (lower.contains('asia') ||
-      lower.contains('европ') ||
-      lower.contains('europe')) {
-    return AppGlyphs.proxies;
-  }
-  return AppGlyphs.filter;
-}
 
 /// Horizontal group filter. The chevrons are hints, not buttons: they say the strip
 /// can be dragged and hide themselves once that direction is exhausted. A double tap
@@ -260,7 +238,8 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
   final _controller = ScrollController();
   var _canBack = false;
   var _canForward = false;
-  var _showIcons = false;
+  /// 0 — текст, 1 — иконка и текст, 2 — только иконка.
+  var _display = 0;
 
   @override
   void initState() {
@@ -317,7 +296,7 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
         ),
         Expanded(
           child: GestureDetector(
-            onDoubleTap: () => setState(() => _showIcons = !_showIcons),
+            onDoubleTap: () => setState(() => _display = (_display + 1) % 3),
             child: NotificationListener<ScrollMetricsNotification>(
               onNotification: (_) {
                 _syncEdges();
@@ -332,12 +311,19 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
                       Padding(
                         padding: const EdgeInsets.symmetric(horizontal: 3),
                         child: ChoiceChip(
-                          avatar: _showIcons
-                              ? GlyphIcon(_groupGlyph(item.name), size: 16)
-                              : null,
+                          avatar: _display == 0
+                              ? null
+                              : SizedBox.square(
+                                  dimension: 16,
+                                  child: CommonTargetIcon(
+                                    src: item.icon,
+                                    fallback: GroupMonogram(item.name),
+                                  ),
+                                ),
                           // A selector says nothing useful without its current
                           // server, so the chip carries the resolved node too.
                           label: Text(() {
+                            if (_display == 2) return '';
                             final node = resolve(item.now);
                             if (node == null || node == item.name) {
                               return item.name;
@@ -638,13 +624,40 @@ class _FilterEditorSheet extends ConsumerWidget {
                   ref.read(portalFiltersProvider.notifier).reorder(next);
                 },
                 children: [
-                  for (final name in order)
-                    SwitchListTile(
+                  for (final (index, name) in order.indexed)
+                    ListTile(
                       key: ValueKey(name),
-                      value: !filters.hidden.contains(name),
+                      leading: Row(
+                        mainAxisSize: MainAxisSize.min,
+                        children: [
+                          // The handle people already know how to drag.
+                          ReorderableDragStartListener(
+                            index: index,
+                            child: const Padding(
+                              padding: EdgeInsets.only(right: 8),
+                              child: GlyphIcon(AppGlyphs.dragHandle, size: 20),
+                            ),
+                          ),
+                          SizedBox.square(
+                            dimension: 20,
+                            child: CommonTargetIcon(
+                              src: groups
+                                      .where((g) => g.name == name)
+                                      .firstOrNull
+                                      ?.icon ??
+                                  '',
+                              fallback: GroupMonogram(name),
+                            ),
+                          ),
+                        ],
+                      ),
                       title: Text(name),
-                      onChanged: (_) =>
-                          ref.read(portalFiltersProvider.notifier).toggle(name),
+                      trailing: Switch(
+                        value: !filters.hidden.contains(name),
+                        onChanged: (_) => ref
+                            .read(portalFiltersProvider.notifier)
+                            .toggle(name),
+                      ),
                     ),
                 ],
               ),
-- 
