From 59b25e2fff3aaba12192d8c445b8d1535833379a Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 04:16:00 +0800
Subject: [PATCH] ui: double tap a server to see what it is

The sheet shows the protocol the engine reports, the provider, the server description and
which group the row belongs to. Transport details (xhttp, grpc) are not in the core's
proxy object, so they are absent rather than guessed.
---
 lib/views/dashboard/portal_controls.dart | 62 +++++++++++++++++++++++-
 1 file changed, 61 insertions(+), 1 deletion(-)

diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 9566d2d1..53878e6e 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -501,7 +501,12 @@ class _ServerRowState extends ConsumerState<_ServerRow>
           child: child,
         );
       },
-      child: ListTile(
+      child: GestureDetector(
+        onDoubleTap: () {
+          HapticFeedback.mediumImpact();
+          showPortalDetails(context, widget.proxy, widget.group);
+        },
+        child: ListTile(
         dense: true,
         contentPadding: const EdgeInsets.symmetric(horizontal: 8),
         leading: GlyphIcon(
@@ -535,6 +540,7 @@ class _ServerRowState extends ConsumerState<_ServerRow>
                 proxyName: widget.proxy.name,
               );
         },
+        ),
       ),
     );
   }
@@ -783,3 +789,57 @@ final portalProfilesBadgeProvider =
     NotifierProvider<PortalBadgeNotifier, bool>(PortalBadgeNotifier.new);
 final portalConnectionsBadgeProvider =
     NotifierProvider<PortalBadgeNotifier, bool>(PortalBadgeNotifier.new);
+
+
+/// What the row actually is: the protocol the engine reports, who provides it and
+/// where it sits. Double tap, because a single tap already means 'use this one'.
+Future<void> showPortalDetails(
+  BuildContext context,
+  Proxy proxy,
+  Group group,
+) {
+  return showModalBottomSheet<void>(
+    context: context,
+    showDragHandle: true,
+    builder: (context) {
+      final theme = Theme.of(context);
+      Widget row(String label, String value) => Padding(
+            padding: const EdgeInsets.symmetric(vertical: 6),
+            child: Row(
+              crossAxisAlignment: CrossAxisAlignment.start,
+              children: [
+                SizedBox(
+                  width: 120,
+                  child: Text(
+                    label,
+                    style: theme.textTheme.bodySmall
+                        ?.copyWith(color: theme.colorScheme.onSurfaceVariant),
+                  ),
+                ),
+                Expanded(
+                  child: Text(value, style: theme.textTheme.bodyMedium),
+                ),
+              ],
+            ),
+          );
+      return SafeArea(
+        child: Padding(
+          padding: const EdgeInsets.fromLTRB(20, 0, 20, 20),
+          child: Column(
+            mainAxisSize: MainAxisSize.min,
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              Text(proxy.name, style: theme.textTheme.titleMedium),
+              const SizedBox(height: 10),
+              row('Протокол', proxy.type.toUpperCase()),
+              row('Провайдер', proxy.providerName ?? '—'),
+              row('Описание', proxy.serverDescription ?? '—'),
+              row('Группа', group.name),
+              row('Сейчас', group.now ?? '—'),
+            ],
+          ),
+        ),
+      );
+    },
+  );
+}
