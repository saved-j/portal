From e09a99c41febc13b4284a02ec22f86a392b21067 Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 04:44:34 +0800
Subject: [PATCH] ui: a switch that reads as a switch, a black hole when off,
 the connected mark inside

The mode row is centred, larger, and green while the network is on; a filter button
appears next to it only in that mode, so the label has somewhere to lead. The portal
draws a black hole while off, and a lit core carrying the connected group's own icon.
---
 lib/views/dashboard/hero.dart            | 23 +++++++++
 lib/views/dashboard/portal_controls.dart | 27 ++++++++---
 lib/views/dashboard/portal_gateway.dart  | 62 ++++++++++++++++++------
 3 files changed, 90 insertions(+), 22 deletions(-)

diff --git a/lib/views/dashboard/hero.dart b/lib/views/dashboard/hero.dart
index b517779f..44506e62 100644
--- a/lib/views/dashboard/hero.dart
+++ b/lib/views/dashboard/hero.dart
@@ -626,6 +626,28 @@ class _SignalBars extends StatelessWidget {
 /// outline in the primary color with a stop glyph and the run time while
 /// running.
 class _ConnectButton extends ConsumerWidget {
+
+  /// The mark of whatever is carrying traffic right now: the group's own icon when
+  /// the panel ships one, its monogram otherwise.
+  Widget? _connectedMark(WidgetRef ref) {
+    final groups = ref.watch(groupsProvider);
+    if (groups.isEmpty) return null;
+    final current = ref.watch(
+      currentProfileProvider.select((profile) => profile?.currentGroupName),
+    );
+    final group = groups.where((g) => g.name == current).firstOrNull ??
+        groups.firstWhere(
+          (g) => !{'DIRECT', 'REJECT'}.contains(g.name.toUpperCase()),
+          orElse: () => groups.first,
+        );
+    return SizedBox.square(
+      dimension: 56,
+      child: CommonTargetIcon(
+        src: group.icon,
+        fallback: GroupMonogram(group.name),
+      ),
+    );
+  }
   const _ConnectButton();
 
   @override
@@ -658,6 +680,7 @@ class _ConnectButton extends ConsumerWidget {
                   isStart: isStart,
                   suspended: suspended,
                   runTime: runTime,
+                  center: _connectedMark(ref),
                 ),
               ),
             ),
