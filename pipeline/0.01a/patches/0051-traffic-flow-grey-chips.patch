From c9ba8427f24cac686dba54e3b8dd65944dd093ad Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 04:57:10 +0800
Subject: [PATCH] ui: live traffic inside the portal, bypass chips grey from
 the start
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Packets cross the portal at a rate taken from the measured traffic, so the picture follows
the wire. A filter whose outbound is already DIRECT is drawn grey before anyone touches it —
that is the bypass state, and the user should not have to create it to see it.
---
 lib/views/dashboard/hero.dart            |  6 ++++++
 lib/views/dashboard/portal_controls.dart |  5 ++++-
 lib/views/dashboard/portal_gateway.dart  | 25 ++++++++++++++++++++++++
 3 files changed, 35 insertions(+), 1 deletion(-)

diff --git a/lib/views/dashboard/hero.dart b/lib/views/dashboard/hero.dart
index 6110aeeb..668c3f73 100644
--- a/lib/views/dashboard/hero.dart
+++ b/lib/views/dashboard/hero.dart
@@ -659,6 +659,11 @@ class _ConnectButton extends ConsumerWidget {
     final isStart = ref.watch(isStartProvider);
     final suspended = isStart && ref.watch(suspendProvider);
     final runTime = ref.watch(runTimeProvider);
+    // Live traffic sets how busy the portal looks: 2 MB/s and above is a full flow.
+    final traffics = ref.watch(trafficsProvider).list;
+    final last = traffics.isEmpty ? null : traffics.last;
+    final rate = last == null ? 0.0 : (last.up + last.down).toDouble();
+    final intensity = (rate / (2 * 1024 * 1024)).clamp(0.0, 1.0);
     final label = suspended
         ? appLocalizations.suspended
         : isStart
@@ -684,6 +689,7 @@ class _ConnectButton extends ConsumerWidget {
                   suspended: suspended,
                   runTime: runTime,
                   center: _connectedMark(ref),
+                  intensity: intensity,
                 ),
               ),
             ),
diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index fa6d3eb6..f10b7d2f 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -437,7 +437,10 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
                   children: [
                     for (final item in groups)
                       Builder(builder: (context) {
-                        final bypassed = bypassedNames.contains(item.name);
+                        // A filter the panel already routes to DIRECT is a bypass by
+                        // definition: it should look that way before anyone touches it.
+                        final bypassed = bypassedNames.contains(item.name) ||
+                            _isBuiltinOutbound(item.now ?? '');
                         return Padding(
                         padding: const EdgeInsets.symmetric(horizontal: 3),
                         child: GestureDetector(
diff --git a/lib/views/dashboard/portal_gateway.dart b/lib/views/dashboard/portal_gateway.dart
index 7e8adb4e..7a5f0f7c 100644
--- a/lib/views/dashboard/portal_gateway.dart
+++ b/lib/views/dashboard/portal_gateway.dart
@@ -19,6 +19,7 @@ class PortalGatewayCore extends StatefulWidget {
     required this.runTime,
     this.size = 168,
     this.center,
+    this.intensity = 0,
   });
 
   final bool isStart;
@@ -29,6 +30,10 @@ class PortalGatewayCore extends StatefulWidget {
   /// The connected server's mark, shown inside a lit portal.
   final Widget? center;
 
+  /// Live traffic pressure 0..1: it decides how many packets cross the portal and how
+  /// fast they move, so the picture follows the wire instead of a fixed loop.
+  final double intensity;
+
   @override
   State<PortalGatewayCore> createState() => _PortalGatewayCoreState();
 }
@@ -88,6 +93,7 @@ class _PortalGatewayCoreState extends State<PortalGatewayCore>
                 accent: accent,
                 turn: t,
                 active: widget.isStart,
+                intensity: widget.intensity,
               ),
               child: Center(
                 child: IconTheme.merge(
@@ -116,17 +122,36 @@ class _GatewayPainter extends CustomPainter {
     required this.accent,
     required this.turn,
     required this.active,
+    required this.intensity,
   });
 
   final Color portal;
   final Color accent;
   final double turn;
   final bool active;
+  final double intensity;
 
   @override
   void paint(Canvas canvas, Size size) {
     final center = size.center(Offset.zero);
     final radius = size.shortestSide / 2;
+    // Traffic crossing the portal: packets run from the rim to the core, their
+    // number and speed taken from the live rate.
+    final count = (2 + (intensity.clamp(0.0, 1.0) * 10)).round();
+    for (var i = 0; i < count; i++) {
+      final phase = (turn * (1.0 + intensity * 2.5) + i / count) % 1.0;
+      final packetRadius = (radius - 12) * (1.0 - phase);
+      if (packetRadius < 26) continue;
+      final angle = i * 2.39996 + turn * 6.28318; // golden-angle spread
+      final offset = Offset(
+        center.dx + packetRadius * math.cos(angle),
+        center.dy + packetRadius * math.sin(angle),
+      );
+      final packet = Paint()
+        ..color = portal.withValues(alpha: 0.55 * (1 - phase) * (0.4 + intensity));
+      canvas.drawCircle(offset, 1.6 + 1.6 * intensity, packet);
+    }
+
     final dim = active ? 1.0 : 1.0;
 
     if (!active) {
-- 
