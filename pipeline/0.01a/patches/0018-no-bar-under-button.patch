From 32a1e813c0c02492e8cffe9de8162bbc5e95fa2b Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 01:46:28 +0800
Subject: [PATCH] ui: no app bar on the working screen, plan status under the
 button, no server panel

An empty app bar still reserved its height, so removing the title left a hole above
the portal; the hero screen now renders without any bar. Announcement and
subscription share one block right under the connect button, and the
'change portal' panel is gone: choosing a server happens in the list itself.
---
 lib/views/dashboard/dashboard.dart | 15 +++++++++++++++
 lib/views/dashboard/hero.dart      | 24 ++++++++++++++----------
 2 files changed, 29 insertions(+), 10 deletions(-)

diff --git a/lib/views/dashboard/dashboard.dart b/lib/views/dashboard/dashboard.dart
index 3c8ed1ce..4dcce94a 100644
--- a/lib/views/dashboard/dashboard.dart
+++ b/lib/views/dashboard/dashboard.dart
@@ -70,6 +70,21 @@ class _DashboardViewState extends ConsumerState<DashboardView> {
     final editing = _editing;
     final gap = cardSpacingOf(context, ref.watch(viewModeProvider));
     final appLocalizations = context.appLocalizations;
+    if (hero) {
+      // No app bar at all on the working screen: an empty bar still reserves its
+      // height and reads as a hole above the portal.
+      return Material(
+        color: DashboardColors.of(context).page,
+        child: SafeArea(
+          bottom: false,
+          child: DashboardDensityScope(
+            density: DashboardDensity.mobile,
+            scale: scale,
+            child: const HeroDashboard(),
+          ),
+        ),
+      );
+    }
     return CommonScaffold(
       backgroundColor: DashboardColors.of(context).page,
       // The hero screen carries its own header: a title bar with the page name,
diff --git a/lib/views/dashboard/hero.dart b/lib/views/dashboard/hero.dart
index d219a3ab..f075c981 100644
--- a/lib/views/dashboard/hero.dart
+++ b/lib/views/dashboard/hero.dart
@@ -134,18 +134,22 @@ class _HeroDashboardState extends ConsumerState<HeroDashboard> {
                     // order Happ and Incy taught people: the button you press
                     // before the list you read.
                     const _ConnectButton(),
-                    const SizedBox(height: 16),
+                    const SizedBox(height: 12),
+                    // Announcement and subscription sit together right under the
+                    // button, the way Happ and Incy put plan status next to the
+                    // switch: visible, but out of the way of choosing a server.
+                    Column(
+                      crossAxisAlignment: CrossAxisAlignment.stretch,
+                      children: [
+                        if (ref.watch(announcementProvider) != null)
+                          const AnnouncementCard(),
+                        const ProfilesCard(),
+                      ],
+                    ),
+                    const SizedBox(height: _gap),
                     const PortalModeSwitch(),
-                    const SizedBox(height: 8),
+                    const SizedBox(height: 4),
                     const PortalServerList(),
-                    if (ref.watch(announcementProvider) != null) ...[
-                      const SizedBox(height: _gap),
-                      const AnnouncementCard(),
-                    ],
-                    const SizedBox(height: _gap),
-                    _ServerPanel(group: headers.serverGroup),
-                    const SizedBox(height: _gap),
-                    const ProfilesCard(),
                   ],
                 ),
               ),
