From d48f3f492572bcac309821d957c34d2695bfa77a Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 04:16:49 +0800
Subject: [PATCH] ui: four filter layouts, cycled by double tap

Name, name+server, icon+server, icon. The strip answers 'which filter', and the server
appears only in the two layouts that ask for it.
---
 lib/views/dashboard/portal_controls.dart | 60 +++++++++++++++++-------
 1 file changed, 42 insertions(+), 18 deletions(-)

diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 53878e6e..d04e3352 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -285,7 +285,7 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
   final _controller = ScrollController();
   var _canBack = false;
   var _canForward = false;
-  /// 0 — текст, 1 — иконка и текст, 2 — только иконка.
+  /// 0 — название, 1 — название и сервер, 2 — иконка и сервер, 3 — только иконка.
   var _display = 0;
 
   @override
@@ -321,6 +321,14 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
     final allGroups = ref.watch(groupsProvider);
     final filters = ref.watch(portalFiltersProvider);
     final groups = portalVisibleGroups(allGroups, filters.hidden, filters.order);
+    final byName = {for (final item in allGroups) item.name: item};
+    String? resolve(String? name, [int depth = 0]) {
+      if (name == null || depth > 6) return null;
+      final next = byName[name];
+      if (next == null) return name;
+      return resolve(next.now, depth + 1);
+    }
+
     final active = ref.watch(portalGroupProvider) ?? groups.firstOrNull?.name;
     final hint = theme.colorScheme.onSurfaceVariant.withValues(alpha: 0.7);
     return Row(
@@ -333,7 +341,7 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
         ),
         Expanded(
           child: GestureDetector(
-            onDoubleTap: () => setState(() => _display = (_display + 1) % 3),
+            onDoubleTap: () => setState(() => _display = (_display + 1) % 4),
             child: NotificationListener<ScrollMetricsNotification>(
               onNotification: (_) {
                 _syncEdges();
@@ -349,23 +357,39 @@ class _GroupStripState extends ConsumerState<_GroupStrip> {
                         padding: const EdgeInsets.symmetric(horizontal: 3),
                         child: ChoiceChip(
                           showCheckmark: false,
-                          // No avatar anywhere: an avatar plus an empty or short label
-                          // never centres. The mark and the name are one centred row.
-                          label: Row(
-                            mainAxisSize: MainAxisSize.min,
-                            mainAxisAlignment: MainAxisAlignment.center,
-                            children: [
-                              if (_display >= 1)
-                                SizedBox.square(
-                                  dimension: 16,
-                                  child: CommonTargetIcon(
-                                    src: item.icon,
-                                    fallback: GroupMonogram(item.name),
-                                  ),
+                          // Four layouts, one row each: name, name+server,
+                          // icon+server, icon. Everything centres by construction.
+                          label: Builder(
+                            builder: (context) {
+                              final node = resolve(item.now);
+                              final server =
+                                  node == null || node == item.name ? null : node;
+                              final showIcon = _display >= 2;
+                              final showName = _display <= 1;
+                              final showServer = _display == 1 || _display == 2;
+                              final mark = SizedBox.square(
+                                dimension: 16,
+                                child: CommonTargetIcon(
+                                  src: item.icon,
+                                  fallback: GroupMonogram(item.name),
                                 ),
-                              if (_display == 1) const SizedBox(width: 6),
-                              if (_display != 2) Text(item.name),
-                            ],
+                              );
+                              if (!showName && !showServer) return mark;
+                              final text = [
+                                if (showName) item.name,
+                                if (showServer && server != null) server,
+                              ].join(' · ');
+                              if (!showIcon) return Text(text);
+                              return Row(
+                                mainAxisSize: MainAxisSize.min,
+                                mainAxisAlignment: MainAxisAlignment.center,
+                                children: [
+                                  mark,
+                                  const SizedBox(width: 6),
+                                  Text(text),
+                                ],
+                              );
+                            },
                           ),
                           selected: item.name == active,
                           onSelected: (_) {
