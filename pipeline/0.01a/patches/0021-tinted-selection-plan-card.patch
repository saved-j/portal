From c6f1f27d0a673cedc7d6451dd2ca9dc5f2652d7c Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 02:41:02 +0800
Subject: [PATCH] ui: tinted selection that waits for the portal, one plan card

A picked server is now tinted, not only marked, and before the tunnel is up the
choice is visual: it is applied the moment the portal opens. Announcement and plan
status share one card, since both are read, not operated.
---
 lib/views/dashboard/hero.dart            |   9 +-
 lib/views/dashboard/portal_controls.dart | 117 ++++++++++++++++++++++-
 2 files changed, 113 insertions(+), 13 deletions(-)

diff --git a/lib/views/dashboard/hero.dart b/lib/views/dashboard/hero.dart
index f075c981..7e801ffd 100644
--- a/lib/views/dashboard/hero.dart
+++ b/lib/views/dashboard/hero.dart
@@ -138,14 +138,7 @@ class _HeroDashboardState extends ConsumerState<HeroDashboard> {
                     // Announcement and subscription sit together right under the
                     // button, the way Happ and Incy put plan status next to the
                     // switch: visible, but out of the way of choosing a server.
-                    Column(
-                      crossAxisAlignment: CrossAxisAlignment.stretch,
-                      children: [
-                        if (ref.watch(announcementProvider) != null)
-                          const AnnouncementCard(),
-                        const ProfilesCard(),
-                      ],
-                    ),
+                    const PortalPlanCard(),
                     const SizedBox(height: _gap),
                     const PortalModeSwitch(),
                     const SizedBox(height: 4),
diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 67b8ffe9..21652571 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -52,6 +52,10 @@ enum _SortOrder { ping, alphabet }
 class _PortalServerListState extends ConsumerState<PortalServerList> {
   var _order = _SortOrder.ping;
 
+  /// The row the user picked. Before the portal is open the choice is only
+  /// visual: it is applied the moment the tunnel comes up.
+  String? _picked;
+
   @override
   Widget build(BuildContext context) {
     final groups = ref.watch(groupsProvider);
@@ -74,6 +78,18 @@ class _PortalServerListState extends ConsumerState<PortalServerList> {
     }
 
     final theme = Theme.of(context);
+    final running = ref.watch(runTimeProvider) != null;
+    if (running && _picked != null && group.now != _picked) {
+      final pending = _picked!;
+      _picked = null;
+      WidgetsBinding.instance.addPostFrameCallback((_) {
+        ref.read(proxiesActionProvider.notifier).changeProxy(
+              groupName: group.name,
+              proxyName: pending,
+            );
+      });
+    }
+    final selectedName = _picked ?? group.now;
     final members = [...group.all];
     if (_order == _SortOrder.alphabet) {
       members.sort((a, b) => a.name.toLowerCase().compareTo(b.name.toLowerCase()));
@@ -113,7 +129,8 @@ class _PortalServerListState extends ConsumerState<PortalServerList> {
           _ServerRow(
             group: group,
             proxy: proxy,
-            selected: group.now == proxy.name,
+            selected: selectedName == proxy.name,
+            onPick: (name) => setState(() => _picked = name),
           ),
       ],
     );
@@ -125,11 +142,13 @@ class _ServerRow extends ConsumerWidget {
     required this.group,
     required this.proxy,
     required this.selected,
+    required this.onPick,
   });
 
   final Group group;
   final Proxy proxy;
   final bool selected;
+  final ValueChanged<String> onPick;
 
   @override
   Widget build(BuildContext context, WidgetRef ref) {
@@ -139,6 +158,12 @@ class _ServerRow extends ConsumerWidget {
     return ListTile(
       dense: true,
       selected: selected,
+      // Colour, not just the marker: a tinted row is what the eye finds first.
+      tileColor: selected
+          ? theme.colorScheme.primaryContainer.withValues(alpha: 0.45)
+          : null,
+      selectedTileColor: theme.colorScheme.primaryContainer.withValues(alpha: 0.45),
+      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
       contentPadding: const EdgeInsets.symmetric(horizontal: 8),
       leading: GlyphIcon(
         selected ? AppGlyphs.check : AppGlyphs.proxies,
@@ -158,10 +183,92 @@ class _ServerRow extends ConsumerWidget {
         delay == null ? '—' : '$delay ms',
         style: theme.textTheme.labelMedium?.copyWith(color: color),
       ),
-      onTap: () => ref.read(proxiesActionProvider.notifier).changeProxy(
-            groupName: group.name,
-            proxyName: proxy.name,
-          ),
+      onTap: () {
+        onPick(proxy.name);
+        ref.read(proxiesActionProvider.notifier).changeProxy(
+              groupName: group.name,
+              proxyName: proxy.name,
+            );
