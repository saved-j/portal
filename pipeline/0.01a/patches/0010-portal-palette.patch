From 6c2e641aa46c0c7a6e64e41b2aecff598eeb3308 Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 00:37:36 +0800
Subject: [PATCH] brand: Portal palette in the accent seed and the accent list

The legacy PortalVPN gateway used cyan #00E5FF as its accent and purple #A855F7 as
the second colour. FlClashX derives the whole Material scheme from one seed, so
seeding the gateway cyan rebrands every screen at once, and purple joins the
accent list next to it.
---
 lib/common/constant.dart | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/lib/common/constant.dart b/lib/common/constant.dart
index d2640433..521b7a28 100644
--- a/lib/common/constant.dart
+++ b/lib/common/constant.dart
@@ -177,7 +177,8 @@ const proxiesListStoreKey = PageStorageKey<String>('proxies_list');
 const toolsStoreKey = PageStorageKey<String>('tools');
 const profilesStoreKey = PageStorageKey<String>('profiles');
 
-const defaultPrimaryColor = 0xFF03A9F4;
+// Portal Connect accent: the cyan of the legacy PortalVPN gateway button.
+const defaultPrimaryColor = 0xFF00E5FF;
 
 const maxLogsLength = 5000;
 const maxRequestsLength = 2000;
@@ -192,6 +193,7 @@ const trafficSampleLength = 30;
 // macOS accent colors.
 const defaultPrimaryColors = [
   defaultPrimaryColor,
+  0xFFA855F7, // Portal purple, the second half of the legacy palette
   0xFF007AFF,
   0xFFCB30E0,
   0xFFFF2D55,
-- 
