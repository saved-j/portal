From 5c31285035c6e684e6f2b1d7ad5c16ec2c8c8073 Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 01:52:55 +0800
Subject: [PATCH] ui: visible selection and a ping/alphabet sort switch in the
 server list

The list used to strip the engine's current selection, so tapping a server changed
nothing on screen. It now reads the raw groups, marks the row in use, and carries a
sort switch: by ping (default) or alphabetically.
---
 lib/views/dashboard/portal_controls.dart | 146 +++++++++++++++++------
 1 file changed, 109 insertions(+), 37 deletions(-)

diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 604e34a3..67b8ffe9 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -1,5 +1,6 @@
 import 'package:fl_clash/common/common.dart';
 import 'package:fl_clash/enum/enum.dart';
+import 'package:fl_clash/models/models.dart';
 import 'package:fl_clash/providers/providers.dart';
 import 'package:fl_clash/ui/icons/icons.dart';
 import 'package:flutter_riverpod/flutter_riverpod.dart';
@@ -36,60 +37,131 @@ class PortalModeSwitch extends ConsumerWidget {
   }
 }
 
-/// The working screen's server list: name on the left, delay on the right, one
-/// tap to make it the outbound of the group in charge.
-class PortalServerList extends ConsumerWidget {
+/// The working screen's server list: name on the left, delay on the right, a
+/// marker on the row that is actually in use, and a sort switch between ping and
+/// alphabetical order.
+class PortalServerList extends ConsumerStatefulWidget {
   const PortalServerList({super.key});
 
   @override
-  Widget build(BuildContext context, WidgetRef ref) {
-    final groups = ref.watch(currentGroupsStateProvider).value;
-    final group = groups.firstOrNull;
+  ConsumerState<PortalServerList> createState() => _PortalServerListState();
+}
+
+enum _SortOrder { ping, alphabet }
+
+class _PortalServerListState extends ConsumerState<PortalServerList> {
+  var _order = _SortOrder.ping;
+
+  @override
+  Widget build(BuildContext context) {
+    final groups = ref.watch(groupsProvider);
+    final group = groups
+        .where((item) => item.hidden == false)
+        .where((item) {
+      final name = item.name.toUpperCase();
+      return name != 'DIRECT' && name != 'REJECT';
+    }).firstOrNull;
     if (group == null) {
       return Padding(
         padding: const EdgeInsets.all(16),
         child: Text(
           context.appLocalizations.proxyGroupEmpty,
           style: Theme.of(context).textTheme.bodyMedium?.copyWith(
-            color: Theme.of(context).colorScheme.onSurfaceVariant,
-          ),
+                color: Theme.of(context).colorScheme.onSurfaceVariant,
+              ),
         ),
       );
     }
-    final members = group.all;
-    return ListView.builder(
-      shrinkWrap: true,
-      physics: const NeverScrollableScrollPhysics(),
-      itemCount: members.length,
-      itemBuilder: (context, index) {
-        final proxy = members[index];
-        final selected = group.now == proxy.name;
-        final delay = ref.watch(delayProvider(proxyName: proxy.name));
-        return ListTile(
-          dense: true,
-          selected: selected,
-          leading: GlyphIcon(
-            AppGlyphs.proxies,
-            size: 20,
-            color: selected
-                ? Theme.of(context).colorScheme.primary
-                : Theme.of(context).colorScheme.onSurfaceVariant,
-          ),
-          title: Text(proxy.name, maxLines: 1, overflow: TextOverflow.ellipsis),
-          trailing: Text(
-            delay == null ? '—' : '$delay ms',
-            style: Theme.of(context).textTheme.labelMedium?.copyWith(
-              color: selected
-                  ? Theme.of(context).colorScheme.primary
-                  : Theme.of(context).colorScheme.onSurfaceVariant,
+
+    final theme = Theme.of(context);
+    final members = [...group.all];
+    if (_order == _SortOrder.alphabet) {
+      members.sort((a, b) => a.name.toLowerCase().compareTo(b.name.toLowerCase()));
+    } else {
+      int rank(Proxy p) => ref.watch(delayProvider(proxyName: p.name)) ?? 1 << 30;
+      members.sort((a, b) => rank(a).compareTo(rank(b)));
+    }
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        Row(
+          children: [
+            Text(
+              group.name,
+              style: theme.textTheme.labelLarge?.copyWith(
+                color: theme.colorScheme.onSurfaceVariant,
+              ),
+            ),
+            const Spacer(),
+            IconButton(
+              tooltip: '${context.appLocalizations.sort}: '
+                  '${_order == _SortOrder.ping ? 'пинг' : 'A-Z'}',
+              onPressed: () => setState(() {
+                _order = _order == _SortOrder.ping
+                    ? _SortOrder.alphabet
+                    : _SortOrder.ping;
+              }),
+              icon: GlyphIcon(
+                _order == _SortOrder.ping ? AppGlyphs.sort : AppGlyphs.proxies,
+                size: 18,
+              ),
             ),
+          ],
+        ),
+        for (final proxy in members)
+          _ServerRow(
+            group: group,
+            proxy: proxy,
+            selected: group.now == proxy.name,
           ),
-          onTap: () => ref.read(proxiesActionProvider.notifier).changeProxy(
+      ],
+    );
+  }
+}
+
+class _ServerRow extends ConsumerWidget {
+  const _ServerRow({
+    required this.group,
+    required this.proxy,
+    required this.selected,
+  });
+
+  final Group group;
+  final Proxy proxy;
+  final bool selected;
+
+  @override
+  Widget build(BuildContext context, WidgetRef ref) {
+    final theme = Theme.of(context);
+    final delay = ref.watch(delayProvider(proxyName: proxy.name));
+    final color = selected ? theme.colorScheme.primary : theme.colorScheme.onSurfaceVariant;
+    return ListTile(
+      dense: true,
+      selected: selected,
+      contentPadding: const EdgeInsets.symmetric(horizontal: 8),
+      leading: GlyphIcon(
+        selected ? AppGlyphs.check : AppGlyphs.proxies,
+        size: 20,
+        color: color,
+      ),
+      title: Text(
+        proxy.name,
+        maxLines: 1,
+        overflow: TextOverflow.ellipsis,
+        style: theme.textTheme.bodyLarge?.copyWith(
+          color: selected ? theme.colorScheme.primary : null,
+          fontWeight: selected ? FontWeight.w600 : null,
+        ),
+      ),
+      trailing: Text(
+        delay == null ? '—' : '$delay ms',
+        style: theme.textTheme.labelMedium?.copyWith(color: color),
+      ),
+      onTap: () => ref.read(proxiesActionProvider.notifier).changeProxy(
             groupName: group.name,
             proxyName: proxy.name,
           ),
-        );
-      },
     );
   }
 }
