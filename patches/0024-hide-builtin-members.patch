From 85272de93ca465411da9cd456599e76644032b96 Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 02:47:32 +0800
Subject: [PATCH] fix: hide DIRECT and REJECT inside the server list again

Reading the raw groups kept their current selection, but it also let the engine's
built-in outbounds back into the list; they are filtered out as members now.
---
 lib/views/dashboard/portal_controls.dart | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 6288dc85..674f699d 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -96,7 +96,10 @@ class _PortalServerListState extends ConsumerState<PortalServerList> {
       });
     }
     final selectedName = _picked ?? group.now;
-    final members = [...group.all];
+    final members = [
+      for (final proxy in group.all)
+        if (!{'DIRECT', 'REJECT'}.contains(proxy.name.toUpperCase())) proxy,
+    ];
     if (_order == _SortOrder.alphabet) {
       members.sort((a, b) => a.name.toLowerCase().compareTo(b.name.toLowerCase()));
     } else {
-- 
