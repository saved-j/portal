From e1c67f064761b6f5fcd19a562cca9c4e293b1f7b Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 02:41:55 +0800
Subject: [PATCH] ui: group strip and a ping test button above the server list

The network mode needs to say which group the list belongs to: a horizontal strip of
ChoiceChips switches it, and a bolt button measures delay for the group in view, so
the numbers in the list can be refreshed without leaving the working screen.
---
 lib/views/dashboard/portal_controls.dart | 53 +++++++++++++++++++-----
 1 file changed, 43 insertions(+), 10 deletions(-)

diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 21652571..d48977c2 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -56,15 +56,21 @@ class _PortalServerListState extends ConsumerState<PortalServerList> {
   /// visual: it is applied the moment the tunnel comes up.
   String? _picked;
 
+  /// Which group the strip shows; the list follows it.
+  String? _groupName;
+
   @override
   Widget build(BuildContext context) {
-    final groups = ref.watch(groupsProvider);
-    final group = groups
-        .where((item) => item.hidden == false)
-        .where((item) {
+    final allGroups = ref.watch(groupsProvider);
+    final groups = allGroups.where((item) {
+      if (item.hidden == true) return false;
       final name = item.name.toUpperCase();
       return name != 'DIRECT' && name != 'REJECT';
-    }).firstOrNull;
+    }).toList();
+    final group = groups
+            .where((item) => item.name == _groupName)
+            .firstOrNull ??
+        groups.firstOrNull;
     if (group == null) {
       return Padding(
         padding: const EdgeInsets.all(16),
@@ -103,13 +109,40 @@ class _PortalServerListState extends ConsumerState<PortalServerList> {
       children: [
         Row(
           children: [
-            Text(
-              group.name,
-              style: theme.textTheme.labelLarge?.copyWith(
-                color: theme.colorScheme.onSurfaceVariant,
+            if (groups.length <= 1)
+              Text(
+                group.name,
+                style: theme.textTheme.labelLarge?.copyWith(
+                  color: theme.colorScheme.onSurfaceVariant,
+                ),
+              )
+            else
+              Expanded(
+                child: SingleChildScrollView(
+                  scrollDirection: Axis.horizontal,
+                  child: Row(
+                    children: [
+                      for (final item in groups)
+                        Padding(
+                          padding: const EdgeInsets.only(right: 6),
+                          child: ChoiceChip(
+                            label: Text(item.name),
+                            selected: item.name == group.name,
+                            onSelected: (_) =>
+                                setState(() => _groupName = item.name),
+                          ),
+                        ),
+                    ],
+                  ),
+                ),
               ),
+            IconButton(
+              tooltip: context.appLocalizations.delayTest,
+              onPressed: () => ref
+                  .read(proxiesActionProvider.notifier)
+                  .delayTest(group.all),
+              icon: const GlyphIcon(AppGlyphs.bolt, size: 18),
             ),
-            const Spacer(),
             IconButton(
               tooltip: '${context.appLocalizations.sort}: '
                   '${_order == _SortOrder.ping ? 'пинг' : 'A-Z'}',
-- 
