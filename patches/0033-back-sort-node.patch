From 3913e31401d1455c8594860e238b7562669707d9 Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 03:42:54 +0800
Subject: [PATCH] ui: back returns from the proxies dashboard, alphabetical by
 default, selectors show their node
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The long press pushed nothing before: it switched the page index, so Back walked out of
the app. It is a route now. Sorting starts alphabetical, and a selector row reads
'АВТО · Индия' with that node's delay, the way the connections dashboard shows it.
---
 lib/views/dashboard/portal_controls.dart | 29 +++++++++++++++++++-----
 1 file changed, 23 insertions(+), 6 deletions(-)

diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 8754944e..c10ecde0 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -2,6 +2,7 @@ import 'package:fl_clash/common/common.dart';
 import 'package:fl_clash/enum/enum.dart';
 import 'package:fl_clash/models/models.dart';
 import 'package:fl_clash/providers/providers.dart';
+import 'package:fl_clash/views/proxies/proxies.dart';
 import 'package:fl_clash/ui/icons/icons.dart';
 import 'package:flutter_riverpod/flutter_riverpod.dart';
 import 'package:material_ui/material_ui.dart';
@@ -11,7 +12,7 @@ enum PortalSort { ping, alphabet }
 
 class PortalSortNotifier extends Notifier<PortalSort> {
   @override
-  PortalSort build() => PortalSort.ping;
+  PortalSort build() => PortalSort.alphabet;
 
   void toggle() =>
       state = state == PortalSort.ping ? PortalSort.alphabet : PortalSort.ping;
@@ -116,9 +117,11 @@ class PortalModeSwitch extends ConsumerWidget {
                           ? () => showPortalFilterEditor(context)
                           : null,
                       onLongPress: item == Mode.rule
-                          ? () => ref
-                              .read(currentPageLabelProvider.notifier)
-                              .toPage(PageLabel.proxies)
+                          ? () => Navigator.of(context).push(
+                                MaterialPageRoute(
+                                  builder: (_) => const ProxiesView(),
+                                ),
+                              )
                           : null,
                       onTap: () {
                         if (item == mode) return;
@@ -397,7 +400,19 @@ class _ServerRow extends ConsumerWidget {
   @override
   Widget build(BuildContext context, WidgetRef ref) {
     final theme = Theme.of(context);
-    final delay = ref.watch(delayProvider(proxyName: proxy.name));
+    // A selector row says nothing useful without the node behind it: 'Auto' alone
+    // hides which server carries the traffic and what it costs.
+    final allGroups = ref.watch(groupsProvider);
+    final byName = {for (final item in allGroups) item.name: item};
+    String? resolve(String? name, [int depth = 0]) {
+      if (name == null || depth > 6) return null;
+      final next = byName[name];
+      if (next == null) return name;
+      return resolve(next.now, depth + 1);
+    }
+
+    final node = byName.containsKey(proxy.name) ? resolve(proxy.name) : null;
+    final delay = ref.watch(delayProvider(proxyName: node ?? proxy.name));
     final color =
         selected ? theme.colorScheme.onPrimaryContainer : theme.colorScheme.onSurfaceVariant;
     return ListTile(
@@ -413,7 +428,9 @@ class _ServerRow extends ConsumerWidget {
         color: color,
       ),
       title: Text(
-        proxy.name,
+        node == null || node == proxy.name
+            ? proxy.name
+            : '${proxy.name} · $node',
         maxLines: 1,
         overflow: TextOverflow.ellipsis,
         style: theme.textTheme.bodyLarge?.copyWith(
-- 
