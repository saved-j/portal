From dccd161102648c76292f4de5e7ef9e51d7c87737 Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 03:43:59 +0800
Subject: [PATCH] fix: settings and subscriptions open as routes

Both buttons switched the page index, which has no history, so Back left the app. They
push ToolsView and ProfilesView now, and the dashboard stays underneath.
---
 lib/views/dashboard/hero.dart | 20 ++++++++++++++------
 1 file changed, 14 insertions(+), 6 deletions(-)

diff --git a/lib/views/dashboard/hero.dart b/lib/views/dashboard/hero.dart
index b7a02080..dfc09d95 100644
--- a/lib/views/dashboard/hero.dart
+++ b/lib/views/dashboard/hero.dart
@@ -11,6 +11,8 @@ import 'package:fl_clash/providers/providers.dart';
 import 'package:fl_clash/ui/icons/icons.dart';
 import 'package:fl_clash/views/profiles/add.dart';
 import 'package:fl_clash/views/access.dart';
+import 'package:fl_clash/views/profiles/profiles.dart';
+import 'package:fl_clash/views/tools.dart';
 import 'package:fl_clash/views/connection/connection_feeds.dart';
 import 'package:fl_clash/widgets/widgets.dart';
 import 'portal_controls.dart';
@@ -92,9 +94,13 @@ class _HeroDashboardState extends ConsumerState<HeroDashboard> {
                       children: [
                         IconButton(
                           tooltip: context.appLocalizations.tools,
-                          onPressed: () => ref
-                              .read(currentPageLabelProvider.notifier)
-                              .toPage(PageLabel.tools),
+                          // Pushed, not page-switched: a page index has no history, so
+                          // Back walked out of the app instead of returning here.
+                          onPressed: () => Navigator.of(context).push(
+                            MaterialPageRoute(
+                              builder: (_) => const ToolsView(),
+                            ),
+                          ),
                           icon: const GlyphIcon(
                             AppGlyphs.settings,
                             size: 22,
@@ -146,9 +152,11 @@ class _HeroDashboardState extends ConsumerState<HeroDashboard> {
                         ),
                         IconButton(
                           tooltip: context.appLocalizations.profiles,
-                          onPressed: () => ref
-                              .read(currentPageLabelProvider.notifier)
-                              .toPage(PageLabel.profiles),
+                          onPressed: () => Navigator.of(context).push(
+                            MaterialPageRoute(
+                              builder: (_) => const ProfilesView(),
+                            ),
+                          ),
                           icon: Badge(
                             label: Text('${ref.watch(profilesProvider).length}'),
                             child: const GlyphIcon(
-- 
