From 4e4a79b82bd0ec8a46ac9a96a37ba7dfa494fa1c Mon Sep 17 00:00:00 2001
From: Elara <elara@portal.local>
Date: Sun, 15 Nov 2026 02:50:23 +0800
Subject: [PATCH] ui: readable selection tint, ping only while the portal is
 open

The tint was 45% of primaryContainer, which on the dark surface moved the row by a
few RGB points and read as no change at all; it is opaque now. Delay runs through the
core, so the bolt button is disabled with a hint until the tunnel is up, instead of
answering -1 ms.
---
 lib/views/dashboard/portal_controls.dart | 20 ++++++++++++--------
 1 file changed, 12 insertions(+), 8 deletions(-)

diff --git a/lib/views/dashboard/portal_controls.dart b/lib/views/dashboard/portal_controls.dart
index 674f699d..92abcf41 100644
--- a/lib/views/dashboard/portal_controls.dart
+++ b/lib/views/dashboard/portal_controls.dart
@@ -140,10 +140,16 @@ class _PortalServerListState extends ConsumerState<PortalServerList> {
                 ),
               ),
             IconButton(
-              tooltip: context.appLocalizations.delayTest,
-              onPressed: () => ref
-                  .read(proxiesActionProvider.notifier)
-                  .delayTest(group.all),
+              // Delay is measured through the running core, so the button stays
+              // disabled until the portal is open instead of answering -1 ms.
+              tooltip: running
+                  ? context.appLocalizations.delayTest
+                  : context.appLocalizations.openPortal,
+              onPressed: running
+                  ? () => ref
+                      .read(proxiesActionProvider.notifier)
+                      .delayTest(group.all)
+                  : null,
               icon: const GlyphIcon(AppGlyphs.bolt, size: 18),
             ),
             IconButton(
@@ -195,10 +201,8 @@ class _ServerRow extends ConsumerWidget {
       dense: true,
       selected: selected,
       // Colour, not just the marker: a tinted row is what the eye finds first.
-      tileColor: selected
-          ? theme.colorScheme.primaryContainer.withValues(alpha: 0.45)
-          : null,
-      selectedTileColor: theme.colorScheme.primaryContainer.withValues(alpha: 0.45),
+      tileColor: selected ? theme.colorScheme.primaryContainer : null,
+      selectedTileColor: theme.colorScheme.primaryContainer,
       shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(10)),
       contentPadding: const EdgeInsets.symmetric(horizontal: 8),
       leading: GlyphIcon(
-- 
